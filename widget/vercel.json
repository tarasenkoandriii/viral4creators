{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash ../scripts/vercel-ignore-build.sh .",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/widget/v1/:path*",
      "destination": "https://assist-api.viral4creators.app/widget/v1/:path*",
      "missing": [
        {
          "type": "host",
          "value": "assist-wa.viral4creators.app"
        },
        {
          "type": "host",
          "value": "assist-we.viral4creators.app"
        }
      ]
    },
    {
      "source": "/w/v1/:path*",
      "destination": "https://assist-api.viral4creators.app/w/v1/:path*",
      "missing": [
        {
          "type": "host",
          "value": "assist-wa.viral4creators.app"
        },
        {
          "type": "host",
          "value": "assist-we.viral4creators.app"
        }
      ]
    },
    {
      "source": "/wa/v1/:path*",
      "has": [
        {
          "type": "host",
          "value": "assist-wa.viral4creators.app"
        }
      ],
      "destination": "https://assist-api.viral4creators.app/wa/v1/:path*"
    },
    {
      "source": "/assist-admin/v1/:path*",
      "has": [
        {
          "type": "host",
          "value": "assist-wa.viral4creators.app"
        }
      ],
      "destination": "https://assist-api.viral4creators.app/assist-admin/v1/:path*"
    },
    {
      "source": "/we/v1/:path*",
      "has": [
        {
          "type": "host",
          "value": "assist-we.viral4creators.app"
        }
      ],
      "destination": "https://assist-api.viral4creators.app/we/v1/:path*"
    },
    {
      "source": "/editor/v1/:path*",
      "has": [
        {
          "type": "host",
          "value": "assist-we.viral4creators.app"
        }
      ],
      "destination": "https://assist-api.viral4creators.app/editor/v1/:path*"
    }
  ],
  "headers": [
    {
      "source": "/v1/loader.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=600"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/v1/(chat.js|chat.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=600"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/v1/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/v1/fonts/(.*)",
