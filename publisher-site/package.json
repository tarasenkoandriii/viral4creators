{
  "name": "@v4c/publisher-site",
  "version": "0.1.0",
  "private": true,
  "description": "Публичный сайт AI Publisher (ai-publisher.org): посадочная, материалы, форма обращения. Next.js 15 App Router, uk. Проект: doc/ai-publisher/IMPLEMENTATION-DESIGN.md §13",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3020",
    "build": "next build",
    "start": "next start -p 3020",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/sync-shared.mjs --check && for f in scripts/*.test.ts; do echo \"── $f\"; npx tsx \"$f\" || exit 1; done",
    "sync:shared": "node scripts/sync-shared.mjs",
    "check:built": "npx tsx scripts/built/check-built.ts",
    "budget:js": "node scripts/built/first-load-js.mjs",
    "stand": "tsx scripts/built/stand.ts",
    "axe": "node scripts/built/axe-check.mjs",
    "e2e": "node scripts/built/e2e.mjs",
    "lhci": "lhci autorun --config=lighthouserc.cjs"
  },
  "dependencies": {
    "next": "^15.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@lhci/cli": "^0.15.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "playwright-core": "1.56.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@^0.2.15"
    }
  }
}
