{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true
  },
  // `test/types` — объявление `@prisma/client` как `any` ТОЛЬКО для
  // `tsconfig.typecheck.json` (песочница без `prisma generate`). Без
  // этого исключения его подхватывал любой конфиг, собирающий файлы
  // маской, — и настоящий клиент становился `any` везде: и в шаге
  // `типы` в CI, и в компиляторе Vercel для serverless-точки входа,
  // который собирал по этому конфигу и падал на 11 ошибках. Конфиг
  // проверки подключает файл явным `files`, а `exclude` на `files` не
  // распространяется.
  "exclude": ["node_modules", "dist", "test/types"]
}
