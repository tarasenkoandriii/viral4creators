    {
      "subjectKey": "site-tutorial-demo-2",
      "scenario": "C2-order",
      "locale": "en",
      "title": "How to place an order in a shop",
      "steps": [
        {
          "kind": "goto",
          "route": "qa-demo-shop",
          "narration": "A test shop. Let’s place an order."
