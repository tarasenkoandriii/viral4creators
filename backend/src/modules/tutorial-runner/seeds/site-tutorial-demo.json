    {
      "subjectKey": "site-tutorial-demo-2",
      "scenario": "C2-order",
      "locale": "uk",
      "title": "Як оформити замовлення в магазині",
      "steps": [
        {
          "kind": "goto",
          "route": "qa-demo-shop",
          "narration": "Тестовий магазин. Покажемо, як оформити замовлення."
        },
        {
          "kind": "click",
          "selector": "[data-qa=\"demo-shop-product-mug-add\"]",
          "narration": "Обираємо товар і додаємо його в кошик."
        },
        {
          "kind": "click",
          "selector": "[data-qa=\"demo-shop-nav-cart\"]",
          "narration": "Відкриваємо кошик."
        },
        {
          "kind": "fill",
          "selector": "[data-qa=\"demo-shop-checkout-name\"]",
          "value": "Олена Тестова",
          "narration": "Заповнюємо контактні дані."
        },
        {
          "kind": "fill",
          "selector": "[data-qa=\"demo-shop-checkout-phone\"]",
          "value": "+380 00 000 00 00"
        },
        {
          "kind": "click",
          "selector": "[data-qa=\"demo-shop-checkout-pickup\"]",
          "narration": "Обираємо спосіб отримання."
        },
        {
          "kind": "click",
          "selector": "[data-qa=\"demo-shop-checkout-submit\"]",
          "narration": "Підтверджуємо замовлення."
        },
        {
          "kind": "assertVisible",
          "selector": "[data-qa=\"demo-shop-order-confirmed\"]",
          "narration": "Готово: замовлення прийнято. Це тестовий магазин — справжніх покупок немає."
        }
      ]
    },
