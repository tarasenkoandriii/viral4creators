          "narration": "Choose how to receive the order."
        },
        {
          "kind": "click",
          "selector": "[data-qa=\"demo-shop-checkout-submit\"]",
          "narration": "Confirm the order."
        },
        {
          "kind": "assertVisible",
          "selector": "[data-qa=\"demo-shop-order-confirmed\"]",
          "narration": "Done — the order is placed. It’s a test shop, nothing is really bought."
        }
      ]
