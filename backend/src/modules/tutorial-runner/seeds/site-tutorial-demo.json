    {
      "subjectKey": "site-tutorial-demo-1",
      "scenario": "C3-delivery",
      "locale": "uk",
      "title": "Як знайти умови доставки",
      "steps": [
        {
          "kind": "goto",
          "route": "qa-demo-shop",
          "narration": "Де на сайті умови доставки? Покажемо за три кроки."
        },
        {
          "kind": "click",
          "selector": "[data-qa=\"demo-shop-nav-delivery\"]",
          "narration": "Відкриваємо розділ «Доставка й оплата»."
        },
        {
          "kind": "click",
          "selector": "[data-qa=\"demo-shop-delivery-courier\"]",
          "narration": "Обираємо доставку кур’єром."
        },
        {
          "kind": "assertVisible",
          "selector": "[data-qa=\"demo-shop-delivery-terms\"]",
          "narration": "Тут терміни й вартість. Це все."
        }
      ]
    },
