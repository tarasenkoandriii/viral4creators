{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "src",
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "isolatedModules": true
      }
    ]
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@prisma/client$": "<rootDir>/../test/prisma-client-shim.ts"
  }
}
