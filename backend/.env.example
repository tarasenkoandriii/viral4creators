# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Postgres (session persistence via Prisma — see PRISMA-SUPABASE.md)
# DATABASE_URL: the POOLED connection string (PgBouncer, port 6543) from
# Supabase dashboard -> Project Settings -> Database -> Connection string
# -> "Transaction" mode. Required in this form (not the direct one) so
# concurrent Vercel Function invocations don't each open their own direct
# Postgres connection and exhaust Supabase's connection limit.
# DIRECT_URL: the DIRECT connection string (port 5432, same page). Used
# only by `prisma migrate` — migrations don't work reliably through a
# transaction-mode pooler.
# Local docker-compose overrides both to point at the local `db` service
# instead (see docker-compose.yml) — you only need real Supabase values
# here for running the backend natively (outside Docker) or deploying.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Vercel Blob Configuration — the only object storage in the app now.
# Used for the reference-video transit copy, the durable product image,
# and the durable generated video (see BlobService's doc comment for why
# one Blob store covers all three; AWS S3 used to hold the latter two,
# removed entirely).
# Locally: create a Blob store in the Vercel dashboard, then run
# `vercel env pull` to fetch BLOB_READ_WRITE_TOKEN into this file.
# On Vercel itself, with a connected store, OIDC covers this automatically
# and you don't need to set these two by hand.
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token
BLOB_STORE_ID=your_vercel_blob_store_id

# Google Gemini API Configuration
GEMINI_API_KEY=your_google_api_key
# Синоним GEMINI_API_KEY — код принимает любое из двух имён (см.
# configuration.ts), достаточно одного. Оставлен для совместимости с
# окружениями, где ключ уже называется по-гугловски.
# GOOGLE_GEMINI_API_KEY=your_google_api_key
# Модель для всех пяти вызовов Gemini (разбор видео, релевантность, аудит
# ролика, категория по фото, голос→текст) — влияет на стоимость каждого
# из них (common/ai-pricing.ts). Модель вне прайса пишется в расход как
# unpriced. По умолчанию gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash
# Модель генерации изображений (превью персонажа). По умолчанию
# gemini-3.1-flash-image — gemini-2.5-flash-image отключается 02.10.2026.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Квоты картинок на пользователя (сутки UTC / календарный месяц UTC),
# doc/AI-SKETCH-SPEC.md §8.2. Ноль закрывает генерацию на тарифе.
# AI_SKETCH_DAY_LITE=3
# AI_SKETCH_DAY_STANDARD=15
# AI_SKETCH_DAY_PREMIUM=50
# AI_SKETCH_MONTH_LITE=20
# AI_SKETCH_MONTH_STANDARD=150
# AI_SKETCH_MONTH_PREMIUM=600

# Laozhang.ai API Configuration (GPT-5 text-prompt generation only — video
# generation moved to Google Veo 3.1, see GenerationService.VEO_MODELS).
# MUST end in /v1 — without it PromptService hits the wrong path and gets
# a response that isn't OpenAI-shaped, which fails with a generic "Failed
# to generate prompt. Please try again." (see PromptService.generatePrompt).
LAOZHANG_API_KEY=your_laozhang_api_key
LAOZHANG_API_BASE_URL=https://api.laozhang.ai/v1
# Альтернатива паре LAOZHANG_* без прокси — код берёт первое заданное из
# двух пар (LAOZHANG_* или OPENAI_*). MUST тоже end in /v1.
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# Модель сборки промпта. По умолчанию gpt-5.
# OPENAI_GPT_MODEL=gpt-5

# ── Product/Project workflow (doc/PRODUCT-PROJECT-SPEC.md) ──
# None of these is required to START the backend — a stand without them
# boots fine and the corresponding endpoint refuses at call time.
#
# SerpApi Google Lens — "photo of the product → visually similar market
# analogs with prices/URLs" (spec §6.1; same integration SilverFinance
# already uses). Get a key at https://serpapi.com/.
SERPAPI_API_KEY=your_serpapi_api_key
# Per-user daily cap on SerpApi calls (spec §7.5) — it's billed per
# request, so this bounds the worst-case bill from one busy user. Cache
# by photo hash means the same photo is only ever paid for once anyway.
# Non-numeric / non-positive values fall back to the default (50).
SERPAPI_DAILY_LIMIT_PER_USER=50
# YouTube Data API v3 — reference-video search (spec §6.4). Quota is in
# "units": search.list costs 100/call against a 10 000/day default, so
# roughly 100 searches/day per Google Cloud project. Create the key in
# Google Cloud Console with the YouTube Data API v3 enabled.
YOUTUBE_API_KEY=your_youtube_api_key
# Per-user daily cap on YouTube searches. The 10 000-unit quota above is
# shared by every user of this deployment, so one busy user could burn it
# for all — default 20 searches/user/day. Manual link / file upload are
# never counted. Non-numeric / non-positive values fall back to 20.
YOUTUBE_SEARCH_DAILY_LIMIT_PER_USER=20
# Soft cap on automatic audit → prompt-fix → regenerate cycles per
# generated video (spec §11.1). Each cycle is a paid Veo 3.1 render; past
# the cap the UI warns before running another. Default 3.
AUDIT_AUTO_ITERATIONS_LIMIT=3
# Max products in one LINE project (spec §7.3). Bounds UI clutter and the
# worst-case SerpApi spend per project (one photo search per product).
# Default 500 (raised from 20 at stage 68/§47, product feed import — a
# seller with a real 300-SKU catalog would not fit under the old default).
PROJECT_LINE_ITEM_LIMIT=500

# xAI Grok Batch API — background translation of blog articles into the
# five interface locales (spec §35.1). Not required to start the backend:
# without a key, GrokBatchService (and therefore BlogTranslationService,
# stage 57) skips the translation queue and logs it instead of failing.
# Get a key at https://console.x.ai/.
GROK_API_KEY=your_xai_grok_api_key
# Model used to translate blog articles (spec §35.1, stage 57). Not
# verified against console.x.ai — check before relying on it in prod.
GROK_MODEL=grok-4-fast

# Blog (doc/TODO.md §II.3, spec §36, stage 57) — a daily cron finds
# trending YouTube videos in these categories and drafts blog posts from
# them via Gemini analysis; nothing here auto-publishes.
# Comma-separated categories to search, e.g. "фитнес,кулинария,техника".
# Empty (default) disables the generator entirely — it is opt-in.
BLOG_CATEGORIES=
# Blog's own daily YouTube Search quota, separate from the per-user one
# above (BlogYoutubeSearchUsage, its own table — see blog-youtube-budget
# service comment for why it isn't shared with YOUTUBE_SEARCH_DAILY_LIMIT_PER_USER).
BLOG_YOUTUBE_SEARCH_DAILY_LIMIT=10
# Max drafts created per cron run.
BLOG_DRAFTS_PER_RUN_LIMIT=5
# Minimum Gemini relevance score (0-100) for a candidate to become a draft.
BLOG_MIN_SCORE_TO_DRAFT=60
# Max pending translations submitted as one xAI batch per cron run.
BLOG_TRANSLATE_BATCH_LIMIT=50

# CORS Configuration
# Comma-separated list of allowed frontend origins. An entry starting with
# "*." matches any subdomain (e.g. "*.vercel.app" allows every Vercel
# preview URL without listing each one). In the two-Vercel-projects setup
# (see DEPLOYMENT.md), set this in the BACKEND project's env vars:
#   Production:  the frontend's production domain, e.g.
#                https://viral4creators.vercel.app
#   Preview:     the same production domain PLUS "*.vercel.app", so
#                preview frontend deployments (which get a random
#                *.vercel.app URL per branch/PR) can still call the API:
#                https://viral4creators.vercel.app,*.vercel.app
# Locally this stays just the Vite dev server origin.
CORS_ORIGIN=http://localhost:5173

# Session Configuration
SESSION_TTL_HOURS=24
# Невостребованные разборы библиотеки (usageCount = 0) старше этого срока
# удаляются суточной уборкой; 0 — не удалять (этап 51).
LIBRARY_UNUSED_TTL_DAYS=180

# Режимы сервиса (ТЗ §23). Пока пусто/false: Lite, Standard и Premium
# бесплатны, и пользователь переключает их сам через PATCH /api/me/plan.
# Поставить `true`, когда появится оплата: самостоятельное переключение
# начнёт отвечать 403, а режим будет ставить биллинг. Правил доступа это
# не меняет — они читаются из backend/src/common/plans.ts в обоих случаях.
PLANS_BILLING_ENABLED=false

# Прайс на платные вызовы (ТЗ §26). Ставки по умолчанию лежат в
# backend/src/common/ai-pricing.ts вместе с датой и пояснением, откуда
# каждая взята. Любую можно переопределить здесь, БЕЗ деплоя; значение —
# в ДОЛЛАРАХ, ровно как на странице прайса провайдера.
#
# Ставки Gemini сверены с ai.google.dev 2026-09-06. Ставки Veo и GPT-5 на
# официальных страницах на эту дату не нашлись — взяты опубликованные при
# запуске; ПРОВЕРЬТЕ их перед тем, как верить колонке с деньгами.
#
# Имя переменной: AI_PRICE_<МОДЕЛЬ>_<INPUT|OUTPUT|SECOND|CALL>, где в
# модели всё, кроме букв и цифр, заменено подчёркиванием.
# AI_PRICE_GEMINI_2_5_FLASH_INPUT=0.30
# AI_PRICE_GEMINI_2_5_FLASH_OUTPUT=2.50
# AI_PRICE_VEO_3_1_GENERATE_PREVIEW_SECOND=0.40
# AI_PRICE_VEO_3_1_LITE_GENERATE_PREVIEW_SECOND=0.15
# AI_PRICE_GPT_5_INPUT=1.25
# AI_PRICE_GPT_5_OUTPUT=10.00
# AI_PRICE_SERPAPI_CALL=0.03
# AI_PRICE_GEMINI_2_5_FLASH_CACHED=0.075   # ставка для входа из кеша (§26.1)

# Суточные потолки расхода (ТЗ §26.4). В ДОЛЛАРАХ на сутки, окно — от
# полуночи UTC. Ограничивают самое дорогое: генерацию Veo и разбор.
# Значения ниже — умолчания из кода, задавать необязательно.
#
# `0` — законное значение и означает «платные вызовы запрещены»
# (например, на время разбирательства). Мусор в переменной потолок НЕ
# обнуляет: остаётся умолчание, потому что молча остановить сервис из-за
# опечатки хуже, чем работать по коду.
# DAILY_SPEND_LIMIT_USD_LITE=2
# DAILY_SPEND_LIMIT_USD_STANDARD=10
# DAILY_SPEND_LIMIT_USD_PREMIUM=30
# Общий потолок на ВСЕХ анонимных вместе: персонального у них быть не
# может (UUID сессии минтится бесплатно), а без общего достаточно выйти
# из аккаунта, чтобы обойти персональный.
# DAILY_SPEND_LIMIT_USD_ANONYMOUS=5

# Хосты, с которых сервер соглашается скачивать наши же картинки
# (ТЗ §12, этап 38). Пусто — только стандартный домен Vercel Blob
# (*.public.blob.vercel-storage.com). Задавать нужно ТОЛЬКО если у
# хранилища свой домен: сервер скачивает референс-изображения строго со
# своих адресов, иначе клиент мог бы заставить его сходить куда угодно.
# Пустое значение проверку НЕ отключает.
# BLOB_PUBLIC_HOSTS=blob.example.com

# Синтез речи — настоящая озвучка ролика (ТЗ §15, ElevenLabs).
#
# До этапа 35 реплики произносил сам Veo: работает и стоит ноль сверху,
# но голос каждый раз новый, и своего у бренда быть не может. С этими
# переменными реплики читает выбранный голос, а звук Veo уходит в фон
# (режим выбирается в манифесте бренда: голос Veo / свой поверх / свой
# вместо).
#
# Ключ НЕ обязателен: без него продукт работает как раньше — озвучивает
# модель, а интерфейс честно пишет, что синтез на этом стенде не
# подключён. Это мягкий фоллбек, а не деградация с ошибкой.
VOICE_API_KEY=
# Голос по умолчанию (идентификатор ElevenLabs). Бренд задаёт свой в
# манифесте; это значение — на случай, когда он не задан.
# VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Модель синтеза. По умолчанию eleven_multilingual_v2 — она умеет
# украинский и русский, а это рынки продукта.
# VOICE_MODEL=eleven_multilingual_v2
# Ставка за миллион символов для журнала расходов (§26), в долларах.
# У TTS счёт идёт за символы, а не за токены.
# AI_PRICE_ELEVENLABS_TTS_CHARS=220

# Хостед-ffmpeg — обрезка кадра и наложение озвучки (ТЗ §15.4/§16.1).
# Veo рендерит нативно только 16:9 и 9:16; всё остальное снимается в
# ближайшем родном и обрезается по центру уже после. У Vercel Functions
# ffmpeg нет, поэтому обрезку делает внешний сервис.
#
# Ключ НЕ обязателен: без него продукт работает как раньше — ролик
# остаётся в родном формате и со звуком Veo, а интерфейс честно пишет,
# что обработка на этом стенде не подключена.
FFMPEG_API_KEY=
# База API; по умолчанию https://verygoodffmpeg.com/api. Меняется, если
# поднимете свой совместимый сервис.
# FFMPEG_API_BASE_URL=https://verygoodffmpeg.com/api
# Ставка за одну задачу для журнала расходов (§26), в долларах.
# AI_PRICE_FFMPEG_API_CALL=0.01

# Второй провайдер синтеза речи — Resemble AI, рядом с ElevenLabs выше, не
# вместо него (doc/TTS-PROVIDER-ALTERNATIVES-SPEC.md, этап 70).
#
# Значение elevenlabs (умолчание, если переменная не задана или задана
# неизвестным значением) или resemble.
# TTS_PROVIDER=elevenlabs
# Ключ Resemble; нужен и когда TTS_PROVIDER=resemble, и всегда — для
# клонирования голоса пользователями (PlanFeature.voiceCloning, этап 73),
# которое идёт через Resemble явно, независимо от TTS_PROVIDER. Не
# задан — синтез/клонирование через Resemble мягко пропускается, ролик
# всё равно получится (тот же фоллбек, что у VOICE_API_KEY выше).
# RESEMBLE_API_KEY=
# У Resemble нет универсального голоса каталога — без этого голоса ИЛИ
# выбора голоса в манифесте бренда синтез Resemble тоже пропускается.
# RESEMBLE_VOICE_ID=
# Секрет вебхука POST /api/voices/webhook/resemble?secret=..., которым
# Resemble сообщает о готовности клонирования — сверяется constant-time,
# как CRON_SECRET, но в query-параметре, не в заголовке. Не задан —
# вебхук отвечает 503, но клонирование всё равно работает через
# poll-фоллбек (медленнее). Сгенерировать: `openssl rand -hex 16`.
# RESEMBLE_WEBHOOK_SECRET=

# Пилот говорящего AI-аватара — Hedra Character-3
# (doc/AVATAR-LIPSYNC-PIPELINE-SPEC.md, этап 72). Голос берётся из
# RESEMBLE_API_KEY выше (пилот использует Resemble явно, не через
# TTS_PROVIDER). Доступ — только оператору из админки
# (POST/GET /admin/actors/:sessionId/...), обычным пользователям
# продукта не показывается (avatarLipsync выключен на всех тарифах).
#
# Ключ НЕ обязателен: без него пилот отвечает понятной ошибкой, весь
# остальной продукт работает как раньше.
HEDRA_API_KEY=
# Ставка за секунду видео для журнала расходов (§26), в долларах —
# оценка по тарифным планам, не официальный прайс за API-вызов.
# ПРОВЕРИТЬ из личного кабинета Hedra перед реальным использованием.
# AI_PRICE_HEDRA_CHARACTER_3_SECOND=0.033

# Секрет крона (GET /api/cron/{report,cleanup-sessions,sweep-orphans} —
# backend/vercel.json и CronController). Одно и то же значение здесь и в
# переменной CRON_SECRET Vercel-проекта бэкенда: Vercel сам шлёт его
# заголовком `Authorization: Bearer <value>`, контроллер сверяет.
# Сгенерировать: `openssl rand -hex 16`. С этапа 54 БЕЗ секрета крон
# закрыт (503), а не открыт; локально его открывает ALLOW_DEV_AUTH=true
# (вне production) — тогда можно оставить пустым и дёргать curl-ом.
CRON_SECRET=

# Fixture-вход исполнителя сценариев обучающих видео (§3.3 ТЗ
# doc/TMA-UI-SNAPSHOT-AND-TUTORIAL-VIDEO-SPEC.md, этап 97,
# backend/src/common/fixture-token.ts) — headless-браузер, проигрывающий
# сгенерированные сценарии (backend/src/modules/tutorial-scenario/),
# аутентифицируется заголовком `X-Fixture-Token: <FIXTURE_USER_TOKEN>` и
# получает identity фикстурного пользователя с telegramId=
# FIXTURE_TELEGRAM_ID. НЕ ALLOW_DEV_AUTH: та переменная документирована
# как непригодная для прода, а этот исполнитель обязан работать именно
# на проде — иначе регрессия, поймаемая только там, никогда не
# ловится. Fail-closed без dev-исключения (в отличие от CRON_SECRET):
# без обеих переменных исполнитель просто не может аутентифицироваться,
# крон-джоб `tutorial-scenario-run` пропускает прогон с понятной
# ошибкой в логе, а не падает и не открывается сам. Сгенерировать
# FIXTURE_USER_TOKEN: `openssl rand -hex 16`. Фикстурного пользователя
# (Project/ProductItem/BrandManifest/Session) заводит отдельный
# ops-скрипт `backend/scripts/seed-fixture-user.ts` — см. его
# доккомментарий, запускается вручную, не частью деплоя/миграций.
FIXTURE_USER_TOKEN=
FIXTURE_TELEGRAM_ID=fixture-tutorial-runner

# Telegram login (TMA identification + frontend's persistent login button +
# admin panel) — see doc/TELEGRAM-ADMIN.md. Get a bot token from @BotFather.
# This same bot also backs the frontend's "Log in with Telegram" button
# (Telegram Login Widget) — that widget's domain is bound to a bot via
# @BotFather /setdomain, so point THIS bot's /setdomain at the frontend's
# production domain (the TMA itself needs no domain binding — initData is
# validated by signature, not by domain).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Optional — only needed if you register a SEPARATE bot for the admin
# panel's Telegram Login Widget (that widget's domain is bound to a bot
# via /setdomain, one domain per bot; since TELEGRAM_BOT_TOKEN's bot is
# already /setdomain'd to the frontend's domain, the admin panel — a
# third, different domain — needs its own bot here). Falls back to
# TELEGRAM_BOT_TOKEN when unset (fine if admin and frontend somehow share
# a domain, or you don't mind the widget only working on one of them).
ADMIN_LOGIN_BOT_TOKEN=

# Dev-login (Docker local stand only — see doc/TELEGRAM-ADMIN.md).
# ALLOW_DEV_AUTH=true enables BOTH the X-Dev-User-Id header bypass for
# TMA endpoints AND POST /admin/auth/dev-login for the admin panel. A
# second safeguard (NODE_ENV !== 'production') is checked in code, so
# this alone leaking into production wouldn't be enough to open either
# bypass — but it must still never be set there.
ALLOW_DEV_AUTH=false
DEV_USER_ID=123

# Служебные каналы Telegram (ТЗ §28, этап 45) — ошибки и статистика.
# Идентификаторы ЧАТОВ, а не список операторов: добавить человека —
# значит добавить его в чат, деплой для этого не нужен. Пусто — каналы
# молчат. Узнать id: добавить бота в группу и открыть
# https://api.telegram.org/bot<TOKEN>/getUpdates (у групп id отрицательный).
TELEGRAM_ALERTS_CHAT_ID=
TELEGRAM_STATS_CHAT_ID=

# ── Выгрузка одобренных роликов в YouTube/TikTok (ТЗ §14, этап 61) ──────
# Всё необязательно: подключение канала и очередь публикации работают на
# стенде и без единого ключа отсюда, просто обмен кода на токен честно
# откажет понятной ошибкой, а крон-воркер ничего не выгрузит.

# OAuth-клиент Google (Cloud Console → APIs & Services → Credentials,
# тип Web application) с включённым YouTube Data API v3. В Authorized
# redirect URIs добавить <API_PUBLIC_URL>/channels/oauth/YOUTUBE/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Приложение TikTok for Developers (Login Kit + Content Posting API),
# redirect URI — <API_PUBLIC_URL>/channels/oauth/TIKTOK/callback. Пока
# приложение не прошло аудит TikTok, выгрузка принудительно приватная
# (SELF_ONLY) — платформенное ограничение, не наше (tiktok-upload.service.ts).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Ключ шифрования OAuth-токенов каналов в БД (AES-256-GCM, см.
# common/token-crypto.ts) — 32 байта в base64. Сгенерировать:
# `openssl rand -base64 32`. Без него подключение канала не сохранится
# (ошибка при шифровании токена перед записью в БД).
CHANNEL_TOKEN_KEY=

# Публичный адрес backend, СО СВОИМ ГЛОБАЛЬНЫМ ПРЕФИКСОМ /api — на него
# заводится redirect_uri OAuth-колбэков (<API_PUBLIC_URL>/channels/oauth/
# :platform/callback). Локально — http://localhost:3000/api.
API_PUBLIC_URL=

# Публичный адрес TMA (frontend) — сюда backend отправляет браузер после
# OAuth-колбэка (см. resultPage() в publishing-channel.controller.ts).
# Тот же URL, что NEXT_PUBLIC_TMA_URL у landing/. Пусто — страница
# результата даёт только ссылку на «/».
TMA_PUBLIC_URL=

# Сколько заявок берёт один тик крона GET /api/cron/publish (§14.5).
# PUBLISH_CRON_BATCH=3
# Потолок попыток выгрузки одной заявки до FAILED (§14.5).
# PUBLISH_MAX_ATTEMPTS=5

# ── Оплата: Telegram Stars и WayForPay (ТЗ §41, этап 62) ────────────────
# Тоже необязательно: PLANS_BILLING_ENABLED=false (по умолчанию, см. выше)
# держит все режимы бесплатными и без единого маршрута оплаты — эти
# переменные нужны, только когда её включают.

# Секрет, который Telegram эхом шлёт в заголовке
# X-Telegram-Bot-Api-Secret-Token на каждый вызов POST /api/billing/webhook/
# telegram — регистрируется ОДИН РАЗ вручную при деплое (см. DEPLOYMENT.md):
# curl "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook" \
#   -d "url=<API_PUBLIC_URL>/billing/webhook/telegram" \
#   -d "secret_token=<это_значение>"
# Без него вебхук вернёт 503 (тот же fail-closed приём, что CRON_SECRET).
TELEGRAM_WEBHOOK_SECRET=

# Мерчант-аккаунт WayForPay (личный кабинет → Настройки магазина). Не
# секрет — то же значение видит плательщик на форме оплаты.
WAYFORPAY_MERCHANT_ACCOUNT=
# Секретный ключ мерчанта — подписывает форму покупки и сверяет вебхук
# (merchantSignature, HMAC-MD5). Личный кабинет → Настройки → API.
WAYFORPAY_MERCHANT_SECRET=
# Домен, под которым мерчант зарегистрирован у WayForPay — участвует в
# подписи формы покупки. Обычно домен лендинга/TMA.
WAYFORPAY_DOMAIN=
# Валюта WayForPay — по умолчанию UAH (гривна), только её принимают
# украинские мерчант-аккаунты без отдельного согласования мультивалютности.
# WAYFORPAY_CURRENCY=UAH

# Ключ шифрования recToken (регулярный платёж WayForPay) в
# Subscription.recTokenEnc — 32 байта в base64, отдельный от
# CHANNEL_TOKEN_KEY (см. common/token-crypto.ts). Сгенерировать:
# `openssl rand -base64 32`. Без него подписка на WayForPay не продлится
# автоматически (крон продления не расшифрует сохранённый токен).
PAYMENT_TOKEN_KEY=

# Сколько просроченных подписок берёт один тик крона
# GET /api/cron/billing-renew (раз в сутки, см. vercel.json).
# BILLING_CRON_BATCH=20

# Цены — ПЛЕЙСХОЛДЕРЫ в коде (common/billing-pricing.ts), реальные суммы
# ещё не решены владельцем продукта (открытый вопрос §41.1). Переопределить
# без деплоя — этими переменными; не заданы — код использует плейсхолдеры.
# Подписки (XTR — целые звёзды; *_UAH_KOPECKS — копейки гривны):
# SUBSCRIPTION_PRICE_STANDARD_STARS=1000
# SUBSCRIPTION_PRICE_STANDARD_UAH_KOPECKS=79900
# SUBSCRIPTION_PRICE_PREMIUM_STARS=2500
# SUBSCRIPTION_PRICE_PREMIUM_UAH_KOPECKS=199900
# Пакеты кредитов (id пакета — 'small'/'large', см. billing-pricing.ts):
# CREDIT_PACK_SMALL_CREDITS=5
# CREDIT_PACK_SMALL_STARS=250
# CREDIT_PACK_SMALL_UAH_KOPECKS=19900
# CREDIT_PACK_LARGE_CREDITS=20
# CREDIT_PACK_LARGE_STARS=900
# CREDIT_PACK_LARGE_UAH_KOPECKS=69900

# Фиксированный курс для Payment.amountMicroUsd — оценка для сведения с
# отчётами AiUsage, НЕ бухгалтерская точность и не живая биржа (§41,
# открытый вопрос 4). Микродоллары на единицу.
# FX_MICRO_USD_PER_STAR=15000
# FX_MICRO_USD_PER_UAH_KOPECK=240

# ── Рассылка: рекламный канал (ТЗ §42, этап 63) ────────────────────────
# GET /api/cron/marketing-broadcast (раз в сутки, см. vercel.json) шлёт
# подборку удачных роликов подписчикам через уже настроенный
# TELEGRAM_BOT_TOKEN — своего ключа не требует. Все переменные ниже —
# тонкая настройка с безопасными значениями по умолчанию, рассылка
# работает и без них.

# Публичный адрес landing-проекта — для ссылок ${LANDING_PUBLIC_URL}/video/
# :id в сообщении рассылки (тот же принцип, что API_PUBLIC_URL/
# TMA_PUBLIC_URL выше). Не задана — сообщение уходит без ссылок, а не
# падает.
# LANDING_PUBLIC_URL=

# Не чаще раза в сколько дней собирается новый выпуск.
# MARKETING_BROADCAST_FREQUENCY_DAYS=7
# Сколько ещё не показанных PUBLISHED-страниц (SharedVideoPage) берёт
# один выпуск.
# MARKETING_BROADCAST_PAGE_COUNT=5
# Сколько доставок обрабатывает один тик крона.
# MARKETING_CRON_BATCH=200
# После скольких неудачных попыток отправки доставка помечается FAILED
# терминально (бэкофф 2^attempts минут между попытками).
# MARKETING_MAX_ATTEMPTS=5

# ── Пакетная генерация по каталогу (ТЗ §44, этап 65) ────────────────────
# Один уже одобренный ролик (разбор + промпт) переносится на остальные
# товары линейки одним заходом — кроном, см. GET /api/cron/catalog-batch-
# run и backend/vercel.json. Своего ключа не требует — переиспользует
# GPT-5/Veo/Gemini, уже настроенные выше. Обе переменные ниже — тонкая
# настройка с безопасными значениями по умолчанию.

# Сколько строк партии (по одной на товар) обрабатывает один тик крона.
# CATALOG_BATCH_CRON_BATCH=10
# После скольких неудачных попыток строка партии помечается FAILED
# терминально (бэкофф 2^attempts минут между попытками).
# CATALOG_BATCH_MAX_ATTEMPTS=5

# ── A/B-варианты одного ролика (TODO §III.6, этап 66) ───────────────────
# Из одного уже одобренного ролика собираются 3 дубля, отличающихся
# только хуком и CTA — кроном, см. GET /api/cron/ab-test-run и
# backend/vercel.json. Своего ключа не требует — переиспользует GPT-5/
# Veo, уже настроенные выше. Обе переменные ниже — тонкая настройка с
# безопасными значениями по умолчанию.

# Сколько строк вариантов обрабатывает один тик крона.
# AB_TEST_CRON_BATCH=10
# После скольких неудачных попыток строка варианта помечается FAILED
# терминально (бэкофф 2^attempts минут между попытками).
# AB_TEST_MAX_ATTEMPTS=5

# ── Товарный фид — импорт каталога по ссылке (TODO §Уровень 2 п.8, этап 68) ──
# Продавец вставляет ссылку на свой YML- или CSV-фид — кроном, см.
# GET /api/cron/feed-import-run и backend/vercel.json. Своего ключа не
# требует — только сеть до ссылки продавца и уже настроенный
# BLOB_READ_WRITE_TOKEN для фото из фида. Все три переменные ниже —
# тонкая настройка с безопасными значениями по умолчанию.

# Сколько строк фида обрабатывает один тик крона (фаза заведения позиций).
# PRODUCT_FEED_IMPORT_CRON_BATCH=50
# После скольких неудачных попыток запуск или строка фида помечается
# FAILED терминально (бэкофф 2^attempts минут между попытками).
# PRODUCT_FEED_IMPORT_MAX_ATTEMPTS=5
# Предел размера тела фида в байтах (защита от гигантского файла на
# serverless-функции). 8388608 = 8 МБ.
# PRODUCT_FEED_IMPORT_MAX_BYTES=8388608

# ── ИИ-консультант на лендинге (doc/LANDING-TUTORIAL-AI-CONSULTANT-SPEC.md, этап 82) ──
# Выключен по умолчанию (assistant_enabled в PlatformSetting, включается
# в админке на /settings без деплоя) — переменная ниже нужна только для
# качества хеширования IP в аналитике, сам консультант при её отсутствии
# работает (падает на CRON_SECRET, затем на встроенное dev-значение).

# Соль для sha256(ip:суточная соль:секрет) в AssistantExchange.ipHash
# (§8 ТЗ — сам IP-адрес не хранится, только хеш). Сгенерировать:
# `openssl rand -hex 16`. Не задана — используется CRON_SECRET, если и
# его нет — 'dev-only-assistant-ip-salt' (годится только для dev-стенда).
# ASSISTANT_IP_HASH_SECRET=
