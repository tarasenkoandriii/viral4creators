# viral4creators admin panel — see doc/TELEGRAM-ADMIN.md and DEPLOYMENT.md.

# Backend API base URL — MUST include /api (backend has a global route
# prefix, see backend/src/main.ts's setGlobalPrefix('api'); this app's
# own paths are /admin/... on top of that, e.g. /api/admin/auth/dev-login).
# Same requirement as frontend/.env.example's VITE_API_BASE_URL, just a
# different env var name (Next.js convention).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Telegram Login Widget — bot username WITHOUT the leading @. Falls back
# to TELEGRAM_BOT_TOKEN's bot on the backend unless ADMIN_LOGIN_BOT_TOKEN
# is set there for a dedicated admin-login bot (see backend/.env.example).
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Docker dev-запуск (см. DOCKER.md) — показывать ли кнопку "Войти как
# dev-123" на /login. ТОЛЬКО про видимость кнопки: реальный запрет живёт
# на бэкенде (404 при ALLOW_DEV_AUTH!=true / NODE_ENV=production). Не
# задавать в проде.
NEXT_PUBLIC_ALLOW_DEV_AUTH=false
NEXT_PUBLIC_DEV_USER_ID=123

# Публичный сайт (landing/) — используется только для ссылки «Открыть
# страницу» у одобренных публичных страниц ролика (этап 60, ТЗ §40):
# /shared-videos/<id> на бэкенде не даёт HTML-страницы сам по себе, её
# рендерит landing на своём домене (landing/src/app/video/[id]/page.tsx).
NEXT_PUBLIC_LANDING_URL=http://localhost:3003
