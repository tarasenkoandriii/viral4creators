# sites-landing — переменные окружения (только имена, без значений-секретов).
# Прод: Vercel → проект sites-landing → Settings → Environment Variables.
# Подробно: doc/DEPLOYMENT.md, раздел «Лендинг клиентских сайтов (sites-landing)».

# Абсолютный адрес сайта, только origin: https://<домен> (без пути и слэша).
# Обязателен для `next build`: без него (или с http://, localhost, путём)
# сборка падает. В продакшен-деплое Vercel домен-заглушка *.invalid тоже
# запрещён. До решения В-1 (домен) для локальной сборки и CI:
SITE_URL=https://example.invalid

# Форма пилота → служебный Telegram-канал (только сервер, без NEXT_PUBLIC_).
# Не заданы — форма честно отвечает «временно недоступно, заявка не
# отправлена», ничего не теряя молча.
# Токен бота (@BotFather), бот — администратор канала с правом публикации:
PILOT_TELEGRAM_BOT_TOKEN=
# id канала (-100…) или @username публичного канала:
PILOT_TELEGRAM_CHAT_ID=

# Связь с продуктом (Л2–Л3). Адреса по умолчанию — временные домены из
# src/brand.ts (doc/DEPLOYMENT.md §6.0); http://localhost — только стенд вне Vercel.
ASSIST_WIDGET_ORIGIN=
ASSIST_API_ORIGIN=
# Публичный ключ НАШЕГО виджета (pk_live_…). Пусто — живого виджета на лендинге нет.
ASSIST_WIDGET_PK=
# @username бота помощника. Пусто — нет «Сохранить и подключить» в конфигураторе.
ASSIST_BOT_USERNAME=
# off — выключить события §10 (по умолчанию включены).
ASSIST_LANDING_EVENTS=
