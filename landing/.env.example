# viral4creators landing — see doc/DEPLOYMENT.md.

# URL of the TMA/product itself (the frontend/ Vercel project) — it works
# as an ordinary website outside Telegram too (see doc/TELEGRAM-ADMIN.md),
# so the landing's CTA can link straight to it.
NEXT_PUBLIC_TMA_URL=http://localhost:5173

# Stage 58 (blog/news, TODO §II.3-II.5).

# Backend API base URL, MUST include /api. Server-side ONLY (no
# NEXT_PUBLIC_ prefix on purpose) — the blog pages/sitemap/RSS fetch it
# during build and ISR revalidation on Vercel's server, never from the
# visitor's browser, so CORS_ORIGIN on the backend does NOT need this
# domain (unlike admin/frontend, which fetch from the browser).
API_BASE_URL=http://localhost:3000/api

# Absolute URL of this landing site itself. Required for sitemap.xml,
# sitemap-news.xml and RSS feeds (their <loc>/<link> must be absolute per
# spec) and for JSON-LD (NewsArticle/BreadcrumbList). MUST be set to the
# real production domain in prod — the localhost default would make the
# sitemap point at itself.
SITE_URL=http://localhost:3003
