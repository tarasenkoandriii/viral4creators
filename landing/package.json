{
  "name": "@viral4creators/landing",
  "version": "0.1.0",
  "private": true,
  "description": "viral4creators — marketing landing. Next.js 15 App Router, static content, single locale (no i18n — see doc/TELEGRAM-ADMIN.md for how to add it later, following the same pattern as admin/).",
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "next lint --max-warnings 0",
    "test": "for f in scripts/*.test.ts; do echo \"── $f\"; npx tsx \"$f\" || exit 1; done",
    "budget:js": "node scripts/first-load-js.mjs"
  },
  "dependencies": {
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "2.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "postcss": "^8.5.29"
  }
}
