# Ключи внешних API для полного докер-стенда (docker-compose.dev.yml,
# `make up`) — см. doc/TELEGRAM-ADMIN.md. Скопируйте в `.env.docker`
# (это делает `make up` сам при первом запуске, если файла ещё нет) и
# заполните тем, что реально нужно проверить — стенд поднимается и без
# единого ключа, просто соответствующий сервис честно откажет на своём
# эндпоинте, а не уронит запуск всего остального.

# Telegram (Telegram-логин для TMA + постоянной кнопки логина на frontend +
# админки) — см. backend/.env.example. TELEGRAM_BOT_USERNAME подставляется
# и в admin/, и в frontend/ (кнопка «Войти через Telegram», см.
# doc/TELEGRAM-ADMIN.md) — Login Widget всё равно не откроется на
# localhost, но переменная хотя бы доходит до обоих UI.
TELEGRAM_BOT_TOKEN=
ADMIN_LOGIN_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Dev-вход — тот же ID открывает и TMA (X-Dev-User-Id), и админку
# (POST /admin/auth/dev-login), см. doc/TELEGRAM-ADMIN.md.
DEV_USER_ID=123

# Google Gemini (анализ видео + Veo 3.1)
GEMINI_API_KEY=
# Модель для всех пяти вызовов Gemini — влияет на стоимость каждого
# (doc/LOCAL-DEVELOPMENT.md). Пусто = gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# Laozhang.ai (GPT-5 текстовые промпты). ОБЯЗАТЕЛЬНО с /v1 в конце —
# без него PromptService бьёт не в тот путь (.../chat/completions вместо
# .../v1/chat/completions), получает ответ не в OpenAI-формате и падает с
# максимально общим "Failed to generate prompt. Please try again."
# (см. PromptService.generatePrompt — деталь теряется, потому что это не
# AxiosError, а TypeError на response.data.choices[0]).
LAOZHANG_API_KEY=
LAOZHANG_API_BASE_URL=https://api.laozhang.ai/v1
# Модель сборки промпта. Пусто = gpt-5.
# OPENAI_GPT_MODEL=gpt-5

# Хостед-ffmpeg (обрезка кадра и звук, ТЗ §15.4). Адрес менять только при
# своём инстансе; пусто = умолчание из backend/src/config/configuration.ts.
# FFMPEG_API_BASE_URL=

# Режимы и деньги (ТЗ §23, §26). Стенд без этих строк работает с
# умолчаниями из кода; описаны здесь, чтобы настраивать по документу можно
# было, не зная, что строку надо дописать руками (этап 53, В-6.14).
# PLANS_BILLING_ENABLED=false
# DAILY_SPEND_LIMIT_USD_LITE=2
# DAILY_SPEND_LIMIT_USD_STANDARD=10
# DAILY_SPEND_LIMIT_USD_PREMIUM=30
# DAILY_SPEND_LIMIT_USD_ANONYMOUS=5
# Потолок тестового аккаунта на отмеченных ему сценариях
# (TODO §III п.37). Бесплатный проход — для пользователя, не для нас:
# провайдеру платим в любом случае, поэтому край всё равно есть.
# DAILY_SPEND_LIMIT_USD_TEST_USER=20
# Переопределение ставки прайса, доллары: AI_PRICE_<МОДЕЛЬ>_<ВИД>,
# например AI_PRICE_GEMINI_2_5_FLASH_INPUT=0.30 (см. common/ai-pricing.ts).

# Vercel Blob (единственное файловое хранилище — см.
# doc/VERCEL-READINESS-AUDIT.md, пункт 12)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

SESSION_TTL_HOURS=24
# Невостребованные разборы библиотеки (usageCount = 0) старше этого срока
# удаляются суточной уборкой; 0 — не удалять (этап 51).
LIBRARY_UNUSED_TTL_DAYS=180

# Товар/Проект (doc/PRODUCT-PROJECT-SPEC.md). Всё необязательно — без
# ключа соответствующий эндпоинт откажет на вызове, стенд стартует.
# SerpApi Google Lens — аналоги товара по фото (§6.1), https://serpapi.com/
SERPAPI_API_KEY=
# Дневной лимит вызовов SerpApi на пользователя (§7.5) — тарификация за запрос.
SERPAPI_DAILY_LIMIT_PER_USER=50
# YouTube Data API v3 — поиск референсного видео (§6.4). search.list =
# 100 units при квоте 10 000/день по умолчанию (~100 поисков/день).
YOUTUBE_API_KEY=
YOUTUBE_SEARCH_DAILY_LIMIT_PER_USER=20
# Лимит циклов «аудит → правка → перегенерация» на ролик (§11.1),
# каждый цикл — платный прогон Veo.
AUDIT_AUTO_ITERATIONS_LIMIT=3
# Максимум товаров в одной линейке (§7.3). 500 — поднято с 20 этапом 68
# (§47, товарный фид): продавец с тремя сотнями позиций не поместился бы
# при прежнем дефолте.
PROJECT_LINE_ITEM_LIMIT=500

# xAI Grok Batch API — фоновый перевод статей блога на пять локалей
# (§35.1, этап 57). Необязателен: без ключа GrokBatchService (а значит и
# BlogTranslationService) очередь перевода пропускает и пишет в лог,
# вместо ошибки — стенд стартует как обычно.
GROK_API_KEY=
# Модель для перевода статей блога (§35.1, этап 57). Не сверена с
# console.x.ai — ПРОВЕРИТЬ перед боевым использованием.
GROK_MODEL=grok-4-fast

# Блог (doc/TODO.md §II.3, ТЗ §36, этап 57) — суточный крон ищет
# трендовые ролики YouTube в заданных категориях и заводит черновики
# через разбор Gemini; ничего не публикуется само.
# Категории поиска через запятую, например "фитнес,кулинария,техника".
# Пусто (по умолчанию) — генератор полностью выключен, это опция.
BLOG_CATEGORIES=
# Свой суточный потолок YouTube-поисков блога, отдельный от
# пользовательского выше (BlogYoutubeSearchUsage — своя таблица, см.
# комментарий в blog-youtube-budget.service.ts о том, почему не общая).
BLOG_YOUTUBE_SEARCH_DAILY_LIMIT=10
# Максимум черновиков за один прогон крона.
BLOG_DRAFTS_PER_RUN_LIMIT=5
# Минимальный балл релевантности Gemini (0-100) для превращения в черновик.
BLOG_MIN_SCORE_TO_DRAFT=60
# Максимум ожидающих переводов, подаваемых одной пачкой xAI за прогон.
BLOG_TRANSLATE_BATCH_LIMIT=50

# Постобработка ролика: обрезка кадра и настоящая озвучка (ТЗ §15/§16.1,
# этапы 34–36). Обе — ПОСЛЕ рендера, одной командой ffmpeg.
#
# Хостед-ffmpeg: Veo рендерит нативно только 16:9 и 9:16, всё остальное
# снимается в ближайшем родном и обрезается по центру уже после. У
# Vercel Functions ffmpeg нет, поэтому режет внешний сервис (по
# умолчанию verygoodffmpeg.com).
FFMPEG_API_KEY=
# Синтез речи (ElevenLabs): без ключа реплики произносит сам Veo — как
# до этапа 35. Это мягкий фоллбек, а не ошибка: стенд поднимется, ролик
# получится, интерфейс спокойно напишет, что синтез не подключён.
VOICE_API_KEY=
# Голос по умолчанию и модель синтеза. Бренд задаёт свой голос в
# манифесте; эти значения — на случай, когда он не задан. Умолчание
# модели — eleven_multilingual_v2 (умеет украинский и русский).
VOICE_ID=
VOICE_MODEL=
# Второй провайдер синтеза — Resemble AI, рядом с ElevenLabs, не вместо
# (doc/TTS-PROVIDER-ALTERNATIVES-SPEC.md). Не задан — активен ElevenLabs
# (обратная совместимость по умолчанию). Значение — "elevenlabs" или
# "resemble"; неизвестное значение тоже тихо откатится на ElevenLabs.
TTS_PROVIDER=
# Ключ Resemble; нужен, только когда TTS_PROVIDER=resemble. Без него —
# тот же мягкий фоллбек, что у VOICE_API_KEY: синтез Resemble
# пропускается, ролик всё равно получится.
RESEMBLE_API_KEY=
# Голос Resemble по умолчанию. В отличие от VOICE_ID у ElevenLabs, у
# Resemble нет универсального голоса каталога — если ни бренд, ни эта
# переменная не задают голос, синтез Resemble пропускается.
RESEMBLE_VOICE_ID=
# Свой домен хранилища, если он есть (ТЗ §12, этап 38). Пусто — сервер
# скачивает референс-изображения только со стандартного домена Vercel
# Blob. Пустое значение проверку НЕ отключает: без неё клиент мог бы
# заставить сервер сходить по любому адресу.
BLOB_PUBLIC_HOSTS=

# Служебные каналы Telegram (ТЗ §28, этап 45) — ошибки и статистика.
# Идентификаторы ЧАТОВ, а не список операторов: добавить человека —
# значит добавить его в чат, деплой для этого не нужен. Пусто — каналы
# молчат. Узнать id: добавить бота в группу и открыть
# https://api.telegram.org/bot<TOKEN>/getUpdates (у групп id отрицательный).
TELEGRAM_ALERTS_CHAT_ID=
TELEGRAM_STATS_CHAT_ID=

# Выгрузка одобренных роликов в YouTube/TikTok (ТЗ §14, этап 61). Всё
# необязательно — без ключей кнопки подключения канала в TMA видны, но
# сам обмен кода на токен откажет понятной ошибкой. API_PUBLIC_URL и
# TMA_PUBLIC_URL для локального стенда уже подставлены ниже в backend-env
# (localhost:3000/api и localhost:5173) — реальный OAuth-редирект с
# Google/TikTok на localhost всё равно недостижим извне, эти два стоят
# только для честной сборки redirect_uri при ручной проверке.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Ключ шифрования OAuth-токенов (AES-256-GCM) — 32 байта в base64.
# Сгенерировать: `openssl rand -base64 32`.
CHANNEL_TOKEN_KEY=
# Размер пачки крона и потолок попыток (§14.5) — умолчания из кода (3 и 5).
# PUBLISH_CRON_BATCH=3
# PUBLISH_MAX_ATTEMPTS=5

# Оплата: Telegram Stars и WayForPay (ТЗ §41, этап 62). Всё необязательно
# — PLANS_BILLING_ENABLED=false (см. выше) держит все режимы бесплатными
# без единого ключа отсюда; заданные здесь секреты нужны, только когда её
# включают. Секрет вебхука Telegram регистрируется отдельным ручным
# curl-вызовом setWebhook при деплое (см. backend/.env.example и
# DEPLOYMENT.md) — на локальном стенде входящий вебхук всё равно
# недостижим извне (localhost), просто оставить пустым.
TELEGRAM_WEBHOOK_SECRET=
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_SECRET=
WAYFORPAY_DOMAIN=
# Ключ шифрования recToken (регулярный платёж WayForPay) — 32 байта в
# base64, отдельный от CHANNEL_TOKEN_KEY. Сгенерировать: `openssl rand
# -base64 32`.
PAYMENT_TOKEN_KEY=
# Цены — плейсхолдеры в коде (backend/src/common/billing-pricing.ts),
# переопределить можно теми же переменными, что в backend/.env.example
# (SUBSCRIPTION_PRICE_*/CREDIT_PACK_*/FX_MICRO_USD_*).

# Рассылка: рекламный канал (ТЗ §42, этап 63). Использует уже заданный
# выше TELEGRAM_BOT_TOKEN — своего ключа не требует. Все переменные —
# тонкая настройка, умолчания из кода (7 дней, 5 карточек, 200 в пачке,
# 5 попыток); LANDING_PUBLIC_URL для локального стенда уже подставлен в
# backend-env (localhost:3003), тем же приёмом, что API_PUBLIC_URL выше.
# MARKETING_BROADCAST_FREQUENCY_DAYS=7
# MARKETING_BROADCAST_PAGE_COUNT=5
# MARKETING_CRON_BATCH=200
# MARKETING_MAX_ATTEMPTS=5

# Пакетная генерация по каталогу (ТЗ §44, этап 65) — один уже одобренный
# ролик переносится на остальные товары линейки одним заходом, кроном.
# Своего ключа не требует (переиспользует GPT-5/Veo/Gemini выше). Обе
# переменные — тонкая настройка, умолчания из кода (10 в пачке, 5
# попыток).
# CATALOG_BATCH_CRON_BATCH=10
# CATALOG_BATCH_MAX_ATTEMPTS=5

# A/B-варианты одного ролика (TODO §III.6, этап 66) — из одного уже
# одобренного ролика собираются 3 дубля, отличающихся хуком и CTA,
# кроном. Своего ключа не требует (переиспользует GPT-5/Veo выше). Обе
# переменные — тонкая настройка, умолчания из кода (10 в пачке, 5
# попыток).
# AB_TEST_CRON_BATCH=10
# AB_TEST_MAX_ATTEMPTS=5

# Товарный фид — импорт каталога по ссылке (TODO §Уровень 2 п.8, этап 68)
# — продавец вставляет ссылку на свой YML/CSV-фид, кроном скачивается и
# разбирается, затем позиции заводятся по одной. Своего ключа не требует
# (только сеть до ссылки продавца и уже настроенный BLOB_READ_WRITE_TOKEN
# для фото из фида). Три переменные — тонкая настройка, умолчания из кода
# (50 строк в пачке, 5 попыток, 8 МБ на фид).
# PRODUCT_FEED_IMPORT_CRON_BATCH=50
# PRODUCT_FEED_IMPORT_MAX_ATTEMPTS=5
# PRODUCT_FEED_IMPORT_MAX_BYTES=8388608
