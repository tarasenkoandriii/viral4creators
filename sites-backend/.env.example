# sites-backend — бэкенд клиентских сайтов (ядро site-core, ИИ-помощник, QA).
# Подробно — doc/DEPLOYMENT.md, раздел «Бэкенд клиентских сайтов (sites-backend)».
# Секретов здесь нет и быть не должно: только имена и формат.

PORT=3100
NODE_ENV=development

# Через запятую: прод-адреса TMA помощника и QA + `*.vercel.app` для превью.
CORS_ORIGIN=http://localhost:5174

# ── База ────────────────────────────────────────────────────────────────
# Та же физическая Postgres/Supabase, что у backend/, но СВОЯ схема `sites`.
#
# Приложение: ПУЛЕРНАЯ строка (Supavisor, transaction-режим, порт 6543).
# Схему выбирает драйвер-адаптер (`schema: 'sites'`), `?schema=` здесь не нужен.
SITES_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Миграции (`prisma migrate deploy`): ПРЯМАЯ строка (порт 5432), обязательно
# с `?schema=sites` — иначе таблицы и история миграций поедут в `public`.
SITES_DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?schema=sites"

# Публичные маршруты виджета (`/widget/v1/*`) — второй клиент Prisma
# (`AssistPublicDb`) под логин-ролью, входящей в `assist_public` (нет прав на
# assist_admin_*). Логин-роль владелец создаёт руками (doc/DEPLOYMENT.md, 6.4).
# Пользователь ОБЯЗАН отличаться от пользователя SITES_DATABASE_URL — иначе
# сервис не стартует (слой 3 изоляции выключился бы молча). Без переменной
# сервис поднимается с предупреждением: маршрутов виджета на Э0 ещё нет.
# ASSIST_PUBLIC_DATABASE_URL="postgresql://assist_widget.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ── Telegram: два бота в одном бэкенде (ТЗ помощника §4.1) ─────────────
# Бот выбирается по заголовку `X-Telegram-App: assist|qa`; initData
# проверяется токеном ИМЕННО этого бота, перебора токенов нет. Нет токена
# своего бота — вход в это приложение отвечает 503 (а не проверяет чужим).
# Токены — из @BotFather, только в Vercel/локальном .env.
# ASSIST_BOT_TOKEN=
# QA_BOT_TOKEN=
# Секреты вебхуков (`secret_token` в setWebhook; Telegram присылает его в
# `X-Telegram-Bot-Api-Secret-Token`). Свой у каждого бота; 1–256 символов
# A-Z a-z 0-9 _ -, например `openssl rand -hex 32`. Нет секрета — вебхук 503.
#   POST /assist/webhook/telegram ← ASSIST_WEBHOOK_SECRET
#   POST /qa/webhook/telegram     ← QA_WEBHOOK_SECRET
# ASSIST_WEBHOOK_SECRET=
# QA_WEBHOOK_SECRET=

# ── Веб-кабинет: вход виджетом Telegram в обычном браузере (Э0-W) ──────
# Тот же фронт `assist/` вне Telegram; вход — Telegram Login Widget бота
# помощника (подпись проверяется ASSIST_BOT_TOKEN — нового секрета нет),
# сессия — HttpOnly-cookie `v4c_site_session` (имя — src/brand.ts).
# Фронт ходит в API через same-origin прокси (rewrite `/api/*` в
# Vercel-проекте assist), поэтому cookie первосторонняя (SameSite=Lax).
# Через запятую — ТОЧНЫЕ origin кабинета (схема+домен[+порт], без пути и
# без `*`): только с них принимаются изменяющие запросы по cookie (CSRF).
# Они же автоматически добавляются в CORS. В production пустое значение =
# все POST/PATCH/DELETE по cookie закрыты (403); вход тоже.
# WEB_CABINET_ORIGINS=https://assist.example.com

# Дев-вход вне Telegram (заголовок `X-Dev-User-Id: <число>`) — только при
# ALLOW_DEV_AUTH=true И NODE_ENV != production (то же правило, что backend).
# То же условие открывает POST /sites/auth/web-dev-login (вход в веб-кабинет
# без виджета: на localhost виджет Telegram не работает) и снимает Secure
# с cookie сессии (Safari не хранит Secure-cookie для http://localhost).
# В проде не задавать.
# ALLOW_DEV_AUTH=true

# ── Адрес клиента (П-С1, заход 10; doc/DEPLOYMENT.md §6.3) ──────────────
# Нужен ТОЛЬКО вне Vercel (Docker за Traefik/Dokploy/nginx). На Vercel
# (`VERCEL` задаёт платформа) адрес — первый в X-Forwarded-For, переменная
# не читается. Вне Vercel X-Forwarded-For читается, только если соединение
# пришло от прокси из этих подсетей (через запятую, CIDR; цепочка справа
# налево, берётся первый недоверенный адрес); иначе — адрес сокета.
# `none` — «прокси перед сервисом нет» (явное решение, без предупреждения).
# Production вне Vercel без переменной — предупреждение на старте (не отказ):
# за прокси все лимиты по адресу стали бы общими для всех посетителей.
# TRUSTED_PROXY_CIDRS=10.0.1.0/24

# ── Ключи ───────────────────────────────────────────────────────────────
# Общий ключ секретов помощника — 32 байта в base64 (`openssl rand -base64 32`):
# секреты «Админки» (ТЗ §5.6), поля и identity лидов, секреты интеграций,
# visitor-token, recToken, liveValues, ссылки на ролик, assistRef, билеты
# голоса, итоги мемо, подпись экспорта карты. Менять — ТОЛЬКО ротацией
# (версия + прежний ключ ниже, `npm run secrets:rotate`; DEPLOYMENT §6.3).
# Для первого запуска виджета задайте случайный ключ в Production и пересоберите API.
# Без него /widget/v1/session отвечает WIDGET_DISABLED даже после публикации.
# ASSIST_SECRETS_KEY=

# ── Кроны (sites-backend/vercel.json) ───────────────────────────────────
# Vercel Cron шлёт `Authorization: Bearer <CRON_SECRET>`. Без переменной
# крон-маршруты закрыты (503), кроме dev-стенда (ALLOW_DEV_AUTH=true вне
# production). Значение — своё для этого проекта, не копия backend.
# CRON_SECRET=

# ── Э1 «Знания»: ИИ, документы, песочница ──────────────────────────────
# Ключ Gemini (эмбеддинги gemini-embedding-001 768, ответы песочницы) —
# те же имена, что у backend (shared/gemini-client.ts): GEMINI_API_KEY или
# GOOGLE_GEMINI_API_KEY. Можно тот же ключ, что у генератора, но лучше
# отдельный проект Google — свой лимит и свой счёт.
# GEMINI_API_KEY=
# Модель ответов песочницы (по умолчанию gemini-3.6-flash, shared/gemini-model.ts).
# GEMINI_MODEL=
# Ставки прайса переопределяются как у backend: AI_PRICE_<МОДЕЛЬ>_<INPUT|OUTPUT|…>
# в долларах, например AI_PRICE_GEMINI_EMBEDDING_001_INPUT=0.15

# Vercel Blob — приватные документы знаний (assist/<кабинет>/<сайт>/site|admin/…).
# Свой Blob-store проекта sites-backend (Storage → Blob → Connect): Vercel
# сам кладёт сюда токен. Документы грузятся из TMA напрямую в Blob по
# клиентскому токену (лимит тела функции 4,5 МБ), токен read-write в
# браузер не уходит. Заход 10: тот же store — экспорт CSV «Админки»
# (assist/<кабинет>/<сайт>/admin-exports/, ссылка 24 ч).
# BLOB_READ_WRITE_TOKEN=

# Адрес TMA помощника — кнопка «Открыть» в уведомлениях бота (удержанная
# версия базы, карантин): https://<домен assist>
# ASSIST_TMA_URL=

# Публичная песочница лендинга (/public/assist/sandbox*). Рубильник: пока не
# `true` — маршрут отвечает «сейчас недоступно, оставьте заявку». Суточный
# денежный потолок всех публичных песочниц — ВКЛЮЧЁН всегда (умолчание $5).
# ASSIST_SANDBOX_PUBLIC_ENABLED=false
# ASSIST_SANDBOX_PUBLIC_DAILY_CAP_USD=5
# Origin лендинга через запятую (фильтр, не защита; их же добавьте в CORS_ORIGIN).
# ASSIST_LANDING_ORIGINS=https://<домен лендинга>

# ── Э2 «Виджет на сайте заказчика» (doc/DEPLOYMENT.md §6.10) ───────────
# Origin загрузчика/iframe/API виджета (Vercel-проект widget, rewrite на
# этот бэкенд). Обязательна в проде.
# ASSIST_WIDGET_ORIGIN=https://w.<домен>
# Аварийный рубильник платформы: false — все виджеты отвечают формой заявки.
# ASSIST_WIDGET_ENABLED=true
# Суточный потолок ответов всех сайтов, USD (умолчание 20).
# ASSIST_WIDGET_PLATFORM_DAILY_CAP_USD=20
# Внутренние тенанты платформы (Ш5 (4) / Ш6 (8)): id сайтов через запятую
# (viral4creators — ASSIST_LANDING_SITE_ID backend). Кабинет, которому
# принадлежит такой сайт, — тариф pro бессрочно, без мягкого стопа единиц и
# без оплаты (checkout — 409 INTERNAL_PLAN). Денежные потолки остаются:
# суточный сайта (по pro или ручной колонке), платформы (выше), бюджеты
# обучения/аналитики. Пусто — внутренних нет.
# ASSIST_INTERNAL_SITE_IDS=
# Кто может встроить предпросмотр конфигуратора (через запятую); умолчание —
# ASSIST_TMA_URL, WEB_CABINET_ORIGINS и https://web.telegram.org.
# ASSIST_PREVIEW_FRAME_ANCESTORS=
# ТОЛЬКО локально (интеграционный прогон виджета без ключа и сети):
# заглушка Gemini — эмбеддинги «мешком слов», ответ из первого источника.
# В production флаг роняет старт (NODE_ENV=production ставит платформа).
# SITES_DEV_FAKE_GEMINI=true
# SITES_DEV_FAKE_GEMINI_DELAY_MS=60
# SITES_DEV_FAKE_GEMINI_LOG=/tmp/fake-gemini.log

# ── Э4 «Тарифы и оплата» (doc/DEPLOYMENT.md §6.12) ─────────────────────
# Мерчант WayForPay Помощника (форма покупки, вебхук, продление по recToken).
# ASSIST_WAYFORPAY_MERCHANT_ACCOUNT=
# ASSIST_WAYFORPAY_MERCHANT_SECRET=
# ASSIST_WAYFORPAY_DOMAIN=
# https-origin этого бэкенда — serviceUrl вебхука WayForPay.
# SITES_PUBLIC_URL=https://<домен sites-backend>
# Курсы к ориентиру USD (§7.1): гривна и Stars, которые получает бот.
# ASSIST_UAH_PER_USD=41.5
# ASSIST_STARS_PER_USD=77
# Потолок цены подписки Stars с автопродлением (дороже — разовая оплата).
# ASSIST_STARS_SUBSCRIPTION_MAX=10000
# Условия и DPA (ссылки юриста; версии — assist-billing/billing-env.ts).
# ASSIST_TERMS_URL=https://...
# ASSIST_DPA_URL=https://...
# Внутренний API вкладки «Помощник» админки платформы (тот же у backend).
# SITES_INTERNAL_SECRET=
# Внутренний API обучалки генератора (режим A/B, Э-С Ш1): HMAC-секрет
# подписи запросов, тот же, что SITES_TUTORIAL_HMAC_SECRET у backend,
# ≥ 32 символов (openssl rand -hex 32). Не задан — маршруты обучалки
# закрыты (503), генератор помечает все сайты «не подтверждён». Совпадает с
# любым другим секретом этого файла (CRON_SECRET, ASSIST_SECRETS_KEY,
# ключ SITE_CREDENTIALS_KEYS, SITES_INTERNAL_SECRET, секрет воркера или
# Flow-QA, …) — тоже 503 (в логе — имена переменных, без значений).
# SITES_TUTORIAL_HMAC_SECRET=
# Origin backend генератора для обратного направления «sites-backend →
# backend» (мемо из шагов одобренной обучалки, заход 2 06.10.2026):
# sites-backend забирает шаги GET /api/internal/client-site-tutorial/
# memo-steps/:siteId/:draftId с подписью тем же SITES_TUTORIAL_HMAC_SECRET
# (вызывающий `sites-memo`). Только https (или localhost/backend в compose).
# Не задан — кнопка «Из обучалки» в TMA показывает «не настроено».
# GENERATOR_INTERNAL_URL=
# Э-С Ш4: внутренний API карты интерфейса для Flow-QA (QA-воркер, Э7b) —
# СВОЙ HMAC-секрет (не тот, что у обучалки и не любой другой секрет этого
# файла), ≥ 32 символов. Не задан или совпал — маршруты
# /internal/sites/qa/ui-map/* закрыты (503).
# SITES_QA_HMAC_SECRET=

# ── Э-С Ш2: тестовые учётные записи сайта и хранилище их секретов ──
# Ключи шифрования AES-256-GCM с версией: «v1:<base64 32 байта>,v2:<…>»
# (openssl rand -base64 32 на каждую версию). Текущая версия (ею шифруется
# всё новое) — SITE_CREDENTIALS_KEY_CURRENT (при одном ключе можно не
# задавать). Ротация: дописать v2, переключить текущую, прогнать
# npm run credentials:rotate -- --apply, убрать v1 после отчёта «0 строк».
# Не задан — хранилище выключено (503 CREDENTIALS_NOT_CONFIGURED), обучалка
# генератора пишет данные входа в свои колонки, как до Ш2.
# SITE_CREDENTIALS_KEYS=
# SITE_CREDENTIALS_KEY_CURRENT=v1

# ── Э-С Ш3: браузерный воркер (doc/DEPLOYMENT.md §6.25) ──
# Главный выключатель. Не задан/false — как до Ш3: задания не ставятся
# («Админка» — waiting_worker, «Снимок»/сверка карты — 409), claim пуст;
# выключение посреди работы — kill-switch (идущие гасятся на heartbeat).
# BROWSER_WORKER_ENABLED=false
# Подпись запросов воркера (≥ 32, openssl rand -hex 32) — СВОЯ: совпадение с
# любым другим секретом этого файла (SITES_TUTORIAL_HMAC_SECRET,
# SITES_QA_HMAC_SECRET, SITES_INTERNAL_SECRET, CRON_SECRET, ASSIST_SECRETS_KEY
# и ASSIST_SECRETS_KEYS_OLD, любой ключ SITE_CREDENTIALS_KEYS, …) закрывает
# канал (503). То же значение — в .env воркера на VPS.
# SITES_WORKER_HMAC_SECRET=
# Открытый ключ конверта учёток (X25519, base64url, 43 символа) — пара к
# BROWSER_WORKER_SEAL_PRIVATE_KEY воркера (node dist/seal-keygen.js). Не
# задан — обход «Админки» за логином воркеру не выдаётся.
# SITES_WORKER_SEAL_PUBLIC_KEY=

# ── Э5 «Голос» (doc/DEPLOYMENT.md §6.14) ──
# Ключ Soniox помощника (свой проект, не ключ генератора). Нет — голоса нет.
# SONIOX_API_KEY=
# Аварийный рубильник голоса всех сайтов: false — кнопки голоса пропадают.
# ASSIST_VOICE_ENABLED=true
# Голос озвучки по умолчанию (справочник Soniox), умолчание — Maya.
# ASSIST_TTS_VOICE=Maya
# ТОЛЬКО локально: записи дикторов для `npm run eval:voice` (WER, приёмка Э5 п.3).
# ASSIST_VOICE_EVAL_DIR=

# ── Э6 «Видео и подсветка» (doc/DEPLOYMENT.md §6.15) ──
# Где лежат ролики обучалки генератора: суффиксы хостов через запятую.
# Умолчание — публичный Vercel Blob (.public.blob.vercel-storage.com). Ролик
# с другого хоста внутренний API не принимает; CSP iframe чата разрешает
# media-src ровно этим хостам. Стенд: localhost.
# ASSIST_VIDEO_HOSTS=.public.blob.vercel-storage.com
# Mini App генератора для кнопки «Снять новое обучение» экрана «Видео» TMA
# (deep-link ?startapp=cst_<siteId>). Нет — кнопки нет.
# GENERATOR_TMA_URL=https://t.me/<бот генератора>/app

# ── Э7 «Админка: чтение» (doc/DEPLOYMENT.md §6.19) ─────────────────────
# Origin iframe чата сотрудника — ОТДЕЛЬНЫЙ от ASSIST_WIDGET_ORIGIN (§4.12,
# У-13): тот же Vercel-проект widget, второй домен (временно
# https://assist-wa.viral4creators.app). Обязательна в проде для «скрипта в
# админке» (7b); совпадение с ASSIST_WIDGET_ORIGIN — ошибка конфигурации.
# ASSIST_ADMIN_WIDGET_ORIGIN=https://wa.<домен>
# Ротация ASSIST_SECRETS_KEY — общая для всех потребителей (№60, заход 10;
# порядок — doc/DEPLOYMENT.md §6.3 «Ротация ASSIST_SECRETS_KEY»): версия
# текущего ключа (умолчание v1) и прежние ключи только для расшифровки —
# «v1:<ключ>,…». Шифруется всегда текущим ключом, читается всей связкой;
# перешифровка — `npm run secrets:rotate` (dry-run / --apply). Прежний ключ
# убирать только при `remaining: 0` и не раньше чем через 2 суток.
# ASSIST_SECRETS_KEY_VERSION=v1
# ASSIST_SECRETS_KEYS_OLD=

# ── Э6-бис «Голосовое управление» (doc/DEPLOYMENT.md §6.17) ────────────
# Аварийный рубильник голосового управления всех сайтов: false — поле
# voiceControl пропадает из конфига виджета (≤ 5 мин кэша), маршруты плана —
# VOICE_CONTROL_OFF. Умолчание — включён.
# ASSIST_VOICE_CONTROL_ENABLED=true
# Telegram chat id служебного канала платформы (тот же бот помощника):
# нарушения запрета, авто-выключение, откат канарейки. Нет — только лог.
# ASSIST_OPS_CHAT_ID=

# ── Э3-бис «Аналитика с ИИ» (doc/DEPLOYMENT.md §6.21) ──────────────────
# Lite-модель разметки и выводов (ставка — в shared/ai-pricing.ts или
# AI_PRICE_*). Не задана / без ставки — только находки кодом. Заход 10: она
# же включает разметку диалогов и выводы недели «Админки» (из суточного
# потолка «Админки», ≤ 50 %).
# ASSIST_LITE_MODEL=gemini-2.5-flash-lite
# Суточный потолок платформы на assist-label + assist-insight, USD (умолчание 5).
# ASSIST_ANALYTICS_PLATFORM_DAILY_USD=5
# Подпись V4CAssist('ref'), ≥ 16 символов; без неё — производная от
# ASSIST_SECRETS_KEY. Своё значение — не копия другого секрета этого файла.
# ASSIST_ANALYTICS_REF_SECRET=
# Заход 9: ИИ-разметка пакетом Gemini Batch API (1 — включить; умолчание —
# выкл., вызовы по одному). Включать после проверки на своём ключе, что
# lite-модель доступна в Batch API.
# ASSIST_LABEL_BATCH=1
# Доля цены пакетного вызова от обычного (0 < x ≤ 1), умолчание 0.5 —
# ПРОВЕРИТЬ по прайсу Google до включения ASSIST_LABEL_BATCH.
# ASSIST_LABEL_BATCH_PRICE_FACTOR=0.5

# ── Э6-тер «Визуальный редактор голосовой карты» (doc/DEPLOYMENT.md §6.22) ──
# Origin панели редактора (тот же Vercel-проект widget, домен we.); без
# переменной выводится из ASSIST_WIDGET_ORIGIN (assist-w. → assist-we.).
# Совпадение с ASSIST_WIDGET_ORIGIN — ошибка конфигурации.
# ASSIST_EDITOR_WIDGET_ORIGIN=https://we.<домен>
# Ключ подписи экспорта карты (пометка «наш файл без правок» при импорте).
# По желанию: без него — производный HMAC(ASSIST_SECRETS_KEY,
# 'voice-map-export-v1'); без обоих файл «нашим» не признаётся.
# ASSIST_VOICE_MAP_EXPORT_KEY=
# Заход 11 (№117): ключ подписи экспорта карты «Админки» (файл kind: admin).
# По желанию: без него — производный HMAC(ASSIST_SECRETS_KEY,
# 'admin-voice-map-export-v1'); метка отличается от «Сайта», поэтому файл
# одного контура «нашим» в другом не признаётся (doc/DEPLOYMENT.md §6.22 п.9).
# ASSIST_ADMIN_VOICE_MAP_EXPORT_KEY=

# ── Э-С Ш6 «Гид мастера TMA → „Админка“» (doc/DEPLOYMENT.md §6.24) ─────
# id сайтов (через запятую), чьё окно сотрудника открывается и в Telegram
# Web (frame-ancestors + https://web.telegram.org, только вместе с
# verified-хостами). Мобильным клиентам Telegram не нужна.
# УСТАРЕВАЕТ (заход 10): то же включает галочка сайта в кабинете
# («Админка — TMA», флаг `adminTmaFrame`); env работает как OR до удаления.
# ASSIST_ADMIN_TMA_SITE_IDS=
