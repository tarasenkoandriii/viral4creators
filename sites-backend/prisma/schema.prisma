}

model AssistAdminKnowledgeVersion {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  number                Int
  trigger               String
