// Схема `sites` — база sites-backend (ядро site-core, общее с QA, и
// таблицы ИИ-помощника). Физически та же Postgres/Supabase, что у
// генератора (backend/), но отдельная postgres-схема со своей историей
// миграций: генератор и сайты не делят ни одной таблицы и ни одной
// миграции (решение координатора Э0, п.2).
//
// Подключения (Prisma 7 — строк в этом файле нет вовсе):
//  - CLI (`migrate deploy`/`migrate diff`) — `SITES_DIRECT_URL` из
//    ../prisma.config.ts, обязательно с `?schema=sites`;
//  - приложение — `SITES_DATABASE_URL` (пулер) через драйвер-адаптер с
//    `schema: 'sites'` (src/prisma/prisma.service.ts).
//
// Миграции пишутся РУКАМИ (как в backend, doc/TELEGRAM-ADMIN.md §5), CI
// сверяет их со схемой `prisma migrate diff --exit-code`. Имена таблиц —
// по ТЗ помощника §4.17 и QA-ТЗ §4.7/§1.5: `site_*` — ядро, `assist_*` —
// помощник, `qa_*` — QA (в Э0 не создаются).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // pgvector — в схеме `extensions`: там его держит Supabase, и там же его
  // создаёт первая миграция (CREATE EXTENSION … WITH SCHEMA extensions).
  // pg_trgm (Э1, гибридный поиск по артикулам, ТЗ помощника §4.3) — там же,
  // миграция `…_assist_knowledge`.
  extensions = [vector(schema: "extensions"), pg_trgm(schema: "extensions")]
}

// ══ ОБЩЕЕ ЯДРО site-core (таблицы site_*) — одно на QA и Помощника ══

/// Кабинет заказчика (= `AuditOwner` QA-ТЗ §4.7) — ТЕНАНТ всего, что ниже.
model SiteAccount {
  id     String @id @default(cuid())
  /// owner | agency
  type   String @default("owner")
  /// UA | EU | US | other — уточняется в онбординге; умолчание нужно, чтобы
  /// кабинет можно было создать при первом входе одним INSERT (§4.16).
  region String @default("other")

  /// Токен кабинета для TXT/файла/меты (QA §2.4): один на все хосты
  /// кабинета, ротируемый. Уникален — по нему проверка находит кабинет.
  verifyToken          String    @unique
  verifyTokenRotatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      SiteAccountMember[]
  sites        Site[]
  hosts        SiteHost[]
  invites      SiteAccountInvite[]
  /// Э2: атрибуция лендинга (вместо поля в ядре — лендинг-ТЗ §7.3, Д-8).
  acquisitions AssistAcquisition[]

  @@map("site_accounts")
}

/// Участник кабинета. Человек узнаётся по `telegramId` — он один и тот же
/// у человека в обоих ботах (Помощника и QA).
model SiteAccountMember {
  id        String      @id @default(cuid())
  accountId String
  account   SiteAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  telegramId   BigInt
  /// owner | manager | operator — роль в кабинете.
  role         String
  /// { qa: admin|viewer|none, assist: manager|operator|none,
  ///   assistAdmin: owner|employee|none } — права по продукту (ТЗ помощника
  /// §3.2, QA §1.5). Умолчание для всех, кроме владельца, — `none`.
  productRoles Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, telegramId])
  /// Вход: «в каких кабинетах этот человек» — поиск по одному telegramId.
  @@index([telegramId])
  @@map("site_account_members")
}

/// Приглашение участника (ТЗ помощника §3.2, §4.16 `POST /sites/account/invites`):
/// ссылка `t.me/<бот>?startapp=inv_<token>` из любого из двух ботов,
/// одноразовая, 7 дней. В базе — только SHA-256 токена: утечка таблицы не
/// даёт войти в чужой кабинет.
model SiteAccountInvite {
  id        String      @id @default(cuid())
  accountId String
  account   SiteAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  tokenHash           String    @unique
  /// manager | operator — владельца пригласить нельзя.
  role                String
  productRoles        Json
  createdByTelegramId BigInt
  expiresAt           DateTime
  usedAt              DateTime?
  usedByTelegramId    BigInt?

  createdAt DateTime @default(now())

  @@index([accountId])
  @@map("site_account_invites")
}

/// Логический сайт («Магазин X»). Подтверждается не он, а его хосты.
model Site {
  id          String      @id @default(cuid())
  accountId   String
  account     SiteAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Под-клиент агентства (`EndClient` QA) — таблица появится вместе с QA.
  endClientId String?
  name        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hosts SiteHost[]

  // Э1: обход (общий с QA) и знания помощника. Все — составным ключом
  // (siteId, accountId): строку чужого кабинета к сайту не привязать.
  pages               SitePage[]
  crawlRuns           SiteCrawlRun[]
  assistSite          AssistSite?
  assistAdminSettings AssistAdminSettings?
  learningSpend       AssistLearningSpend[]
  siteSources         AssistSiteSource[]
  siteDocuments       AssistSiteDocument[]
  siteChunks          AssistSiteChunk[]
  siteVersions        AssistSiteKnowledgeVersion[]
  siteFaq             AssistSiteFaq[]
  siteExclusions      AssistSiteExclusion[]
  siteEvalCases       AssistSiteEvalCase[]
  siteEvalRuns        AssistSiteEvalRun[]
  adminSources        AssistAdminSource[]
  adminDocuments      AssistAdminDocument[]
  adminChunks         AssistAdminChunk[]
  adminVersions       AssistAdminKnowledgeVersion[]
  adminFaq            AssistAdminFaq[]
  adminExclusions     AssistAdminExclusion[]
  sandboxes           AssistSandbox[]

  // Э2: виджет режима «Сайт» (контракт /tmp/k/CONTRACT-E2.md).
  siteConfigVersions AssistSiteConfigVersion[]
  visitorResumes     AssistSiteVisitorResume[]
  conversations      AssistSiteConversation[]
  siteMessages       AssistSiteMessage[]
  siteLeads          AssistSiteLead[]
  periodUsage        AssistSitePeriodUsage[]
  semanticCache      AssistSiteSemanticCache[]
  previewTokens      AssistSitePreviewToken[]
  installPings       AssistSiteInstallPing[]
  wizard             AssistSiteWizard?
  assistSiteAssets   AssistSiteAsset[]

  /// Цель составного внешнего ключа хоста (siteId, accountId): база сама не
  /// даст привязать хост кабинета A к сайту кабинета B.
  @@unique([id, accountId])
  @@index([accountId])
  @@map("site_sites")
}

/// Хост = единица подтверждения владения: схема + FQDN (punycode) + порт.
model SiteHost {
  id        String      @id @default(cuid())
  /// Денормализовано из Site: подтверждение — на пару (кабинет, хост),
  /// QA §5.1, и уникальность ниже считается в пределах кабинета.
  accountId String
  account   SiteAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site        @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  scheme                     String    @default("https")
  /// FQDN, нормализованный, punycode, без точки на конце.
  host                       String
  port                       Int       @default(443)
  /// *.myshopify.com и т.п. → подтверждение только через DNS.
  publicPlatform             Boolean   @default(false)
  /// pending | verified | expired | revoked
  status                     String    @default("pending")
  /// dns | file | meta
  method                     String?
  verifiedAt                 DateTime?
  /// verifiedAt + 90 дней.
  expiresAt                  DateTime?
  lastRecheckAt              DateTime?
  revokedAt                  DateTime?
  /// Итог последней проверки (ручной или крона) для экрана: `{ ok, code,
  /// message, at }`. Статус хоста он не заменяет — только объясняет.
  lastCheck                  Json?
  /// Подтверждение этого кабинета отозвано ДРУГИМ кабинетом, подтвердившим
  /// тот же хост (QA §5.1): повторное подтверждение заблокировано, пока
  /// тот не снимет блокировку. Строку с блокировкой удалить нельзя — иначе
  /// «удалить и добавить заново» обходило бы блокировку.
  reverifyBlockedAt          DateTime?
  reverifyBlockedByAccountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  challenges SiteOwnershipChallenge[]
  /// Э1: публичные страницы хоста. Удалили хост — страницы уходят вместе с
  /// ним: без подтверждённого хоста их и обходить было нельзя.
  pages      SitePage[]

  /// Дубль хоста в кабинете — ошибка при добавлении (QA §2.2), а не второй
  /// Site; разные кабинеты один хост иметь могут.
  @@unique([accountId, scheme, host, port])
  /// Цель составного ключа challenge (hostId, accountId).
  @@unique([id, accountId])
  /// «Кто ещё подтвердил этот хост» (§4.16, authorizations).
  @@index([host])
  @@index([siteId])
  /// Крон `site-ownership-recheck`: verified-хосты, давно не проверенные, — первыми.
  @@index([status, lastRecheckAt])
  @@map("site_hosts")
}

/// Выданный токен/метод проверки владения хостом (QA §4.7, §2.4).
model SiteOwnershipChallenge {
  id            String    @id @default(cuid())
  /// Сверх полей QA §4.7: нужен Prisma-extension тенанта (каждая таблица
  /// кабинета несёт accountId) и составному ключу на хост.
  accountId     String
  hostId        String
  host          SiteHost  @relation(fields: [hostId, accountId], references: [id, accountId], onDelete: Cascade)
  /// dns | file | meta
  method        String
  token         String
  /// pending | verified | failed | expired | revoked
  status        String    @default("pending")
  checkedAt     DateTime?
  lastRecheckAt DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([hostId])
  @@index([accountId])
  @@map("site_ownership_challenges")
}

/// Домены, владельцы которых отказались от любых наших проверок/обходов.
/// Глобальный справочник — без тенанта.
model SiteOptOutDomain {
  id          String    @id @default(cuid())
  domain      String    @unique
  /// complaint | robots | email | operator
  source      String
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("site_opt_out_domains")
}

/// Учёт расходов ИИ обоих продуктов — форма `AiUsage` генератора
/// (backend/prisma/schema.prisma, model AiUsage) + кабинет/сайт/продукт.
/// Внешних ключей нет намеренно: расход уже понесён, удаление кабинета или
/// сайта не должно стирать историю затрат (тот же довод, что у
/// `AiUsage.sessionId`).
model SiteAiUsage {
  id String @id @default(cuid())

  /// NULL — вызов вне кабинета (публичная песочница лендинга).
  accountId String?
  siteId    String?
  /// qa | assist
  product   String

  /// GEMINI | OPENAI | … — кто выставит счёт.
  provider  String
  /// assist-chat, assist-embed, qa-explain, …
  operation String
  model     String

  inputTokens       Int @default(0)
  cachedInputTokens Int @default(0)
  outputTokens      Int @default(0)
  seconds           Int @default(0)
  calls             Int @default(1)
  characters        Int @default(0)

  costMicroUsd   Int     @default(0)
  pricingVersion String
  /// Ставки в прайсе не нашлось: объём записан, деньги — нули.
  unpriced       Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([siteId, createdAt])
  @@index([createdAt])
  @@map("site_ai_usage")
}

/// Сессия веб-кабинета: вход виджетом Telegram в обычном браузере (не
/// TMA). Глобальная таблица, вне тенанта: сессия — это ЛИЧНОСТЬ Telegram,
/// а не членство в кабинете; права по-прежнему решает site_account_members
/// на каждом запросе. Удаление участника сессии не трогает.
///
/// В базе — только SHA-256 токена (как у приглашений): утечка таблицы не
/// даёт войти. Токен живёт только в HttpOnly-cookie браузера.
model SiteWebSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  telegramId BigInt
  /// Приложение, чьим ботом подписан вход. Веб-кабинет — `assist` (бот
  /// помощника, ASSIST_BOT_TOKEN).
  app        String
  /// Из данных виджета на момент входа — для экрана «вы вошли как…».
  username   String?
  firstName  String?
  createdAt  DateTime  @default(now())
  /// Скользящее продление: не чаще раза в сутки (см. web-session.service).
  expiresAt  DateTime
  revokedAt  DateTime?
  /// Обрезанный User-Agent — для будущего списка «где вы вошли».
  userAgent  String?
  /// Хеш IP с суточной солью; сырой IP не хранится.
  ipHash     String?

  /// «Выйти везде»: все живые сессии человека.
  @@index([telegramId])
  /// Чистка просроченных.
  @@index([expiresAt])
  @@map("site_web_sessions")
}

/// Замок крона (аналог `CronJobLock` генератора, backend/prisma/schema.prisma):
/// одна строка на крон, TTL — защита от упавшего процесса. Не advisory-lock:
/// пулер Supabase в transaction-режиме не держит сессию между запросами.
/// Глобальная таблица — кроны идут по всем кабинетам.
model SiteCronLock {
  jobKey         String    @id
  /// null или прошлое — свободен.
  lockedUntil    DateTime?
  holder         String?
  lastStartedAt  DateTime?
  lastFinishedAt DateTime?
  lastError      String?

  @@map("site_cron_locks")
}

// ══ Обход публичных страниц `site-crawl` (Э1) — общий с QA ══
//
// Пишет ТОЛЬКО модуль site-crawl и ТОЛЬКО публичные страницы
// `verified`-хостов сайта — без cookie и без сессии (ТЗ помощника §3.4, У-9).
// Закрытая зона «Админки» сюда не попадает никогда (Э7: assist_admin_pages).
// Знания помощника читают отсюда текст и строят СВОИ фрагменты в
// assist_site_* / assist_admin_* — двумя независимыми конвейерами (Р-19).

/// Публичная страница verified-хоста — кэш последнего обхода.
model SitePage {
  id        String   @id @default(cuid())
  accountId String
  siteId    String
  site      Site     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  hostId    String
  host      SiteHost @relation(fields: [hostId, accountId], references: [id, accountId], onDelete: Cascade)

  /// Нормализованный URL (без фрагмента, без трекинговых параметров).
  url            String
  /// Куда привёл редирект в пределах того же хоста (если привёл).
  finalUrl       String?
  httpStatus     Int?
  /// new | ok | not_modified | skipped | failed | gone
  status         String    @default("new")
  /// robots | noindex | not_html | too_large | redirect_offsite | ssrf |
  /// excluded | limit | http_4xx | http_5xx | timeout | empty | duplicate
  skipReason     String?
  title          String?
  /// Язык основного текста (`<html lang>` + эвристика букв): uk | ru | en | …
  lang           String?
  /// Основной текст, нормализованный (для хеша и для QA).
  text           String?
  /// Блоки извлечения для чанкера: [{ t: 'h'|'p'|'li'|'tr'|'faq', level?,
  /// text, path: string[], ugc?: true }] — форма в site-crawl/types.ts.
  blocks         Json?
  /// SHA-256 нормализованного основного текста.
  contentHash    String?
  etag           String?
  lastModified   String?
  sitemapLastmod DateTime?
  /// seed | sitemap | link | hot | manual
  source         String    @default("seed")
  depth          Int       @default(0)
  failCount      Int       @default(0)
  fetchedAt      DateTime?
  /// Когда contentHash менялся в последний раз (переиндексация — по нему).
  changedAt      DateTime?
  goneAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hostId, url])
  @@index([siteId, changedAt])
  @@index([accountId])
  @@map("site_pages")
}

/// Прогон обхода сайта (очередь — Postgres с lease, не SKIP LOCKED: ТЗ §4.14).
model SiteCrawlRun {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// assist | qa — чей запрос (расписание у продуктов своё).
  product  String
  /// initial | schedule | manual | webhook | hot
  trigger  String
  /// full | hot | urls
  mode     String @default("full")
  /// queued | running | done | failed | cancelled
  status   String @default("queued")
  maxPages Int
  /// Параметры запроса: { urls?, excludePrefixes?, hostIds? }.
  options  Json   @default("{}")

  pagesSeen      Int   @default(0)
  pagesChanged   Int   @default(0)
  pagesUnchanged Int   @default(0)
  pagesSkipped   Int   @default(0)
  pagesFailed    Int   @default(0)
  pagesGone      Int   @default(0)
  /// Сводка для экрана: пропущенные по причинам, языки, найденная sitemap.
  stats          Json?

  lockedUntil           DateTime?
  attempts              Int       @default(0)
  requestedByTelegramId BigInt?
  startedAt             DateTime?
  finishedAt            DateTime?
  error                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  queue SiteCrawlQueueItem[]

  @@unique([id, accountId])
  @@index([status, lockedUntil])
  @@index([siteId, createdAt])
  @@index([accountId])
  @@map("site_crawl_runs")
}

/// URL в очереди прогона. Поштучный lease: два тика не берут одну строку.
model SiteCrawlQueueItem {
  id        String       @id @default(cuid())
  accountId String
  runId     String
  run       SiteCrawlRun @relation(fields: [runId, accountId], references: [id, accountId], onDelete: Cascade)
  siteId    String
  hostId    String

  url      String
  depth    Int    @default(0)
  /// Больше — раньше: горячие и свежие по lastmod — первыми (ТЗ §4-тер.2).
  priority Int    @default(0)
  /// seed | sitemap | link | hot | manual
  source   String @default("seed")
  /// pending | done | skipped | failed
  status   String @default("pending")

  lockedUntil DateTime?
  attempts    Int       @default(0)
  lastError   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, url])
  @@index([runId, status, priority])
  @@index([accountId])
  @@map("site_crawl_queue")
}

/// robots.txt и sitemap по origin — публичная информация, кэш на 24 ч, общий
/// для всех кабинетов и песочниц (не долбим чужой сайт повторно).
model SiteCrawlRobots {
  /// `https://host` (порт 443 не пишется).
  origin       String   @id
  httpStatus   Int?
  /// Тело robots.txt (обрезано до лимита); null — не было или ошибка.
  body         String?
  sitemaps     String[]
  crawlDelayMs Int?
  fetchedAt    DateTime
  expiresAt    DateTime

  @@index([expiresAt])
  @@map("site_crawl_robots")
}

// ══ Помощник: общее (assist_*) — Э1 ══

/// Помощник на сайте. Э1 — только поля знаний; виджет, персона, ключи —
/// Э2 (ТЗ §4.17). Роль assist_public ЧИТАЕТ эту таблицу (опубликованная
/// версия знаний для поиска виджета) — поэтому настроек и секретов
/// «Админки» здесь нет и не будет (У-10 → AssistAdminSettings).
model AssistSite {
  id        String @id @default(cuid())
  accountId String
  siteId    String @unique
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  enabled Boolean @default(false)

  /// Опубликованная версия базы «Сайта» (0 — базы ещё нет). Поиск виджета
  /// и песочницы видит ТОЛЬКО её; публикация — смена этого числа в одной
  /// транзакции со статусом версии (ТЗ §4-тер.2).
  knowledgeVersion Int @default(0)
  /// Персона, запреты, примеры — ключ кэшей вместе с knowledgeVersion.
  configVersion    Int @default(0)
  /// Последний выданный номер версии (выдача — условным UPDATE … RETURNING).
  versionSeq       Int @default(0)

  /// manual | weekly | daily (daily — платные тарифы; до Э4 — по решению владельца)
  recrawlEvery          String    @default("weekly")
  nextCrawlAt           DateTime?
  lastCrawlRunId        String?
  /// Прогон обхода, по которому уже построена версия «Сайта».
  lastIndexedCrawlRunId String?
  /// «Горячие страницы» (≤ 10 URL): условный запрос ежедневно на всех тарифах.
  hotPages              String[]
  hotCheckedAt          DateTime?
  /// Доля бюджета обучения кабинета, базисные пункты; null — поровну (Р-58).
  learningShareBp       Int?
  /// 5 вопросов, на которые помощник теперь отвечает (§3.4) — только из
  /// знаний «Сайта» (У-8); пересчитываются для новой опубликованной версии.
  suggestedQuestions    Json?
  suggestedForVersion   Int?

  // ── Э2: виджет (ТЗ §3-бис, §3.5, §3.6, §4.5, §4.12, §4.13, §6.3) ──
  // Роль assist_public читает ЭТУ таблицу только колоночным GRANT (миграция
  // …_assist_widget): черновики персоны и вида ей не видны.

  /// Публичный ключ сайта `pk_live_…` (виден в HTML заказчика — не секрет,
  /// §4.13). null — виджет ещё не настраивали (ключ выдаёт кабинет).
  publicKey          String?   @unique
  /// `pk_test_…` — только localhost/127.0.0.1 (§4.17), без расхода тарифа нет.
  testKey            String?   @unique
  /// Опубликованная версия вида (assist_site_config_versions kind=widget);
  /// 0 — не опубликован: загрузчик не показывает кнопку.
  widgetVersion      Int       @default(0)
  /// Черновики конфигуратора (§3-бис.4) и персоны (§3.5) — форма в
  /// assist-site-setup/widget-config.ts и persona.ts. Публикация копирует
  /// черновик в новую строку версий и поднимает widgetVersion/configVersion.
  widgetDraft        Json?
  personaDraft       Json?
  /// Поля формы лида, текст согласия, каналы (§3.6 п.6). Э2 — только бот.
  /// Действует сразу (без публикации); роль виджета читает — это и так
  /// видно посетителю в форме.
  leadsConfig        Json?
  /// Рубильник владельца: чат отвечает формой заявки, модель не зовётся (§4.13 п.6).
  chatPaused         Boolean   @default(false)
  /// Рубильник оператора платформы (§8) — ставится только вручную/админкой.
  operatorBlockedAt  DateTime?
  /// `V4CAssist('preview')` разрешён (лендинг-ТЗ §4.3) — ставит ТОЛЬКО
  /// оператор платформы (наш лендинг). Часть «к Л2».
  allowClientPreview Boolean   @default(false)
  /// Суточный денежный потолок ответов сайта; null — умолчание
  /// WIDGET_DEFAULTS (до Э4 тарифов нет).
  dailyCapMicroUsd   Int?
  /// Соль ipHash сайта поверх суточной (§6.4): выгрузка одного сайта не
  /// сопоставима с другим. Генерируется при выдаче ключа.
  ipSalt             String?
  /// Сводка сайта (§4.6 п.3) — СТРОГИЙ JSON (тип бизнеса, разделы, контакты,
  /// часы; короткие строки без императивов), написан моделью по тексту
  /// чужих страниц → в промпт только размеченным блоком данных. Владелец
  /// видит её в TMA. Форма — assist-site-knowledge/wizard/site-summary.ts.
  siteSummary        Json?
  /// knowledgeVersion, по которой построена сводка.
  siteSummaryVersion Int?
  /// Срок хранения диалогов и лидов (§6.3), дни.
  retentionDays      Int       @default(90)
  leadRetentionDays  Int       @default(180)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Цель составного ключа 1:1 с сайтом (Prisma требует уникальности).
  @@unique([siteId, accountId])
  @@index([accountId])
  @@index([nextCrawlAt])
  @@map("assist_sites")
}

/// Расход бюджета обучения (эмбеддинги, eval, черновики) по сайту за месяц.
/// Потолок — на ПОДПИСКУ кабинета (Р-58, ТЗ §4-тер.11): до Э4 подписок нет,
/// потолок кабинета берётся из src/config/assist-defaults.ts (Trial/Start
/// $0.5) и делится между сайтами поровну или по learningShareBp. Учёт денег
/// — по-прежнему в site_ai_usage; здесь — счётчик для атомарной проверки
/// «spent + оценка ≤ доля» одним условным UPDATE.
model AssistLearningSpend {
  accountId     String
  siteId        String
  site          Site     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  /// YYYY-MM (UTC).
  period        String
  spentMicroUsd BigInt   @default(0)
  updatedAt     DateTime @updatedAt

  @@id([siteId, period])
  @@index([accountId, period])
  @@map("assist_learning_spend")
}

/// Суточные счётчики платформы без кабинета: лимиты публичной песочницы
/// (на IP / IPv6 /64, на eTLD+1), её денежный потолок. Атомарно:
/// INSERT … ON CONFLICT DO UPDATE … WHERE value + :n <= :cap RETURNING.
model AssistDailyCounter {
  /// sandbox-ip | sandbox-domain | sandbox-money | sandbox-cabinet | …
  scope     String
  key       String
  /// YYYY-MM-DD (UTC).
  day       String
  value     BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@id([scope, key, day])
  @@index([day])
  @@map("assist_daily_counters")
}

// ══ Песочница (§3.1; лендинг-ТЗ §6) — без подтверждения владения (L0) ══
//
// Своя таблица фрагментов, а не assist_site_* с sandboxId (отступление от
// эскиза §4.17 «знания песочницы — в assist_site_* с sandboxId»): у
// анонимной песочницы нет ни кабинета, ни сайта, а в assist_site_* siteId и
// accountId обязательны и держат изоляцию тенантов (составной FK +
// extension). Режим тот же — «Сайт» (публичный текст), «Админке» сюда пути нет.

model AssistSandbox {
  /// 128 бит случайности (base64url), выдаёт код — неугадываемая ссылка.
  id   String @id
  /// public — анонимно с лендинга; cabinet — онбординг TMA по сайту кабинета.
  kind String

  /// null у анонимной до переноса (`sb_<id>` → кабинет).
  accountId           String?
  siteId              String?
  site                Site?   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdByTelegramId BigInt?
  /// SHA-256 cookie браузера, открывшего публичную песочницу: результат
  /// виден только ему (лендинг-ТЗ §6.2).
  browserKeyHash      String?

  url               String
  host              String
  /// eTLD+1 (tldts) — лимит «≤ 3 новых обхода домена в сутки».
  registrableDomain String
  /// Хеш IPv4 или IPv6 /64 с суточной солью; сырой IP не хранится.
  ipKey             String?

  /// queued | crawling | indexing | ready | failed | blocked | expired
  status       String  @default("queued")
  statusReason String?
  /// Честный прогресс для экрана ожидания: { sitemap, found, titles[] }.
  progress     Json    @default("{}")
  title        String?
  lang         String?
  themeColor   String?

  pagesLimit         Int
  pagesRead          Int       @default(0)
  questionsLimit     Int
  questions          Int       @default(0)
  costMicroUsd       Int       @default(0)
  /// 3–5 автоматически сгенерированных вопросов (из враждебного текста —
  /// показываются как данные, не HTML).
  suggestedQuestions Json?
  /// Только с воркера QA (лендинг-ТЗ §6.4); до него — null.
  screenshotKey      String?
  /// Повторная песочница по домену в течение 24 ч берёт знания этой.
  reusedFromId       String?
  transferredAt      DateTime?

  lockedUntil DateTime?
  attempts    Int       @default(0)
  /// 24 ч анонимно; 7 дней — в кабинете, пока сайт не подтверждён.
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages    AssistSandboxPage[]
  chunks   AssistSandboxChunk[]
  messages AssistSandboxMessage[]

  @@index([registrableDomain, createdAt])
  @@index([ipKey, createdAt])
  @@index([siteId])
  @@index([status, lockedUntil])
  @@index([expiresAt])
  @@map("assist_sandboxes")
}

model AssistSandboxPage {
  id          String        @id @default(cuid())
  sandboxId   String
  sandbox     AssistSandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  url         String
  title       String?
  lang        String?
  text        String
  blocks      Json?
  contentHash String
  fetchedAt   DateTime      @default(now())

  chunks AssistSandboxChunk[]

  @@unique([sandboxId, url])
  @@map("assist_sandbox_pages")
}

model AssistSandboxChunk {
  id               String                      @id @default(cuid())
  sandboxId        String
  sandbox          AssistSandbox               @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  pageId           String
  page             AssistSandboxPage           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  url              String
  title            String?
  headingPath      String?
  lang             String?
  ordinal          Int                         @default(0)
  text             String
  tokens           Int                         @default(0)
  contentHash      String
  ugc              Boolean                     @default(false)
  quarantined      Boolean                     @default(false)
  quarantineReason String?
  embedModel       String?
  embedding        Unsupported("vector(768)")?
  createdAt        DateTime                    @default(now())

  @@index([sandboxId])
  @@map("assist_sandbox_chunks")
}

model AssistSandboxMessage {
  id        String        @id @default(cuid())
  sandboxId String
  sandbox   AssistSandbox @relation(fields: [sandboxId], references: [id], onDelete: Cascade)
  /// visitor | assistant
  role      String
  text      String
  /// [{ n, url, title }] — источники ответа.
  sources   Json?
  createdAt DateTime      @default(now())

  @@index([sandboxId, createdAt])
  @@map("assist_sandbox_messages")
}

// ══ Режим «Сайт» (assist_site_*) — знания для посетителей ══
//
// Слой 1 изоляции (ТЗ §4.3-бис): режим задан ИМЕНЕМ таблицы, общего поля
// «режим» нет. Таблицы «Админки» ниже — тех же форм, но другие таблицы.
// Роль assist_public: SELECT на assist_site_chunks и assist_site_faq (поиск
// виджета), на остальное — ничего.

/// Источник знаний «Сайта»; принадлежит режиму навсегда (сменить нельзя).
model AssistSiteSource {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// crawl (публичный обход, один на сайт) | url | file | faq | manual
  kind   String
  title  String?
  /// url: { urls: string[] }; crawl: { maxPages? }; file: { pages? }.
  config Json    @default("{}")
  /// pending_upload | processing | active | failed | disabled
  status String  @default("active")
  error  String?

  /// Файл: приватный Blob `assist/<accountId>/<siteId>/site/…` (§4.4).
  blobPathname      String?
  fileName          String?
  mimeType          String?
  bytes             Int?
  sha256            String?
  /// «Этот файл увидят все посетители» — подтверждение при загрузке (§3.4).
  publicConfirmedAt DateTime?

  documentsCount      Int       @default(0)
  lastSyncAt          DateTime?
  /// Разбор файла кроном — с lease.
  lockedUntil         DateTime?
  attempts            Int       @default(0)
  createdByTelegramId BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents AssistSiteDocument[]

  @@unique([id, accountId])
  @@index([siteId])
  @@index([status, lockedUntil])
  @@index([accountId])
  @@map("assist_site_sources")
}

/// Документ = единица текста источника (страница, файл или его часть, пункт FAQ).
model AssistSiteDocument {
  id        String           @id @default(cuid())
  accountId String
  siteId    String
  site      Site             @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  sourceId  String
  source    AssistSiteSource @relation(fields: [sourceId, accountId], references: [id, accountId], onDelete: Cascade)

  /// Стабильный ключ в источнике: URL страницы | pathname#часть | faq:<id>.
  ref         String
  /// page | file | faq | manual
  kind        String
  url         String?
  /// Для страниц обхода — site_pages.id (без FK: страницу удаляет обход).
  sitePageId  String?
  title       String?
  lang        String?
  /// Хеш последнего прочитанного текста.
  contentHash String?
  /// Хеш текста, по которому построены текущие фрагменты.
  indexedHash String?
  /// active | gone | excluded | failed | skipped
  status      String    @default("active")
  skipReason  String?
  /// «Горячая страница» (≤ 10 на сайт, §4-тер.2).
  hot         Boolean   @default(false)
  goneAt      DateTime?
  indexedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks AssistSiteChunk[]

  @@unique([sourceId, ref])
  @@unique([id, accountId])
  @@index([siteId, status])
  @@index([accountId])
  @@map("assist_site_documents")
}

/// Фрагмент знаний «Сайта». Версии базы — членством `versions` (номера
/// версий, в которые входит фрагмент): неизменённый фрагмент переходит в
/// новую версию без копии и без нового эмбеддинга; публикация — смена
/// AssistSite.knowledgeVersion. Поиск — сырым SQL через репозиторий с
/// обязательным siteId (§4.4): HNSW (частичный, `WHERE embedding IS NOT NULL`)
/// и полнотекстовый индекс — в миграции, Prisma их не описывает (см.
/// заголовок миграции …_assist_knowledge).
model AssistSiteChunk {
  id         String             @id @default(cuid())
  accountId  String
  siteId     String
  site       Site               @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  documentId String
  document   AssistSiteDocument @relation(fields: [documentId, accountId], references: [id, accountId], onDelete: Cascade)

  /// page | file | faq | manual — FAQ получает бонус в ранжировании.
  sourceType                    String
  url                           String?
  title                         String?
  /// «Доставка › По Украине».
  headingPath                   String?
  lang                          String?
  ordinal                       Int                         @default(0)
  text                          String
  tokens                        Int                         @default(0)
  /// SHA-256 нормализованного текста фрагмента.
  contentHash                   String
  /// SHA-256 текста с замаскированными цифрами: «изменились только числа» —
  /// вектор не пересчитывается (§4-тер.2).
  digitsMaskedHash              String
  /// Номера версий базы, в которые входит фрагмент.
  versions                      Int[]                       @default([])
  /// Отзывы/комментарии посетителей сайта: пониженный вес, не факт (§6.5).
  ugc                           Boolean                     @default(false)
  /// Признаки инъекции — в поиск не идёт, ждёт решения владельца (§4-тер.7).
  quarantined                   Boolean                     @default(false)
  quarantineReason              String?
  quarantineAllowedAt           DateTime?
  quarantineAllowedByTelegramId BigInt?
  /// Модель и размерность — в каждой строке: смена модели = переиндекс.
  embedModel                    String?
  embedding                     Unsupported("vector(768)")?
  embeddedAt                    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([documentId])
  @@index([siteId, contentHash])
  @@index([accountId])
  @@index([text(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("assist_site_chunks")
}

/// Версия базы «Сайта» (§4-тер.2): building → checking → published | held | discarded.
model AssistSiteKnowledgeVersion {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  number                Int
  /// crawl | document | faq | exclusion | quarantine | rollback | manual
  trigger               String
  /// building | checking | published | held | discarded
  status                String    @default("building")
  parentNumber          Int?
  /// «+12 страниц, −3, ~41; фрагментов 2 140; языки uk 92%, ru 8%».
  stats                 Json      @default("{}")
  /// Отчёт ворот аномалий: [{ check, value, threshold, held }].
  gateReport            Json?
  heldReason            String?
  evalRunId             String?
  crawlRunId            String?
  createdByTelegramId   BigInt?
  publishedByTelegramId BigInt?
  checkedAt             DateTime?
  publishedAt           DateTime?
  discardedAt           DateTime?
  /// Уведомление владельцу об удержании отправлено.
  notifiedAt            DateTime?

  createdAt DateTime @default(now())

  @@unique([siteId, number])
  @@index([siteId, status])
  @@index([accountId])
  @@map("assist_site_knowledge_versions")
}

/// FAQ = «проверенный ответ» (§4-тер.4). Публикует только человек с правом.
model AssistSiteFaq {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  question             String
  answer               String
  variants             String[]
  lang                 String?
  /// owner | wizard | gap | operator_candidate | copied
  origin               String    @default("owner")
  sourceRefs           Json?
  /// active | needs_review | archived
  status               String    @default("active")
  approvedByTelegramId BigInt?
  approvedAt           DateTime?
  reviewAt             DateTime?
  conflictNote         String?
  fromConversationId   String?
  /// Документ знаний, в который проиндексирован ответ.
  documentId           String?
  createdByTelegramId  BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, status])
  @@index([accountId])
  @@map("assist_site_faq")
}

/// «Этого не знать» (§4-тер.12): удаление из ВСЕХ версий сразу; откат не
/// возвращает, переобход не берёт.
model AssistSiteExclusion {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// url | urlPrefix | chunkHash | document
  kind                String
  value               String
  reason              String?
  createdByTelegramId BigInt
  appliedAt           DateTime?
  chunksDeleted       Int       @default(0)

  createdAt DateTime @default(now())

  @@unique([siteId, kind, value])
  @@index([accountId])
  @@map("assist_site_exclusions")
}

/// Eval-кейс сайта (У-6: только «Сайт»; набор платформы — в коде).
model AssistSiteEvalCase {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// source (по фрагменту) | golden (из проверенного ответа) | manual
  kind            String
  question        String
  expected        String?
  mustCite        String[]
  mustNotSay      String[]
  lang            String?
  /// Кейс по фрагменту: изменился фрагмент → stale, а не провал (§4-тер.2).
  sourceChunkHash String?
  /// active | stale | archived
  status          String   @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, status])
  @@index([accountId])
  @@map("assist_site_eval_cases")
}

model AssistSiteEvalRun {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// gate (инвариантный поднабор) | scheduled | manual
  kind             String
  knowledgeVersion Int?
  model            String
  passed           Int    @default(0)
  failed           Int    @default(0)
  stale            Int    @default(0)
  report           Json   @default("{}")
  costMicroUsd     Int    @default(0)

  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
  @@index([accountId])
  @@map("assist_site_eval_runs")
}

// ══ Режим «Админка» (assist_admin_*) — роли assist_public НЕДОСТУПНЫ ══
//
// Формы — как у «Сайта» (общий код assist-knowledge-core работает по
// таблицам, имена которых ему передаёт модуль режима), таблицы — свои.

/// Настройки «Админки» (У-10): всё, чего не должна видеть роль assist_public.
/// Э1 — знания; режим, хосты, секрет подписи, инструкции — Э7.
model AssistAdminSettings {
  siteId    String @id
  accountId String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// «Сотрудникам тоже знать публичный сайт» — копия публичного обхода (Р-19).
  includePublicInAdmin Boolean @default(true)
  /// Отзывы/комментарии (ugc) в копию — по умолчанию нет (§3.4).
  includeUgcInAdmin    Boolean @default(false)

  /// Те же имена колонок, что у AssistSite: общий код версий работает по ним.
  knowledgeVersion      Int     @default(0)
  configVersion         Int     @default(0)
  versionSeq            Int     @default(0)
  lastIndexedCrawlRunId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, accountId])
  @@index([accountId])
  @@map("assist_admin_settings")
}

model AssistAdminSource {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// public_copy (копия публичного обхода) | url | file | faq | manual
  /// (crawl_private — Э7)
  kind   String
  title  String?
  config Json    @default("{}")
  status String  @default("active")
  error  String?

  /// Приватный Blob `assist/<accountId>/<siteId>/admin/…`.
  blobPathname String?
  fileName     String?
  mimeType     String?
  bytes        Int?
  sha256       String?

  documentsCount      Int       @default(0)
  lastSyncAt          DateTime?
  lockedUntil         DateTime?
  attempts            Int       @default(0)
  createdByTelegramId BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents AssistAdminDocument[]

  @@unique([id, accountId])
  @@index([siteId])
  @@index([status, lockedUntil])
  @@index([accountId])
  @@map("assist_admin_sources")
}

model AssistAdminDocument {
  id        String            @id @default(cuid())
  accountId String
  siteId    String
  site      Site              @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  sourceId  String
  source    AssistAdminSource @relation(fields: [sourceId, accountId], references: [id, accountId], onDelete: Cascade)

  ref         String
  kind        String
  url         String?
  sitePageId  String?
  title       String?
  lang        String?
  contentHash String?
  indexedHash String?
  status      String    @default("active")
  skipReason  String?
  hot         Boolean   @default(false)
  goneAt      DateTime?
  indexedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks AssistAdminChunk[]

  @@unique([sourceId, ref])
  @@unique([id, accountId])
  @@index([siteId, status])
  @@index([accountId])
  @@map("assist_admin_documents")
}

model AssistAdminChunk {
  id         String              @id @default(cuid())
  accountId  String
  siteId     String
  site       Site                @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  documentId String
  document   AssistAdminDocument @relation(fields: [documentId, accountId], references: [id, accountId], onDelete: Cascade)

  sourceType                    String
  url                           String?
  title                         String?
  headingPath                   String?
  lang                          String?
  ordinal                       Int                         @default(0)
  text                          String
  tokens                        Int                         @default(0)
  contentHash                   String
  digitsMaskedHash              String
  versions                      Int[]                       @default([])
  ugc                           Boolean                     @default(false)
  quarantined                   Boolean                     @default(false)
  quarantineReason              String?
  quarantineAllowedAt           DateTime?
  quarantineAllowedByTelegramId BigInt?
  embedModel                    String?
  embedding                     Unsupported("vector(768)")?
  embeddedAt                    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([documentId])
  @@index([siteId, contentHash])
  @@index([accountId])
  @@index([text(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("assist_admin_chunks")
}

model AssistAdminKnowledgeVersion {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  number                Int
  trigger               String
  status                String    @default("building")
  parentNumber          Int?
  stats                 Json      @default("{}")
  gateReport            Json?
  heldReason            String?
  evalRunId             String?
  crawlRunId            String?
  createdByTelegramId   BigInt?
  publishedByTelegramId BigInt?
  checkedAt             DateTime?
  publishedAt           DateTime?
  discardedAt           DateTime?
  notifiedAt            DateTime?

  createdAt DateTime @default(now())

  @@unique([siteId, number])
  @@index([siteId, status])
  @@index([accountId])
  @@map("assist_admin_knowledge_versions")
}

model AssistAdminFaq {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  question             String
  answer               String
  variants             String[]
  lang                 String?
  origin               String    @default("owner")
  sourceRefs           Json?
  status               String    @default("active")
  approvedByTelegramId BigInt?
  approvedAt           DateTime?
  reviewAt             DateTime?
  conflictNote         String?
  fromConversationId   String?
  documentId           String?
  createdByTelegramId  BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, status])
  @@index([accountId])
  @@map("assist_admin_faq")
}

model AssistAdminExclusion {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  kind                String
  value               String
  reason              String?
  createdByTelegramId BigInt
  appliedAt           DateTime?
  chunksDeleted       Int       @default(0)

  createdAt DateTime @default(now())

  @@unique([siteId, kind, value])
  @@index([accountId])
  @@map("assist_admin_exclusions")
}

// ══ Э2: виджет режима «Сайт» (ТЗ §3-бис, §4-бис, §4.5, §4.12–§4.13, §6.3) ══
//
// Публичные маршруты /widget/v1/* работают под ролью assist_public
// (AssistPublicDb); GRANT-ы — миграция …_assist_widget, белый список —
// src/prisma/assist-public-role.spec.ts. Всё здесь — режим «Сайт»: у
// «Админки» (Э7) будут свои таблицы assist_admin_*, общих нет (К-9).

/// Опубликованные версии вида виджета и персоны (§3-бис.4, §3.5): история
/// — строками, откат = новая версия с содержимым старой (как у знаний).
/// Последние 20 каждого вида хранятся, старше — удаляет ретенция.
model AssistSiteConfigVersion {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// widget | persona
  kind                  String
  version               Int
  /// Проверенная конфигурация (widget-config.ts / persona.ts, assist-site-setup).
  config                Json
  /// persona: отчёт прогона поднабора eval (§4-тер.8) перед публикацией.
  gateReport            Json?
  /// Откат — с какой версии скопировано.
  rolledBackFrom        Int?
  publishedByTelegramId BigInt?

  createdAt DateTime @default(now())

  @@unique([siteId, kind, version])
  @@index([accountId])
  @@map("assist_site_config_versions")
}

/// Указатель посетителя `resumeKey` (§4-бис.3, Р-27): в базе — SHA-256,
/// сам ключ — в localStorage iframe и CHIPS-cookie. Привязан к сайту и
/// origin родителя; 30 дней скользящий. Пишет публичный маршрут.
model AssistSiteVisitorResume {
  keyHash      String   @id
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  visitorId    String
  /// `https://shop.example.com` — origin родителя при выдаче.
  parentOrigin String
  lastSeenAt   DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([siteId, visitorId])
  @@index([expiresAt])
  @@map("assist_site_visitor_resumes")
}

/// Диалог посетителя (§4.17, §4-бис.9). Источник истины истории — сервер
/// (§4.13 п.4: история от клиента не принимается).
model AssistSiteConversation {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  visitorId     String
  /// Хеш IP: суточная соль + соль сайта (§6.3, §6.4).
  ipHash        String
  parentOrigin  String
  /// Страница, где начат диалог (без query — §6.6).
  pageUrl       String?
  locale        String?
  /// Засчитан в квоту диалогов периода (первый ответ модели, §4.5 п.3).
  dialogCounted Boolean  @default(false)
  /// Ответов модели в диалоге: > 30 — диалог за 2, > 60 — за 3 (§7.1).
  answers       Int      @default(0)
  /// §4.13 п.5: ответы только из FAQ/кэша, без генерации.
  suspicious    Boolean  @default(false)
  /// Флаги ревью (unsupported_number и т.п. в любом ответе диалога).
  flagged       Boolean  @default(false)
  /// lead | handoff | resolved | … — итог для аналитики (Э3).
  outcome       String?
  /// Э3: передача человеку. Э2 — handoff превращается в форму лида.
  handoffState  String?
  /// §4-бис.5: идущий сценарий/план (Э3/Э6-бис); Э2 — всегда null.
  activePlanId  String?
  /// Растёт с каждым изменением диалога — `GET /widget/v1/state?since=`.
  stateVersion  Int      @default(0)
  lastMessageAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AssistSiteMessage[]
  leads    AssistSiteLead[]

  @@unique([id, accountId])
  @@index([siteId, visitorId, lastMessageAt])
  @@index([siteId, createdAt])
  @@index([lastMessageAt])
  @@index([accountId])
  @@map("assist_site_conversations")
}

/// Сообщение диалога. Текст — МАСКИРОВАННЫЙ (вопрос и ответ, §4.7, приёмка
/// Э2 п.6): сырой вопрос живёт только в памяти запроса.
model AssistSiteMessage {
  id             String                 @id @default(cuid())
  accountId      String
  siteId         String
  site           Site                   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  conversationId String
  conversation   AssistSiteConversation @relation(fields: [conversationId, accountId], references: [id, accountId], onDelete: Cascade)

  /// visitor | assistant | operator | system
  role            String
  text            String
  /// [{ n, url, title }] — проверенные источники ответа (§4.6).
  sources         Json?
  /// Проверенные действия (§4.9): link | lead | handoff.
  actions         Json?
  /// unsupported_number | forbidden_promise | injection_suspect | …
  flags           String[]
  /// §4-бис.4: идемпотентность вопроса — уникальна В ПАРЕ с диалогом.
  clientRequestId String?
  /// streaming | complete | partial | refused
  streamState     String   @default("complete")
  /// Сколько символов text уже сброшено генерирующим экземпляром.
  streamOffset    Int      @default(0)
  /// none | faq | cache | model | template — каким путём получен ответ.
  answerPath      String?
  /// Ключ семантического кэша, из которого/в который ответ (👎 удаляет запись).
  cacheKey        String?
  /// 👍 = 1, 👎 = -1 (§4.17, §4-тер.7).
  rating          Int?
  inTokens        Int      @default(0)
  outTokens       Int      @default(0)
  cachedTokens    Int      @default(0)
  costMicroUsd    Int      @default(0)
  model           String?
  latencyMs       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, clientRequestId])
  @@index([conversationId, createdAt])
  @@index([siteId, createdAt])
  @@index([accountId])
  @@map("assist_site_messages")
}

/// Лид из формы виджета (§3.6 п.6, К-3: только явной отправкой формы).
/// Таблица assist_site_* (а не assist_leads эскиза §4.17): лиды есть только
/// у «Сайта», и схема имён §4.3-бис держит тест роли и граф.
model AssistSiteLead {
  id             String                  @id @default(cuid())
  accountId      String
  siteId         String
  site           Site                    @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  /// Удалили диалог (`/widget/v1/forget`, ретенция) — лид остаётся без ссылки.
  conversationId String?
  conversation   AssistSiteConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  visitorId      String?

  /// Поля формы — шифр ASSIST_SECRETS_KEY (AES-256-GCM), в открытом виде нет.
  fieldsEnc     String
  /// Какие поля заполнены (имена, без значений) — для экрана и метрик.
  fieldNames    String[]
  /// Текст согласия ровно в той редакции, что видел посетитель, и время.
  consentText   String
  consentAt     DateTime
  pageUrl       String?
  /// pending | delivered | failed
  deliveryState String    @default("pending")
  /// [{ channel: 'telegram', chatId, at }]
  deliveredTo   Json?
  attempts      Int       @default(0)
  lockedUntil   DateTime?
  lastError     String?
  deliveredAt   DateTime?

  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
  @@index([deliveryState, lockedUntil])
  @@index([conversationId])
  @@index([accountId])
  @@map("assist_site_leads")
}

/// Деньги дня (§4.5): scope `site` (key = siteId) и `platform` (key = `all`).
/// Резерв — условным UPDATE ЭТОЙ строки (блокировка строки сериализует
/// параллельные резервы): `spent + reserved + :est <= cap`. Строки дня может
/// не быть — сначала INSERT … ON CONFLICT DO NOTHING (§4.5 уточнение 1).
model AssistBudgetDay {
  scope            String
  key              String
  /// YYYY-MM-DD (UTC).
  day              String
  spentMicroUsd    BigInt   @default(0)
  reservedMicroUsd BigInt   @default(0)
  updatedAt        DateTime @updatedAt

  @@id([scope, key, day])
  @@index([day])
  @@map("assist_budget_days")
}

/// Резерв одного ответа с TTL (§4.5 уточнение 2): функцию убил maxDuration
/// — резерв не вечный; просроченные снимает `assist-budget-sweep`
/// (вычитает из reservedMicroUsd ровно один раз — DELETE … RETURNING).
model AssistBudgetReservation {
  id          String   @id
  siteId      String
  day         String
  estMicroUsd BigInt
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
  @@index([siteId, day])
  @@map("assist_budget_reservations")
}

/// Атомарный счётчик диалогов периода (§4.5 уточнение 3):
/// `dialogs + :w <= quota` одним условным UPDATE.
model AssistSitePeriodUsage {
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// YYYY-MM (UTC; Э4 — период подписки).
  period    String
  dialogs   Int      @default(0)
  quota     Int
  updatedAt DateTime @updatedAt

  @@id([siteId, period])
  @@map("assist_site_period_usage")
}

/// Семантический кэш ответов (§4.5, §4-тер.7): ключ — semanticCacheKey
/// (siteId + режим + knowledgeVersion + configVersion + нормализованный
/// вопрос). Смена версии = другой ключ; 👎 удаляет запись.
model AssistSiteSemanticCache {
  id               String   @id @default(cuid())
  siteId           String
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  key              String
  /// { text, sources, actions, lang } — уже проверенный ответ.
  answer           Json
  knowledgeVersion Int
  configVersion    Int
  hits             Int      @default(0)
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@unique([siteId, key])
  @@index([expiresAt])
  @@map("assist_site_semantic_cache")
}

/// Ограничения частоты в Postgres (§4.13 п.2–3): окно — строкой `bucket`
/// (`2026-10-01T12:34` для минуты и т.п.), счётчик — условным UPSERT.
model AssistRateBucket {
  /// widget-session-ip | widget-msg-visitor-min | widget-msg-visitor-hour | widget-msg-ip-site-min | …
  scope     String
  key       String
  bucket    String
  count     Int      @default(0)
  expiresAt DateTime

  @@id([scope, key, bucket])
  @@index([expiresAt])
  @@map("assist_rate_buckets")
}

/// Одноразовые токены предпросмотра (§3-бис.4, аудит 01.10): `?v4c_preview=`
/// на сайте и конфигуратор TMA. В базе — SHA-256; обмен на сессию
/// предпросмотра — один раз; привязан к сайту и origin.
model AssistSitePreviewToken {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  tokenHash           String    @unique
  /// site — ссылка «посмотреть на сайте»; tma — конфигуратор в кабинете.
  purpose             String
  /// purpose=site: origin verified-хоста, где токен можно обменять.
  origin              String?
  /// Черновик вида на момент выдачи (или null — брать текущий черновик).
  draft               Json?
  createdByTelegramId BigInt
  expiresAt           DateTime
  usedAt              DateTime?
  /// SHA-256 сессии предпросмотра (sessionStorage iframe) после обмена.
  sessionHash         String?   @unique
  sessionExpiresAt    DateTime?

  createdAt DateTime @default(now())

  @@index([siteId])
  @@index([expiresAt])
  @@index([accountId])
  @@map("assist_site_preview_tokens")
}

/// Пинги загрузчика (§3-бис.2 «Проверить установку», §4.12): виджет
/// загрузился на этом origin. Нет пинга при найденном теге — «вероятно, CSP».
model AssistSiteInstallPing {
  siteId        String
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  origin        String
  /// Origin подтверждён и виджет на нём включён в момент пинга.
  allowed       Boolean
  loaderVersion String?
  /// Загрузчик получил конфиг fetch'ем (false — вероятно, CSP connect-src
  /// сайта без нашего origin: кнопка в виде по умолчанию, проверка установки
  /// подсказывает директиву).
  configFetchOk Boolean?
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  count         Int      @default(1)

  @@id([siteId, origin])
  @@map("assist_site_install_pings")
}

/// Мастер «Научите помощника» (§4-тер.9): 10 тем с черновиками по сайту,
/// ответы владельца → проверенные ответы origin = wizard.
model AssistSiteWizard {
  siteId    String @id
  accountId String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// shop | services | saas — набор вопросов.
  businessType  String
  /// [{ topic, question, draft, draftSources, answer, status, faqId }] —
  /// форма в assist-site-knowledge/wizard/wizard-types.ts.
  items         Json      @default("[]")
  /// in_progress | done
  status        String    @default("in_progress")
  /// Прогонов черновиков (платформа платит ≤ 1 + 3 повтора, §4-тер.11).
  draftRuns     Int       @default(0)
  spentMicroUsd Int       @default(0)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([siteId, accountId])
  @@index([accountId])
  @@map("assist_site_wizards")
}

/// Логотип/аватар виджета (§3-бис.1): ТОЛЬКО растр PNG/JPEG/WebP ≤ 200 КБ
/// (SVG в Э2 отвергается — растеризатора в sites-backend нет, вопрос О-6).
/// Отдаётся `GET /widget/v1/asset/:id` с нашего origin (img-src 'self'),
/// `nosniff`, immutable — в DOM вставляется только как <img src>.
model AssistSiteAsset {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// logo | avatar
  kind   String
  /// image/png | image/jpeg | image/webp — по сигнатуре байтов, не по заголовку.
  mime   String
  sha256 String
  bytes  Bytes
  width  Int
  height Int

  createdAt DateTime @default(now())

  @@index([siteId])
  @@index([accountId])
  @@map("assist_site_assets")
}

// ── Поддержка лендинга (лендинг-ТЗ §5.3, §7.3, §10.1; план «Поддержка лендинга» Э2) ──

/// Анонимный черновик вида из конфигуратора лендинга (≤ 2 КБ, без логотипа,
/// 7 дней) → payload `wd_<id>`. Часть «к Л3»: таблица — сейчас, маршрут и
/// читатель — к Л3.
model AssistWidgetDraft {
  /// 128 бит случайности (base64url) — неугадываемый id в `startapp`.
  id              String    @id
  config          Json
  /// Хеш IP с суточной солью — лимит 10 черновиков в сутки.
  ipKey           String
  appliedToSiteId String?
  appliedAt       DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  @@index([expiresAt])
  @@map("assist_widget_drafts")
}

/// Атрибуция кабинета (лендинг-ТЗ §7.3): payload `lp_|wd_|pl_|sb_` и utm
/// первого входа. Продуктовая запись — не поле ядра `site_accounts` (Д-8).
model AssistAcquisition {
  id          String      @id @default(cuid())
  accountId   String
  account     SiteAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Сырой payload startapp (`lp_spring`, `pl_start`…).
  payload     String
  /// lp | wd | pl | sb
  source      String
  campaign    String?
  landingPath String?
  utm         Json?
  createdAt   DateTime    @default(now())

  @@index([accountId])
  @@map("assist_acquisitions")
}

/// Первичные события лендинга (лендинг-ТЗ §10.1): без идентификатора на
/// устройстве; ipHash — суточный. Ретенция 90 дней.
model AssistLandingEvent {
  id        String   @id @default(cuid())
  name      String
  props     Json?
  locale    String?
  variant   String?
  path      String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
  @@map("assist_landing_events")
}
