  embedModel                    String?
  embedding                     Unsupported("vector(768)")?
  embeddedAt                    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([documentId])
  @@index([siteId, contentHash])
  @@index([accountId])
  @@index([text(ops: raw("gin_trgm_ops"))], type: Gin)
