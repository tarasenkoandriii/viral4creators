// ══ Э7 «Админка»: чтение (ТЗ §5, §4-бис.8, §4-тер.6, §4.12, §5-тер.13) ══════
//
// Всё — assist_admin_*: роль assist_public прав не имеет НИ НА ОДНУ таблицу
// (тест роли берёт список из этой схемы автоматически, §4.3-бис п.4).
// Результаты инструментов (данные API заказчика) не хранятся нигде, кроме
// ответа сотруднику: ни в сообщениях, ни в журнале (там — только маскированный
// запрос и размер ответа), ни в знаниях (§5.4, §4-тер.6).

/// Коннектор API заказчика по OpenAPI 3.x (§3.8 п.3, §5.3, §5.5). Секрет —
/// шифротекст `as1.<версия>.…` (ASSIST_SECRETS_KEY, AAD — кабинет/сайт/
/// коннектор/назначение/версия, §5.6); наружу — только «••••1a2b».
model AssistAdminConnector {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  name                String
  /// https-origin + базовый путь из `servers[0]` (или указанный владельцем).
  baseUrl             String
  /// Хосты, куда разрешено ходить (§5.5): каждый — verified-хост сайта
  /// (`hostId`) или SaaS-аккаунт заказчика с отметкой владельца.
  allowedHosts        String[]  @default([])
  hostId              String?
  saasAcknowledged    Boolean   @default(false)
  specUrl             String?
  specHash            String
  specTitle           String?
  specVersion         String?
  /// none | bearer | basic | header (§5.5; query-ключи запрещены — URL
  /// попадает в журналы прокси).
  authKind            String    @default("none")
  authHeaderName      String?
  secretEnc           String?
  secretKeyVersion    String?
  secretLast4         String?
  secretSetAt         DateTime?
  /// active | paused | auth_failed (401/403 — все операции на паузу, §5.7)
  status              String    @default("active")
  lastCallAt          DateTime?
  createdByTelegramId BigInt?
  /// Э8: секрет подписи изменяющих запросов `X-V4C-Signature` (§5.5) —
  /// шифротекст ASSIST_SECRETS_KEY (AAD — коннектор, назначение); открытый
  /// текст показывается владельцу ОДИН раз при выпуске.
  signSecretEnc       String?
  signKeyVersion      String?
  signSetAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operations AssistAdminOperation[]

  @@unique([id, accountId])
  @@index([siteId])
  @@index([accountId])
  @@map("assist_admin_connectors")
}

/// Операция коннектора (§5.2): класс — автоклассификация при импорте; поднять
/// владелец может (read → write), опустить write/danger — нет. `read`
/// исполняется сразу (Э7), write/danger — только предложением и «Да» (Э8).
model AssistAdminOperation {
  id          String               @id @default(cuid())
  accountId   String
  siteId      String
  site        Site                 @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  connectorId String
  connector   AssistAdminConnector @relation(fields: [connectorId, accountId], references: [id, accountId], onDelete: Cascade)

  /// operationId из спецификации (или `<method>_<путь>`), уникален в коннекторе.
  operationId String
  method      String
  path        String
  summary     String?
  /// read | write | danger — итог автоклассификации и действующий класс.
  autoKind    String
  kind        String
  kindReason  String?
  enabled     Boolean  @default(false)
  /// Роли помощника, которым операция доступна (roleMap значения).
  roles       String[] @default([])
  dailyLimit  Int?
  /// Параметры (path/query) как JSON-схема для проверки вызова модели.
  params      Json     @default("[]")
  /// Обязательный параметр в заголовке/cookie — модель его не подставит,
  /// операцию включить нельзя.
  unsupported Boolean  @default(false)

  // ── Э8: действия (§5.4–5.5, §5-бис.15 п.14) ──
  /// `x-assist-idempotent: true` (или отметка владельца): повтор после
  /// `unknown` с тем же Idempotency-Key дубля не создаёт.
  idempotent      Boolean @default(false)
  /// Компенсирующая операция (`x-assist-compensation` или владелец):
  /// { operationId, params: { имя: "$.request.<путь>" | "$.preview.<путь>" } }.
  /// Проверена при сохранении: операция есть, класс не ниже, всё отображено.
  compensation    Json?
  /// Предпросмотр «было» (`x-assist-preview` или владелец): read-операция
  /// { operationId, params: { имя: "$.request.<путь>" } }.
  preview         Json?
  /// Сухой прогон `native`: булев параметр операции (`dryRun`/`validateOnly`).
  dryRunParam     String?
  /// Денежный потолок: числовой параметр суммы, максимум за действие и сумма
  /// за UTC-сутки по операции. Найден автоматически — снять нельзя.
  amountParam     String?
  autoAmountParam String?
  maxAmount       Float?
  dailyAmountCap  Float?
  /// Слово подтверждения danger («СКАСУВАТИ»); к нему код добавляет число строк.
  confirmWord     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectorId, operationId])
  @@index([siteId])
  @@index([accountId])
  @@map("assist_admin_operations")
}

/// Журнал вызовов инструментов «Админки» (§3.8 п.6, §5.7): только
/// дописывается (UPDATE/DELETE отвергает триггер, кроме чистки по сроку),
/// цепочка `prevHash → hash` в пределах сайта. Без FK на сайт: журнал
/// переживает удаление коннектора (хранится год, В-5). Секретов нет никогда:
/// запрос маскируется до записи, тело ответа не пишется — только размер.
model AssistAdminActionLog {
  id        String   @id @default(cuid())
  accountId String
  siteId    String
  at        DateTime @default(now())

  /// `jwt:<sub>` (встраивание) | `tg:<telegramId>` (TMA).
  actor          String
  actorRole      String?
  channel        String
  conversationId String?
  connectorId    String?
  operationRowId String?
  /// `<имя коннектора>.<operationId>` — читаемо и после удаления коннектора.
  operation      String
  kind           String  @default("read")
  /// ok | http_error | timeout | blocked | denied | invalid_params | bad_response | auth_failed | limit
  outcome        String
  httpStatus     Int?
  durationMs     Int?
  /// { method, path, query: {имя: значение|«•••»} } — без заголовков авторизации.
  requestMasked  Json
  responseBytes  Int?
  /// Код ошибки (без тела ответа API и без текста провайдера).
  error          String?
  idempotencyKey String  @unique
  prevHash       String?
  hash           String

  @@index([siteId, at])
  @@index([accountId])
  @@map("assist_admin_action_log")
}

/// Диалог сотрудника (§4.3-бис У-4; §4-бис.8): отдельная таблица от диалогов
/// посетителей. Встраивание — по `sub` JWT (последний диалог ≤ 8 ч), TMA — по
/// telegramId участника кабинета.
model AssistAdminConversation {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// `jwt:<sub>` | `tg:<telegramId>`
  employeeRef    String
  /// embed | tma
  channel        String
  employeeRole   String?
  employeeName   String?
  stateVersion   Int      @default(0)
  lastActivityAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages      AssistAdminMessage[]
  learningItems AssistAdminLearningItem[]
  proposals     AssistAdminActionProposal[]
  uiPlans       AssistAdminUiPlan[]

  @@unique([id, accountId])
  @@index([siteId, employeeRef, lastActivityAt])
  @@index([accountId])
  @@map("assist_admin_conversations")
}

model AssistAdminMessage {
  id             String                  @id @default(cuid())
  accountId      String
  siteId         String
  site           Site                    @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  conversationId String
  conversation   AssistAdminConversation @relation(fields: [conversationId, accountId], references: [id, accountId], onDelete: Cascade)

  /// employee | assistant
  role            String
  text            String
  /// [{ n, url, title }] — источники ответа из знаний «Админки».
  sources         Json?
  /// [{ operation, outcome, httpStatus }] — какие read-вызовы были (без данных).
  tools           Json?
  flags           String[]
  clientRequestId String?
  /// knowledge | tool | refused | error
  answerPath      String?
  /// 👍 = 1, 👎 = -1
  rating          Int?
  model           String?
  inTokens        Int      @default(0)
  outTokens       Int      @default(0)
  costMicroUsd    Int      @default(0)
  /// Э8: карточка подтверждения при этом ответе (предложение write/danger).
  proposalId      String?

  createdAt DateTime @default(now())

  @@unique([conversationId, clientRequestId])
  @@index([conversationId, createdAt])
  @@index([siteId, createdAt])
  @@index([accountId])
  @@map("assist_admin_messages")
}

/// Сессия сотрудника после обмена employee-JWT (§5.1, §4-бис.8): в базе —
/// только SHA-256 токена; живёт не дольше `exp` JWT (≤ 15 мин).
model AssistAdminSession {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  tokenHash String   @unique
  sub       String
  role      String?
  name      String?
  jwtIat    DateTime
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([siteId, sub])
  @@index([expiresAt])
  @@index([accountId])
  @@map("assist_admin_sessions")
}

/// Очередь обучения «Админки» (§4-тер.6, контур (г)): 👎 и «правильно так: …»
/// сотрудников, отказы «не знаю», ошибки параметров и сбои инструментов.
/// Кандидат — не знание: в базу (assist_admin_faq, origin = golden) его
/// переносит только `assistAdmin: owner`; в «Сайт» — никогда (Р-34).
model AssistAdminLearningItem {
  id             String                   @id @default(cuid())
  accountId      String
  siteId         String
  site           Site                     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  conversationId String?
  conversation   AssistAdminConversation? @relation(fields: [conversationId, accountId], references: [id, accountId], onDelete: Cascade)
  messageId      String?

  /// thumbs_down | employee_fix | refused | tool_param_error | tool_failure
  kind                 String
  employeeRef          String?
  questionMasked       String
  answerMasked         String?
  proposedAnswer       String?
  /// Нормализованный вопрос — кластер «одинаковых» вопросов сотрудников.
  clusterKey           String
  /// new | accepted | rejected
  status               String    @default("new")
  faqId                String?
  resolvedByTelegramId BigInt?
  resolvedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, kind])
  @@index([siteId, status])
  @@index([siteId, clusterKey])
  @@index([accountId])
  @@map("assist_admin_learning_items")
}

/// Задание обхода админки за логином (§5.3; opt-in). Исполняет только
/// изолированный браузерный воркер (Ш3) с арендой тестовой учётки Ш2; до
/// воркера задание ждёт (`waiting_worker`) — браузер на сервере Vercel не
/// запускается никогда.
model AssistAdminCrawlJob {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  hostId                String
  testAccountId         String
  startPath             String  @default("/")
  /// waiting_worker | cancelled | running | done | failed
  status                String  @default("waiting_worker")
  requestedByTelegramId BigInt
  note                  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, status])
  @@index([accountId])
  @@map("assist_admin_crawl_jobs")
}

/// Страницы закрытой зоны админки (§4.3-бис У-9): НЕ общий site_pages —
/// их пишет только результат обхода за логином (Ш3).
model AssistAdminPage {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  crawlJobId  String?
  url         String
  title       String?
  text        String
  contentHash String
  fetchedAt   DateTime @default(now())

  @@unique([siteId, url])
  @@index([accountId])
  @@map("assist_admin_pages")
}

// ══ Э8 «Админка»: действия (ТЗ §5.4–5.7, §4-бис.5, §5-бис.15 п.14,
// §5-бис.17 п.10; план «Этап 8») — роли assist_public НЕДОСТУПНЫ ══

/// Предложение изменяющего действия (§5.4 п.5–7): модель только ПРЕДЛАГАЕТ,
/// исполняет отдельный запрос «Да» того же сотрудника (`actor`) после
/// повторной проверки роли, срока, `paramsHash`, лимитов. Переход
/// `pending → executing` — условным UPDATE (повторное «Да» после перезагрузки
/// исполнения не даёт, §4-бис.5). `Idempotency-Key` = id. Параметры и снимок
/// «было» — значения сотрудника (не модели): стираются ретенцией после окна
/// компенсации; журнал хранит только маску.
model AssistAdminActionProposal {
  id             String                   @id @default(cuid())
  accountId      String
  siteId         String
  site           Site                     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  conversationId String?
  conversation   AssistAdminConversation? @relation(fields: [conversationId, accountId], references: [id, accountId], onDelete: Cascade)

  /// embed | tma
  channel        String
  /// `jwt:<sub>` | `tg:<telegramId>` — «Да» принимается только от него.
  actor          String
  /// `X-V4C-Actor` (sub или tg:<id>) — для аудита заказчика.
  actorExternal  String
  /// Роль у заказчика (JWT) / кабинета (TMA) — для журнала.
  actorRole      String?
  /// Роль помощника, по которой выдано право (`*` — владелец «Админки»).
  assistRole     String
  connectorId    String
  operationRowId String
  /// `<коннектор>.<operationId>`
  operation      String
  /// write | danger (класс на момент предложения; при «Да» — не ниже).
  kind           String
  /// Аргументы по схеме OpenAPI (path/query/body); NULL после ретенции.
  params         Json?
  /// SHA-256 канонического JSON (операция + аргументы) — «Да» сверяет его.
  paramsHash     String
  /// [{ name, in, before?, after }] — строки карточки «было → станет».
  fields         Json?
  /// Снимок `preview` («было», ≤ 8 КБ) — для карточки и `$.preview.*`.
  preview        Json?
  /// none | native | preview | native+preview
  dryRun         String    @default("none")
  /// ok | failed | skipped
  dryRunStatus   String?
  dryRunNote     String?
  /// «Ассистент предложил это сам, без вашей просьбы» (§5.7) — флаг на ревью.
  unrequested    Boolean   @default(false)
  /// danger: слово подтверждения с числом строк («СКАСУВАТИ 3»).
  confirmPhrase  String?
  /// Сумма из `amountParam` (денежный потолок).
  amount         Float?
  /// Компенсация: id исходного предложения (§5-бис.15 п.14).
  compensationOf String?
  /// Шаг мемо «Админки» (АМ-N): каждый write/danger — своё «Да».
  memoRunId      String?
  memoStep       Int?
  /// pending | executing | done | failed | unknown | rejected | expired
  status         String    @default("pending")
  attempts       Int       @default(0)
  /// ok | http_error | timeout | blocked | auth_failed | bad_response …
  outcome        String?
  httpStatus     Int?
  /// Текст ошибки API 4xx — усечён, маскирован (§5.7).
  errorText      String?
  /// committed | compensated | compensation_failed | unknown (витрина; правда —
  /// записи `chain` в журнале).
  chainStatus    String?
  expiresAt      DateTime
  decidedBy      String?
  decidedAt      DateTime?
  executedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memoRunId, memoStep])
  @@index([siteId, actor, createdAt])
  @@index([siteId, status])
  @@index([accountId])
  @@map("assist_admin_action_proposals")
}

/// Мемо «Админки» АМ-N (§5-бис.17 п.10): второй экземпляр, редактирует
/// только `assistAdmin: owner`; серверные эффекты — только шаги `api`
/// (операция коннектора), каждый write/danger — отдельное «Да». Журнал
/// изменений — записи `memo` в assist_admin_action_log.
model AssistAdminMemo {
  id               String                   @id @default(cuid())
  accountId        String
  siteId           String
  site             Site                     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  /// АМ-N — порядковый в сайте (assist_admin_settings.memoCounter), не переиспользуется.
  number           Int
  key              String
  /// draft | checking | published | held | needs_review | disabled | removed
  status           String                   @default("draft")
  publishedVersion Int?
  draftRevision    Int                      @default(0)
  draft            Json
  /// manual | import
  origin           String                   @default("manual")
  reviewReason     Json?
  createdBy        String
  updatedBy        String
  removedAt        DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  versions         AssistAdminMemoVersion[]

  @@unique([siteId, number])
  @@unique([siteId, key])
  @@unique([id, accountId])
  @@index([accountId])
  @@map("assist_admin_memos")
}

model AssistAdminMemoVersion {
  id          String          @id @default(cuid())
  accountId   String
  siteId      String
  site        Site            @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  memoId      String
  memo        AssistAdminMemo @relation(fields: [memoId, accountId], references: [id, accountId], onDelete: Cascade)
  number      Int
  /// checking | published | held | discarded
  status      String
  content     Json
  contentHash String
  gateReport  Json?
  /// Проверка по живому каталогу коннекторов: { result: pass | fail, problems }.
  checkReport Json?
  rollbackOf  Int?
  requestedBy String
  publishedBy String?
  createdAt   DateTime        @default(now())
  publishedAt DateTime?

  @@unique([memoId, number])
  @@index([siteId])
  @@index([accountId])
  @@map("assist_admin_memo_versions")
}

/// Индекс фраз мемо «Админки»: одна нормализованная фраза (язык) — одно мемо.
model AssistAdminPhrase {
  siteId    String
  accountId String
  site      Site     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  lang      String
  norm      String
  /// memo:<id>
  owner     String
  /// memo-name | memo-trigger
  kind      String
  createdAt DateTime @default(now())

  @@id([siteId, lang, norm])
  @@index([accountId])
  @@index([siteId, owner])
  @@map("assist_admin_phrases")
}

/// Запуск мемо АМ-N сотрудником: версия закреплена, шаги идут по порядку;
/// write/danger — предложение и «Да». Значения слотов — только здесь, пока
/// запуск жив (стираются по завершении/истечении).
model AssistAdminMemoRun {
  id             String   @id @default(cuid())
  accountId      String
  siteId         String
  site           Site     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  memoId         String
  memoNumber     Int
  memoVersion    Int
  conversationId String?
  actor          String
  channel        String
  /// running | waiting | done | failed | stopped | expired
  status         String   @default("running")
  /// Следующий шаг (индекс).
  step           Int      @default(0)
  slots          Json?
  /// [{ i, operation, outcome }] — что уже сделано (без значений).
  progress       Json     @default("[]")
  /// reached | not_reached | unknown
  goalStatus     String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([siteId, actor])
  @@index([accountId])
  @@map("assist_admin_memo_runs")
}

/// Э6-бис (б): голосовой план сотрудника в админке заказчика (ТЗ §5-бис.3,
/// §5-бис.9 — вторая модель, без поля «режим»; аудит 1.2). Исполняет чанк
/// `admin-act.js` на странице админки (origin заказчика), команда — только
/// из iframe `wa.` (голос с билетом или набор). Журнал шагов — строки
/// `ui-plan`/`ui-step`/`chain` в append-only assist_admin_action_log.
model AssistAdminUiPlan {
  id              String                   @id @default(cuid())
  accountId       String
  siteId          String
  site            Site                     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  /// Диалог сотрудника (команда и итог — сообщения диалога); у плана
  /// тестовой сессии мастера диалога нет.
  conversationId  String?
  conversation    AssistAdminConversation? @relation(fields: [conversationId, accountId], references: [id, accountId], onDelete: Cascade)
  /// `jwt:<sub>` — исполнять/подтверждать/останавливать только ему.
  actor           String
  /// Сессия встраивания, в которой построен план.
  sessionId       String
  /// Команда — маскированной (`maskSensitiveEcho`), ≤ 600.
  utteranceMasked String
  /// voice | typed
  source          String
  lang            String?
  /// Страница админки (без query, путь — маской ПД).
  pageUrl         String
  /// Проверенные шаги и состояние каждого. Пока план живой — значения как
  /// сказаны (их видит сотрудник в карточке); при завершении — маской.
  steps           Json
  /// Пока план живой — сырой текст команды (сверка значений «после перехода»).
  liveUtterance   String?
  currentStep     Int                      @default(0)
  /// proposed | confirmed | running | done | stopped | failed | expired
  status          String                   @default("proposed")
  needsConfirm    Boolean
  /// voice | button | auto | dry
  confirmedBy     String?
  confirmBefore   DateTime
  expiresAt       DateTime
  cardFrom        Int                      @default(0)
  pnrConfirmedAt  DateTime?
  /// clean | committed | kept | compensated | partially_compensated | unknown
  chainStatus     String?
  /// model | direct | memo
  planOrigin      String                   @default("model")
  /// Мемо АМ-N: запуск и отрезок шагов `ui` версии, который исполняет план.
  memoRunId       String?
  memoFrom        Int?
  memoTo          Int?
  /// Мастер «Админки»: тестовая сессия и сухой прогон.
  voiceTestId     String?
  dryRun          Boolean                  @default(false)
  /// Деньги плана (модель) — в суточный потолок «Админки».
  costMicroUsd    Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@unique([id, accountId])
  @@index([siteId, actor, createdAt])
  @@index([siteId, createdAt])
  @@index([voiceTestId])
  @@index([accountId])
  @@map("assist_admin_ui_plans")
}

/// Э6-бис (б): мастер проверки голосового управления «Админки» Т-2
/// (§5-бис.13 «Т-2 для Админки»; У-22 — своя таблица, не общая с «Сайтом»).
/// Ссылку выдаёт только `assistAdmin: owner`; обмен — в сессии сотрудника
/// (`wa.`), отчёт — сюда и строкой `ui-test` в журнал действий «Админки».
model AssistAdminVoiceTest {
  id               String    @id @default(cuid())
  accountId        String
  siteId           String
  site             Site      @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  /// Хост админки (verified, из adminHostIds) и его origin.
  hostId           String
  host             String
  origin           String
  /// Хост отмечен владельцем «тестовый» — только тут «Сохранить».
  testHost         Boolean   @default(false)
  /// Кто выдал ссылку (`tg:<telegramId>`).
  startedBy        String
  tokenHash        String    @unique
  tokenExpiresAt   DateTime
  usedAt           DateTime?
  /// Сессия сотрудника `wa.`, обменявшая ссылку, и её `sub` — до конца мастера.
  sessionId        String?
  actor            String?
  sessionExpiresAt DateTime?
  /// Попытки исполнить шаг на цели класса «никогда» (регистратор загрузчика
  /// + отказы сервера) — в отчёте «попыток нажать запрещённое».
  attempts         Int       @default(0)
  report           Json?
  /// pass | partial | fail
  result           String?
  validUntil       DateTime?
  reportedAt       DateTime?
  release          String?
  partialAckBy     String?
  partialAckAt     DateTime?
  createdAt        DateTime  @default(now())

  @@index([siteId, createdAt])
  @@index([accountId])
  @@map("assist_admin_voice_tests")
}

// ══ Э2: виджет режима «Сайт» (ТЗ §3-бис, §4-бис, §4.5, §4.12–§4.13, §6.3) ══
//
// Публичные маршруты /widget/v1/* работают под ролью assist_public
// (AssistPublicDb); GRANT-ы — миграция …_assist_widget, белый список —
// src/prisma/assist-public-role.spec.ts. Всё здесь — режим «Сайт»: у
// «Админки» (Э7) будут свои таблицы assist_admin_*, общих нет (К-9).

/// Опубликованные версии вида виджета и персоны (§3-бис.4, §3.5): история
/// — строками, откат = новая версия с содержимым старой (как у знаний).
/// Последние 20 каждого вида хранятся, старше — удаляет ретенция.
model AssistSiteConfigVersion {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// widget | persona
  kind                  String
  version               Int
  /// Проверенная конфигурация (widget-config.ts / persona.ts, assist-site-setup).
  config                Json
  /// persona: отчёт прогона поднабора eval (§4-тер.8) перед публикацией.
  gateReport            Json?
  /// Откат — с какой версии скопировано.
  rolledBackFrom        Int?
  publishedByTelegramId BigInt?

  createdAt DateTime @default(now())

  @@unique([siteId, kind, version])
  @@index([accountId])
  @@map("assist_site_config_versions")
}

/// Указатель посетителя `resumeKey` (§4-бис.3, Р-27): в базе — SHA-256,
/// сам ключ — в localStorage iframe и CHIPS-cookie. Привязан к сайту и
/// origin родителя; 30 дней скользящий. Пишет публичный маршрут.
model AssistSiteVisitorResume {
  keyHash      String   @id
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  visitorId    String
  /// `https://shop.example.com` — origin родителя при выдаче.
  parentOrigin String
  lastSeenAt   DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([siteId, visitorId])
  @@index([expiresAt])
  @@map("assist_site_visitor_resumes")
}

/// Диалог посетителя (§4.17, §4-бис.9). Источник истины истории — сервер
/// (§4.13 п.4: история от клиента не принимается).
model AssistSiteConversation {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  visitorId     String
  /// Хеш IP: суточная соль + соль сайта (§6.3, §6.4).
  ipHash        String
  parentOrigin  String
  /// Страница, где начат диалог (без query — §6.6).
  pageUrl       String?
  locale        String?
  /// Засчитан в квоту диалогов периода (первый ответ модели, §4.5 п.3).
  dialogCounted Boolean  @default(false)
  /// Э5: в диалоге был голос — распознавание вопроса или озвучка ответа
  /// (§7.1, Р-58: такой диалог — 2 единицы). Сбрасывается вместе с
  /// `answers`/`dialogCounted` после 30 минут тишины (новый диалог).
  voice         Boolean  @default(false)
  /// Ответов модели в диалоге: > 30 — диалог за 2, > 60 — за 3 (§7.1).
  answers       Int      @default(0)
  /// §4.13 п.5: ответы только из FAQ/кэша, без генерации.
  suspicious    Boolean  @default(false)
  /// Флаги ревью (unsupported_number и т.п. в любом ответе диалога).
  flagged       Boolean  @default(false)
  /// lead | handoff | resolved | … — итог для аналитики (Э3).
  outcome       String?
  /// Э3: передача человеку. Э2 — handoff превращается в форму лида.
  handoffState  String?
  /// §4-бис.5: идущий сценарий/план (Э3/Э6-бис); Э2 — всегда null.
  activePlanId  String?
  /// Э3 (§5-тер.12 п.10): кто начал диалог — user | proactive:<триггер> |
  /// scenario:<ключ>. Пишет виджет при создании диалога.
  openedBy      String?
  /// Э3-бис (§5-тер.9): хеш ключа визита — ТОЛЬКО в связанном режиме (с
  /// согласием посетителя на аналитику); связывает цель на другой странице с
  /// диалогом в окне атрибуции. Без согласия — null.
  visitHash     String?
  /// Растёт с каждым изменением диалога — `GET /widget/v1/state?since=`.
  stateVersion  Int      @default(0)
  lastMessageAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AssistSiteMessage[]
  leads    AssistSiteLead[]

  // Э3: всё, что удаляется/отвязывается вместе с диалогом (forget, ретенция).
  handoffs      AssistSiteHandoff[]
  learningItems AssistSiteLearningItem[]
  goalEvents    AssistSiteGoalEvent[]
  // Э6-бис: голосовые планы диалога (каскад с диалогом — ретенция и forget).
  uiPlans       AssistSiteUiPlan[]
  // Э3-бис: разметка диалога моделью — живёт и удаляется с диалогом (§5-тер.15).
  label         AssistSiteConversationLabel?
  faqFrom       AssistSiteFaq[]              @relation("FaqFromConversation")
  evalCasesFrom AssistSiteEvalCase[]         @relation("EvalCaseFromConversation")

  @@unique([id, accountId])
  @@index([siteId, visitorId, lastMessageAt])
  @@index([siteId, createdAt])
  @@index([lastMessageAt])
  @@index([accountId])
  @@map("assist_site_conversations")
}

/// Сообщение диалога. Текст — МАСКИРОВАННЫЙ (вопрос и ответ, §4.7, приёмка
/// Э2 п.6): сырой вопрос живёт только в памяти запроса.
model AssistSiteMessage {
  id             String                 @id @default(cuid())
  accountId      String
  siteId         String
  site           Site                   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  conversationId String
  conversation   AssistSiteConversation @relation(fields: [conversationId, accountId], references: [id, accountId], onDelete: Cascade)

  /// visitor | assistant | operator | system
  role            String
  text            String
  /// [{ n, url, title }] — проверенные источники ответа (§4.6).
  sources         Json?
  /// Проверенные действия (§4.9): link | lead | handoff.
  actions         Json?
  /// unsupported_number | forbidden_promise | injection_suspect | …
  flags           String[]
  /// §4-бис.4: идемпотентность вопроса — уникальна В ПАРЕ с диалогом.
  clientRequestId String?
  /// streaming | complete | partial | refused
  streamState     String   @default("complete")
  /// Сколько символов text уже сброшено генерирующим экземпляром.
  streamOffset    Int      @default(0)
  /// none | faq | cache | model | template — каким путём получен ответ.
  answerPath      String?
  /// Ключ семантического кэша, из которого/в который ответ (👎 удаляет запись).
  cacheKey        String?
  /// 👍 = 1, 👎 = -1 (§4.17, §4-тер.7).
  rating          Int?
  inTokens        Int      @default(0)
  outTokens       Int      @default(0)
  cachedTokens    Int      @default(0)
  costMicroUsd    Int      @default(0)
  model           String?
  latencyMs       Int?

  // ── Э3 ──
  /// Язык текста (uk|ru|en|…) — для перевода оператору (№12, §4-тер.10).
  lang           String?
  /// Перевод для другой стороны: у сообщения посетителя — `{ lang, text }`
  /// на язык оператора (видит оператор); у ответа оператора — оригинал
  /// `{ lang, text }`, а в `text` — перевод на язык посетителя. Пишет
  /// системный код передачи (H); роли виджета писать не нужно.
  translation    Json?
  /// Ответ оператора: кто (участник кабинета). Роли виджета не виден.
  authorMemberId String?
  /// «Почему так ответил» (№34): `{ knowledgeVersion, configVersion,
  /// chunkIds[], faqId, rule, cache }` — пишет конвейер ответа.
  trace          Json?
  /// Сообщение посетителя во время передачи доставлено оператору в бот.
  relayedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, clientRequestId])
  @@index([conversationId, createdAt])
  @@index([siteId, createdAt])
  @@index([accountId])
  @@map("assist_site_messages")
}

/// Лид из формы виджета (§3.6 п.6, К-3: только явной отправкой формы).
/// Таблица assist_site_* (а не assist_leads эскиза §4.17): лиды есть только
/// у «Сайта», и схема имён §4.3-бис держит тест роли и граф.
model AssistSiteLead {
  id             String                  @id @default(cuid())
  accountId      String
  siteId         String
  site           Site                    @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  /// Удалили диалог (`/widget/v1/forget`, ретенция) — лид остаётся без ссылки.
  conversationId String?
  conversation   AssistSiteConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  visitorId      String?

  /// Поля формы — шифр ASSIST_SECRETS_KEY (AES-256-GCM), в открытом виде нет.
  fieldsEnc        String
  /// Какие поля заполнены (имена, без значений) — для экрана и метрик.
  fieldNames       String[]
  /// Э3: `V4CAssist('identify', { name, email, externalId, userHash })` —
  /// шифр ASSIST_SECRETS_KEY (как fieldsEnc); `userHash` сверяет системная
  /// доставка секретом идентичности сайта (assist_site_integrations).
  identityEnc      String?
  /// null — не было identify; true/false — userHash сошёлся/нет (пишет доставка).
  identityVerified Boolean?
  /// Текст согласия ровно в той редакции, что видел посетитель, и время.
  consentText      String
  consentAt        DateTime
  pageUrl          String?
  /// pending | delivered | failed
  deliveryState    String    @default("pending")
  /// [{ channel: 'telegram', chatId, at }]
  deliveredTo      Json?
  attempts         Int       @default(0)
  lockedUntil      DateTime?
  lastError        String?
  deliveredAt      DateTime?

  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
  @@index([deliveryState, lockedUntil])
  @@index([conversationId])
  @@index([accountId])
  @@map("assist_site_leads")
}

/// Деньги дня (§4.5): scope `site` (key = siteId) и `platform` (key = `all`).
/// Резерв — условным UPDATE ЭТОЙ строки (блокировка строки сериализует
/// параллельные резервы): `spent + reserved + :est <= cap`. Строки дня может
/// не быть — сначала INSERT … ON CONFLICT DO NOTHING (§4.5 уточнение 1).
model AssistBudgetDay {
  scope            String
  key              String
  /// YYYY-MM-DD (UTC).
  day              String
  spentMicroUsd    BigInt   @default(0)
  reservedMicroUsd BigInt   @default(0)
  updatedAt        DateTime @updatedAt

  @@id([scope, key, day])
  @@index([day])
  @@map("assist_budget_days")
}

/// Резерв одного ответа с TTL (§4.5 уточнение 2): функцию убил maxDuration
/// — резерв не вечный; просроченные снимает `assist-budget-sweep`
/// (вычитает из reservedMicroUsd ровно один раз — DELETE … RETURNING).
model AssistBudgetReservation {
  id          String   @id
  siteId      String
  day         String
  estMicroUsd BigInt
  /// Э5: резерв голоса — держит ещё и строку `scope='voice'` (суточный
  /// потолок голоса сайта, §4.10); снятие кроном вычитает и её.
  voice       Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
  @@index([siteId, day])
  @@map("assist_budget_reservations")
}

/// Семантический кэш ответов (§4.5, §4-тер.7): ключ — semanticCacheKey
/// (siteId + режим + knowledgeVersion + configVersion + нормализованный
/// вопрос). Смена версии = другой ключ; 👎 удаляет запись.
model AssistSiteSemanticCache {
  id               String   @id @default(cuid())
  siteId           String
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  key              String
  /// { text, sources, actions, lang } — уже проверенный ответ.
  answer           Json
  knowledgeVersion Int
  configVersion    Int
  hits             Int      @default(0)
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@unique([siteId, key])
  @@index([expiresAt])
  @@map("assist_site_semantic_cache")
}

/// Ограничения частоты в Postgres (§4.13 п.2–3): окно — строкой `bucket`
/// (`2026-10-01T12:34` для минуты и т.п.), счётчик — условным UPSERT.
model AssistRateBucket {
  /// widget-session-ip | widget-msg-visitor-min | widget-msg-visitor-hour | widget-msg-ip-site-min | …
  scope     String
  key       String
  bucket    String
  count     Int      @default(0)
  expiresAt DateTime

  @@id([scope, key, bucket])
  @@index([expiresAt])
  @@map("assist_rate_buckets")
}

/// Одноразовые токены предпросмотра (§3-бис.4, аудит 01.10): `?v4c_preview=`
/// на сайте и конфигуратор TMA. В базе — SHA-256; обмен на сессию
/// предпросмотра — один раз; привязан к сайту и origin.
model AssistSitePreviewToken {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  tokenHash           String    @unique
  /// site — ссылка «посмотреть на сайте»; tma — конфигуратор в кабинете;
  /// goal (Э3) — режим выбора цели на сайте (`?v4c_goal=`).
  purpose             String
  /// purpose=site: origin verified-хоста, где токен можно обменять.
  origin              String?
  /// Черновик вида на момент выдачи (или null — брать текущий черновик).
  draft               Json?
  createdByTelegramId BigInt
  expiresAt           DateTime
  usedAt              DateTime?
  /// SHA-256 сессии предпросмотра (sessionStorage iframe) после обмена.
  sessionHash         String?   @unique
  sessionExpiresAt    DateTime?
  /// Э3, purpose = goal (WYSIWYG-выбор цели, §5-тер.1): выбранный на сайте
  /// элемент `{ descriptor, path, label, at }` — пишет загрузчик, читает TMA.
  result              Json?

  createdAt DateTime @default(now())

  @@index([siteId])
  @@index([expiresAt])
  @@index([accountId])
  @@map("assist_site_preview_tokens")
}

/// Пинги загрузчика (§3-бис.2 «Проверить установку», §4.12): виджет
/// загрузился на этом origin. Нет пинга при найденном теге — «вероятно, CSP».
model AssistSiteInstallPing {
  siteId        String
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  origin        String
  /// Origin подтверждён и виджет на нём включён в момент пинга.
  allowed       Boolean
  loaderVersion String?
  /// Загрузчик получил конфиг fetch'ем (false — вероятно, CSP connect-src
  /// сайта без нашего origin: кнопка в виде по умолчанию, проверка установки
  /// подсказывает директиву).
  configFetchOk Boolean?
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  count         Int      @default(1)

  @@id([siteId, origin])
  @@map("assist_site_install_pings")
}

/// Мастер «Научите помощника» (§4-тер.9): 10 тем с черновиками по сайту,
/// ответы владельца → проверенные ответы origin = wizard.
model AssistSiteWizard {
  siteId    String @id
  accountId String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// shop | services | saas — набор вопросов.
  businessType  String
  /// [{ topic, question, draft, draftSources, answer, status, faqId }] —
  /// форма в assist-site-knowledge/wizard/wizard-types.ts.
  items         Json      @default("[]")
  /// in_progress | done
  status        String    @default("in_progress")
  /// Прогонов черновиков (платформа платит ≤ 1 + 3 повтора, §4-тер.11).
  draftRuns     Int       @default(0)
  spentMicroUsd Int       @default(0)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  @@unique([siteId, accountId])
  @@index([accountId])
  @@map("assist_site_wizards")
}

/// Логотип/аватар виджета (§3-бис.1): ТОЛЬКО растр PNG/JPEG/WebP ≤ 200 КБ
/// (SVG в Э2 отвергается — растеризатора в sites-backend нет, вопрос О-6).
/// Отдаётся `GET /widget/v1/asset/:id` с нашего origin (img-src 'self'),
/// `nosniff`, immutable — в DOM вставляется только как <img src>.
model AssistSiteAsset {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// logo | avatar
  kind   String
  /// image/png | image/jpeg | image/webp — по сигнатуре байтов, не по заголовку.
  mime   String
  sha256 String
  bytes  Bytes
  width  Int
  height Int

  createdAt DateTime @default(now())

  @@index([siteId])
  @@index([accountId])
  @@map("assist_site_assets")
}

// ── Поддержка лендинга (лендинг-ТЗ §5.3, §7.3, §10.1; план «Поддержка лендинга» Э2) ──

/// Анонимный черновик вида из конфигуратора лендинга (≤ 2 КБ, без логотипа,
/// 7 дней) → payload `wd_<id>`. Часть «к Л3»: таблица — сейчас, маршрут и
/// читатель — к Л3.
model AssistWidgetDraft {
  /// 128 бит случайности (base64url) — неугадываемый id в `startapp`.
  id              String    @id
  config          Json
  /// Хеш IP с суточной солью — лимит 10 черновиков в сутки.
  ipKey           String
  appliedToSiteId String?
  appliedAt       DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  @@index([expiresAt])
  @@map("assist_widget_drafts")
}

/// Атрибуция кабинета (лендинг-ТЗ §7.3): payload `lp_|wd_|pl_|sb_` и utm
/// первого входа. Продуктовая запись — не поле ядра `site_accounts` (Д-8).
model AssistAcquisition {
  id          String      @id @default(cuid())
  accountId   String
  account     SiteAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Сырой payload startapp (`lp_spring`, `pl_start`…).
  payload     String
  /// lp | wd | pl | sb
  source      String
  campaign    String?
  landingPath String?
  utm         Json?
  createdAt   DateTime    @default(now())

  @@index([accountId])
  @@map("assist_acquisitions")
}

/// Первичные события лендинга (лендинг-ТЗ §10.1): без идентификатора на
/// устройстве; ipHash — суточный. Ретенция 90 дней.
model AssistLandingEvent {
  id        String   @id @default(cuid())
  name      String
  props     Json?
  locale    String?
  variant   String?
  path      String?
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
  @@map("assist_landing_events")
}

// ══ Э3: передача человеку, обучение на диалогах, цели и статистика ══════
//
// Контракт /tmp/k/CONTRACT-E3.md; ТЗ §3.7, §4-тер.3–4, §4-тер.12–14,
// §5-тер.1–2, §5-тер.6–7, §5-тер.14–16. Миграция …_assist_handoff;
// GRANT роли assist_public — там же, белый список — assist-public-role.spec.ts.

/// Передача диалога человеку (§3.7). Одна ОТКРЫТАЯ (waiting|active) на
/// диалог — частичный уникальный индекс в миграции (Prisma его не видит).
/// Посетитель создаёт строку (роль виджета, createMany); карточки в бот,
/// «Взять», ответы, напоминания и таймауты — системный код (H).
model AssistSiteHandoff {
  id             String                 @id @default(cuid())
  accountId      String
  siteId         String
  site           Site                   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  conversationId String
  conversation   AssistSiteConversation @relation(fields: [conversationId, accountId], references: [id, accountId], onDelete: Cascade)

  /// waiting | active | closed | missed | cancelled
  state              String    @default("waiting")
  /// visitor (кнопка/фраза) | escalation (правило №13) | no_answer | scenario
  reason             String
  /// Правило ранней эскалации (№13): irritation | complaint | refund | wholesale | sensitive …
  escalation         String?
  visitorLang        String?
  operatorLang       String?
  /// Страница без query (§6.6).
  pageUrl            String?
  /// Сводка для оператора (№14): `{ text, lang, model }` — по МАСКИРОВАННЫМ сообщениям.
  summary            Json?
  /// Последний ИИ-черновик ответа оператору (№11): `{ text, lang, sources[] }`.
  draft              Json?
  /// identify посетителя (шифр, как у лида) — только с явной передачей (К-3).
  identityEnc        String?
  identityVerified   Boolean?
  assignedMemberId   String?
  assignedTelegramId BigInt?
  requestedAt        DateTime  @default(now())
  /// Карточки разосланы (успешно хотя бы одному).
  deliveredAt        DateTime?
  takenAt            DateTime?
  firstReplyAt       DateTime?
  lastOperatorAt     DateTime?
  lastVisitorAt      DateTime?
  remindedAt         DateTime?
  reminders          Int       @default(0)
  /// Срок «нет оператора → форма заявки посетителю» (§3.7 п.6).
  timeoutAt          DateTime
  missedAt           DateTime?
  closedAt           DateTime?
  /// operator | visitor | timeout | system
  closedBy           String?
  /// Разосланные карточки `[{ memberId, chatId, messageId }]` — правка «Взял …».
  cards              Json?
  attempts           Int       @default(0)
  lockedUntil        DateTime?
  costMicroUsd       Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, state])
  @@index([state, timeoutAt])
  @@index([conversationId])
  @@index([accountId])
  @@map("assist_site_handoffs")
}

/// Сообщения бота Помощника, на которые можно ответить реплаем или нажать
/// кнопку (§3.7 п.3–4): (chatId, messageId) → передача/диалог. Без этой
/// таблицы реплай оператора не к чему привязать. Срок — expiresAt.
model AssistBotMessage {
  chatId         BigInt
  messageId      Int
  accountId      String
  siteId         String
  site           Site     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  /// handoff_card | relay | operator_echo | candidate_prompt | lead |
  /// operator_in (реплай оператора — дедуп повторов Telegram) | draft | draft_sent
  kind           String
  handoffId      String?
  conversationId String?
  /// Участник кабинета, которому отправлено.
  memberId       String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@id([chatId, messageId])
  @@index([handoffId])
  @@index([expiresAt])
  @@index([accountId])
  @@map("assist_bot_messages")
}

/// Человек в боте Помощника (личность Telegram, не кабинет): нажал Start —
/// ему можно писать; бот заблокирован (403) — не слать. Карточки передачи
/// уходят только участникам с startedAt и без blockedAt (§3.7, О-9 Э2).
model AssistBotUser {
  telegramId   BigInt    @id
  startedAt    DateTime?
  blockedAt    DateTime?
  /// language_code из Telegram — язык интерфейса оператора по умолчанию.
  languageCode String?
  updatedAt    DateTime  @updatedAt

  @@map("assist_bot_users")
}

/// Элемент очереди обучения «Сайта» (§4-тер.3, §4-тер.14). Создаёт код
/// маршрута чата/👎 (роль виджета, INSERT без RETURNING) — вопрос и ответ
/// УЖЕ маскированы. Вектор вопроса — тот, что посчитан для поиска.
/// Удаляется вместе с диалогом (forget, ретенция — «как диалоги режима»).
model AssistSiteLearningItem {
  id                   String                      @id @default(cuid())
  accountId            String
  siteId               String
  site                 Site                        @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  /// unknown | wrong | unhappy | operator_fix | voice_miss
  kind                 String
  conversationId       String?
  conversation         AssistSiteConversation?     @relation(fields: [conversationId, accountId], references: [id, accountId], onDelete: Cascade)
  messageId            String?
  /// Для счёта РАЗНЫХ посетителей кластера (§4-тер.15 п.9).
  visitorId            String?
  /// Трафик suspicious (§4.13 п.5) кластер не растит.
  suspicious           Boolean                     @default(false)
  /// Источник сигнала: no_answer | empty_search | thumbs_down | flag:<x> | repeat | handoff_after_answer | operator | label
  signal               String?
  questionMasked       String
  answerMasked         String?
  lang                 String?
  questionEmbedding    Unsupported("vector(768)")?
  clusterId            String?
  cluster              AssistSiteLearningCluster?  @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  /// Кандидат оператора (Р-33): ответ — кандидат, не знание.
  proposedAnswer       String?
  proposedByTelegramId BigInt?
  proposedAt           DateTime?
  /// new | proposed | resolved | ignored
  status               String                      @default("new")
  /// golden | source | out_of_scope | ignore | accepted | rejected
  resolution           String?
  faqId                String?
  resolvedByTelegramId BigInt?
  resolvedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, kind])
  @@index([siteId, status])
  @@index([siteId, createdAt])
  @@index([clusterId])
  @@index([conversationId])
  @@index([accountId])
  @@map("assist_site_learning_items")
}

/// Кластер очереди (§4-тер.3 п.2): похожие вопросы разных посетителей.
/// Строит крон assist-learn-rollup по векторам элементов (модель не нужна).
model AssistSiteLearningCluster {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// Подпись — типичный вопрос кластера (маскированный).
  label                String
  /// Преобладающий тип сигнала.
  kind                 String
  size                 Int                         @default(0)
  /// Разные посетители без suspicious (§4-тер.7 «накрутка пробелов»).
  distinctVisitors     Int                         @default(0)
  centroid             Unsupported("vector(768)")?
  lang                 String?
  firstSeenAt          DateTime
  lastSeenAt           DateTime
  /// open | resolved | ignored
  status               String                      @default("open")
  /// golden | source | out_of_scope | ignore
  resolution           String?
  faqId                String?
  resolvedByTelegramId BigInt?
  resolvedAt           DateTime?
  /// Переоткрыт: снова unknown через ≥ 14 дней после решения (§4-тер.3 п.4).
  reopenedAt           DateTime?

  items AssistSiteLearningItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, status])
  @@index([accountId])
  @@map("assist_site_learning_clusters")
}

/// Хвост права посетителя на удаление (§4-тер.12): то, что роль виджета
/// не может сделать сама (варианты формулировок в проверенных ответах),
/// доделывает системный код по этой записи. Диалоги, очередь, кейсы eval,
/// передачи удаляет сам forget (каскады FK).
model AssistSiteForgetJob {
  id              String    @id @default(cuid())
  siteId          String
  site            Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  conversationIds String[]
  createdAt       DateTime  @default(now())
  processedAt     DateTime?

  @@index([processedAt])
  @@index([siteId])
  @@map("assist_site_forget_jobs")
}

/// Цель заказчика (§5-тер.1): шаблон + детекторы. До 30 на сайт.
model AssistSiteGoal {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// Ключ для `V4CAssist('goal', key)` и `data-assist-goal="<key>"`.
  key                 String
  /// lead | purchase | call | booking | subscribe | messenger | custom
  template            String
  name                String
  /// `[{ kind: click|form_submit|url|js|builtin|s2s|crm, config }]` — форма в
  /// assist-analytics/goal-types.ts. Загрузчик получает только свои виды.
  detectors           Json
  /// none | fixed | event
  valueMode           String    @default("none")
  fixedValue          Decimal?  @db.Decimal(14, 2)
  currency            String?
  /// active | paused | stale (детектор не срабатывал 7 дней)
  status              String    @default("active")
  lastFiredAt         DateTime?
  createdByTelegramId BigInt?

  events AssistSiteGoalEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, key])
  @@index([accountId])
  @@map("assist_site_goals")
}

/// Срабатывание цели (§5-тер.1–2). Роль виджета только ВСТАВЛЯЕТ (дедуп —
/// ON CONFLICT DO NOTHING по clientEventId/orderId); вебхук s2s, возвраты и
/// «verified важнее page» — системный код (A). orderId — псевдонимный ПД
/// (13 мес, удаление по запросу субъекта через заказчика).
model AssistSiteGoalEvent {
  id        String         @id @default(cuid())
  accountId String
  siteId    String
  site      Site           @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  goalId    String
  goal      AssistSiteGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  occurredAt     DateTime
  receivedAt     DateTime                @default(now())
  /// loader | iframe | s2s | crm | builtin
  source         String
  /// verified | builtin | page
  trust          String
  /// Дедуп загрузчика/iframe: `<docId>:<goalKey>:<detector>` (раз на документ).
  clientEventId  String?
  /// `^[A-Za-z0-9._:-]{1,64}$`, не похож на контакт (иначе 422).
  orderId        String?
  value          Decimal?                @db.Decimal(14, 2)
  currency       String?
  /// completed | refunded | cancelled
  status         String                  @default("completed")
  path           String?
  /// direct | assisted | unassisted | unknown (§5-тер.2)
  attribution    String
  /// `{ proactive, scenario, link }` — что из помощника было в документе.
  assist         Json?
  /// Диалог (если был в этом документе). forget/ретенция — ссылка обнуляется.
  conversationId String?
  conversation   AssistSiteConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  /// Э3-бис: хеш ключа визита (только связанный режим, §5-тер.9) — связь с
  /// диалогом на другой странице и конверсия единицы эксперимента.
  visitHash      String?

  @@unique([siteId, goalId, orderId])
  @@unique([siteId, clientEventId])
  @@index([siteId, occurredAt])
  @@index([goalId, occurredAt])
  @@index([conversationId])
  @@index([accountId])
  @@map("assist_site_goal_events")
}

/// Секреты интеграций сайта (§5-тер.1 s2s, §3-бис.2 identify): шифр
/// ASSIST_SECRETS_KEY, показ один раз. Отдельно от assist_sites — ту
/// таблицу читает роль виджета (тот же довод, что У-10). Роли — НИЧЕГО.
model AssistSiteIntegration {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// goal_webhook | identity
  kind                String
  secretEnc           String
  keyVersion          Int       @default(1)
  config              Json      @default("{}")
  /// active | revoked
  status              String    @default("active")
  createdByTelegramId BigInt?
  rotatedAt           DateTime?
  lastUsedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, kind])
  @@index([accountId])
  @@map("assist_site_integrations")
}

/// Суточная свёртка «Обзора» и «Конверсий» (§5-тер.6, §5-тер.10): экран
/// статистики читает только её (≤ 1 с на 13 месяцах). Пересчёт дня
/// идемпотентен (перезапись строки). `group` — под контрольную группу
/// Э3-бис; в Э3 всегда `all`.
model AssistSiteDailyTotal {
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  /// YYYY-MM-DD в часовом поясе сайта.
  day       String
  group     String @default("all")

  dialogs           Int      @default(0)
  /// Решённые без человека (§9.1 а–г).
  resolved          Int      @default(0)
  answers           Int      @default(0)
  unknown           Int      @default(0)
  handoffs          Int      @default(0)
  handoffsMissed    Int      @default(0)
  leads             Int      @default(0)
  thumbsUp          Int      @default(0)
  thumbsDown        Int      @default(0)
  widgetViews       Int      @default(0)
  opens             Int      @default(0)
  proactiveShown    Int      @default(0)
  proactiveAccepted Int      @default(0)
  costMicroUsd      BigInt   @default(0)
  /// goalId → { direct, assisted, unassisted, refunds, value: { verified, page }, currency }
  conversions       Json     @default("{}")
  /// Триггер → { shown, accepted, dismissed, dialogs, conversions }
  proactive         Json     @default("{}")
  computedAt        DateTime @default(now())

  @@id([siteId, day, group])
  @@index([accountId])
  @@map("assist_site_daily_totals")
}

/// Счётчики событий виджета за сутки (§4.16 `/widget/v1/event`): показ
/// виджета, открытие, триггеры (показан/принят/закрыт), сценарии. Без
/// посетителя и без страницы — только (сайт, день, вид, ключ). Пишет роль
/// виджета одним UPSERT; сырых событий нет (поведение — Э3-бис).
model AssistSiteEventCount {
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD (UTC; свёртка переводит в сутки сайта по часу — см. A).
  day    String
  /// widget_view | open | proactive_shown | proactive_accepted | proactive_dismissed | scenario_started | scenario_done | link_click
  kind   String
  /// Ключ триггера/сценария; '' — без ключа.
  key    String @default("")
  /// Час UTC (0–23) — сутки сайта в другом поясе собираются из часов.
  hour   Int    @default(0)
  count  Int    @default(0)

  @@id([siteId, day, kind, key, hour])
  @@map("assist_site_event_counts")
}

/// Экспорт CSV (§5-тер.7): формирует крон в приватный Blob, ссылка 24 ч,
/// запись — журнал кабинета 1 год.
model AssistSiteExport {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// daily | conversions | dialogs
  kind                  String
  params                Json
  /// Текст реплик (только владелец кабинета).
  withText              Boolean   @default(false)
  requestedByTelegramId BigInt
  /// queued | running | done | failed | expired
  status                String    @default("queued")
  blobKey               String?
  rows                  Int?
  error                 String?
  attempts              Int       @default(0)
  lockedUntil           DateTime?
  expiresAt             DateTime?
  finishedAt            DateTime?

  createdAt DateTime @default(now())

  @@index([status, lockedUntil])
  @@index([siteId, createdAt])
  @@index([accountId])
  @@map("assist_site_exports")
}

/// Отписка от отчёта недели / утренней сводки (§5-тер.7): по умолчанию
/// подписаны владелец и `assist: manager`; строка — явный выбор человека.
model AssistSiteReportSubscription {
  accountId  String
  siteId     String
  site       Site     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  telegramId BigInt
  /// weekly | digest
  kind       String
  enabled    Boolean
  updatedAt  DateTime @updatedAt

  @@id([siteId, telegramId, kind])
  @@index([accountId])
  @@map("assist_site_report_subscriptions")
}

// ══ Э4: тарифы и оплата (ТЗ помощника §7.1, §3.10, §4.1, §8; план Э4) ══
//
// Тариф — у КАБИНЕТА (подписки), а не у сайта: лимит единиц диалогов и
// бюджеты обучения делятся между сайтами кабинета (Р-58). Деньги — в
// минимальных единицах валюты платежа (копейки UAH, целые XTR) и оценка в
// микродолларах (как site_ai_usage).

/// Подписка кабинета. Нет строки — пробный период от первого сайта
/// кабинета (assist-billing/subscription-state.ts); крон assist-billing-tick
/// материализует её, чтобы удаление сайтов не перезапускало пробный.
/// Периоды учёта — отрезки по 30 дней от anchorAt (у trial — 14 дней), пока
/// не наступил paidThrough: продление сдвигает paidThrough, смена тарифа —
/// anchorAt = paidThrough-старт (новый период и новый счётчик сразу).
model AssistSubscription {
  accountId String      @id
  account   SiteAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// trial | start | business | pro (ASSIST_PLANS).
  planId               String
  /// active | expired — `expired` ставит крон по истечении льготы.
  status               String    @default("active")
  /// trial | stars | wayforpay | manual — чем продлевается.
  method               String
  anchorAt             DateTime
  paidThrough          DateTime
  /// Владелец отменил продление: доступ до paidThrough, затем expired.
  cancelAtPeriodEnd    Boolean   @default(false)
  /// recToken WayForPay — ТОЛЬКО шифром (token-crypto, ключ — производный
  /// от ASSIST_SECRETS_KEY). Роли виджета не виден.
  recTokenEnc          String?
  /// Stars: charge последнего платежа подписки и плательщик — для отмены
  /// продления в Telegram (editUserStarSubscription).
  starsChargeId        String?
  starsPayerTelegramId BigInt?
  /// «Докупать автоматически» (§3.10): только при recToken; потолок — деньги
  /// за период, оценка в микродолларах.
  autoTopUp            Boolean   @default(false)
  autoTopUpCapMicroUsd BigInt    @default(0)
  /// Захват продления кроном (claim-before-charge, как billing-renewal).
  renewClaimedAt       DateTime?
  renewAttempts        Int       @default(0)
  lastRenewError       String?
  /// Пометка оператора платформы (ручной тариф пилота и т.п.).
  note                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paidThrough])
  @@map("assist_subscriptions")
}

/// Счётчик единиц диалогов периода подписки (§7.1, Р-58): условный UPDATE
/// `units + w <= лимит тарифа + докупка + авто-пакет` — один оператор, без
/// «прочитал-решил». Пишет конвейер ответа под assist_public.
model AssistAccountUsage {
  accountId         String
  account           SiteAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Начало периода (ISO) — ключ: новый период = новая строка.
  periodKey         String
  /// Единицы с весами (текст 1, голос 2, «Админка» 3; ×2 после 30 ответов).
  units             Int         @default(0)
  /// Диалогов (без весов) — для экрана и сводки.
  dialogs           Int         @default(0)
  /// Докупленные единицы этого периода (вручную и автоматически).
  extraUnits        Int         @default(0)
  /// Автодокупка: пакетов списано и сумма — против потолка владельца.
  autoPacks         Int         @default(0)
  autoSpentMicroUsd BigInt      @default(0)
  /// Первый отказ по лимиту (мягкий стоп) — для уведомления 100%.
  exhaustedAt       DateTime?
  warned80At        DateTime?
  warned100At       DateTime?
  updatedAt         DateTime    @default(now()) @updatedAt

  @@id([accountId, periodKey])
  @@map("assist_account_usage")
}

/// Платёж (чекаут и факт). id — 128 бит случайности: им же подписан счёт
/// Stars (`invoice_payload`) и он же `orderReference` WayForPay. Продление
/// кроном и автодокупка — детерминированный id (повтор тика не спишет
/// дважды). Без FK на кабинет: денежные записи переживают удаление кабинета.
model AssistPayment {
  id                  String    @id
  accountId           String
  /// subscription | renewal | topup | auto_topup
  kind                String
  planId              String?
  /// Докупка: сколько единиц.
  units               Int?
  /// stars | wayforpay
  method              String
  /// pending | succeeded | failed | expired
  status              String    @default("pending")
  /// UAH | XTR
  currency            String
  amountMinor         Int
  amountMicroUsd      BigInt    @default(0)
  /// Stars — telegram_payment_charge_id; WayForPay — orderReference (= id).
  providerRef         String?
  /// Автопродление Stars: первый платёж подписки.
  parentId            String?
  /// Докупка: период, в который пошли единицы.
  periodKey           String?
  recurring           Boolean   @default(false)
  createdByTelegramId BigInt?
  payerTelegramId     BigInt?
  failureReason       String?
  /// Ответ провайдера без recToken/cardPan/authCode (wayforpay-sanitize).
  rawPayload          Json?
  expiresAt           DateTime?
  paidAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Идемпотентность колбэков: один charge/orderReference — одна строка.
  @@unique([method, providerRef])
  @@index([accountId, createdAt])
  @@index([status, createdAt])
  @@map("assist_payments")
}

/// Принятые Условия и DPA (§3.1, §6.1, №49): версия документа — в записи.
model AssistLegalAcceptance {
  id                   String      @id @default(cuid())
  accountId            String
  account              SiteAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// terms | dpa
  document             String
  version              String
  /// Пункт DPA: обезличенные ответы «Сайта» — в eval платформы (§8 п.3, В-20).
  evalConsent          Boolean     @default(false)
  acceptedByTelegramId BigInt
  acceptedAt           DateTime    @default(now())

  @@unique([accountId, document, version])
  @@map("assist_legal_acceptances")
}

/// Настройки платформы из админки (§8 п.5): рубильник виджета, потолок
/// платформы. env остаётся верхней границей (рубильник env сильнее).
model AssistPlatformSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("assist_platform_settings")
}

/// Журнал доступа операторов платформы к ответам и кабинетам (§6.6, §8 п.3).
model AssistPlatformAccessLog {
  id     String   @id @default(cuid())
  /// id оператора в админке генератора (через внутренний API).
  actor  String
  action String
  target String?
  at     DateTime @default(now())

  @@index([at])
  @@map("assist_platform_access_log")
}

/// Кандидаты в eval платформы из ревью (§8 п.3): только «Сайт», только при
/// согласии кабинета в DPA, текст уже маскирован.
model AssistPlatformEvalCandidate {
  id        String   @id @default(cuid())
  accountId String
  siteId    String
  messageId String   @unique
  question  String
  answer    String
  addedBy   String
  createdAt DateTime @default(now())

  @@map("assist_platform_eval_candidates")
}

// ═══ Э5: голос виджета (ТЗ §4.10; план, Приложение А «Этап 5») ═══

/// Кэш озвучки ответов «Сайта» (§4.10, аудит 1.2 К-9/У-16): ключ — хеш
/// (голос, язык, текст), область — siteId (`<siteId>:site:<хеш>` по ТЗ;
/// режима «Админка» тут нет и не будет: её ответы не кэшируются). 7 дней
/// (FAQ-ответы повторяются); просроченное удаляет крон assist-retention.
/// Звук — в базе (bytea), а не в Blob: ответ ≤ 1 200 символов ≈ 60–120 КБ
/// mp3, и единая роль/транзакция проще второго хранилища с ключом.
model AssistSiteTtsCache {
  id         String   @id
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  key        String
  voice      String
  lang       String
  mime       String
  audio      Bytes
  characters Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([siteId, key])
  @@index([expiresAt])
  @@map("assist_site_tts_cache")
}

// ═══ Э6-бис: голосовое управление интерфейсом, режим «Сайт» (ТЗ §5-бис.3,
// §5-бис.9; план, Приложение А «Этап 6-бис» (а)) ═══

/// Голосовой план посетителя (§5-бис.3 п.7, §4-бис.5): шаги, проверенные
/// кодом (`assist-ui-core/plan-checks.ts`), и номер текущего шага — на
/// сервере, чтобы после перехода страницы план продолжился и ни один
/// `dispatched`-шаг не повторился. Снимок страницы НЕ хранится (§5-бис.3
/// п.2) — только шаги с описанием целей; текст команды — маскированный.
/// Пишет публичный код (роль assist_public), удаляется каскадом с диалогом
/// (ретенция диалогов §6.3, «удалить мой диалог»). «Админка» — своя модель
/// `assist_admin_ui_plans` в Э6-бис (б), не эта (аудит 1.2, У-17).
model AssistSiteUiPlan {
  id              String                 @id @default(cuid())
  accountId       String
  siteId          String
  conversationId  String
  conversation    AssistSiteConversation @relation(fields: [conversationId, accountId], references: [id, accountId], onDelete: Cascade)
  /// Чей план: исполнять/подтверждать/останавливать — только этот посетитель.
  visitorId       String
  /// Команда — маскированной (`maskSensitiveEcho`), ≤ 600.
  utteranceMasked String
  /// voice — с годным билетом голоса; typed — набрано в поле iframe.
  source          String
  lang            String?
  /// Страница, где отдана команда (без query).
  pageUrl         String
  /// Проверенные шаги (`UiPlanStep[]`) и состояние каждого (dispatched/done…).
  /// Значения полей здесь — МАСКИРОВАННЫЕ (аудит Э6-бис, минимизация ПД).
  steps           Json
  /// Пока план живой — сырые значения шагов и текст команды
  /// (`{ u: команда, v: [значение шага i | null] }`): нужны исполнителю и
  /// продолжению после перехода (телефон/e-mail сверяются посимвольно).
  /// Обнуляется при завершении, стопе, отказе и истечении (публичный код —
  /// в том же UPDATE, что статус; крон ретенции — у истёкших без визита).
  liveValues      Json?
  currentStep     Int                    @default(0)
  /// proposed | confirmed | running | paused | done | stopped | failed | expired
  status          String                 @default("proposed")
  needsConfirm    Boolean
  /// voice | button | auto — кто и как подтвердил (§5-бис.9).
  confirmedBy     String?
  /// Окно подтверждения — 60 с (§5-бис.5, как CONSENT_WINDOW_MS TMA).
  confirmBefore   DateTime
  /// План живёт 10 минут (§4-бис.2: незавершённое подтверждение).
  expiresAt       DateTime
  /// (г) План тестовой сессии мастера Т-2 (assist_site_voice_tests.id): в
  /// метрики монитора Т-4 не идёт, диалоги тарифа не тратит.
  voiceTestId     String?
  /// (г) Сухой прогон мастера: план построен и проверен, цели только
  /// подсвечиваются — исполнения нет (статус сразу `done`).
  dryRun          Boolean                @default(false)
  /// (г) Выпуск чанков виджета, на котором построен план (канарейка
  /// загрузчика: доля `done` канарейки против стабильного).
  release         String?
  /// (е) Кто построил шаги: model — модель по снимку; direct — прямой путь
  /// без модели; memo — опубликованное мемо (§5-бис.17 п.5). Не путать с
  /// `source` (откуда команда: voice/typed).
  planOrigin      String                 @default("model")
  /// (е) Мемо и ЗАКРЕПЛЁННАЯ версия: новая версия идущий план не меняет.
  memoId          String?
  memoVersion     Int?
  /// (е) Отпечаток слотов (хеш, без значений) — «повторить ещё раз?» в 60 с.
  memoSlotsHash   String?
  /// (е) Номер первого шага проверки цели мемо (`goal.expect`), null — нет.
  goalFrom        Int?
  /// (е) reached | not_reached | unknown — итог цели мемо.
  goalStatus      String?
  /// (д) clean | committed | kept | compensated | partially_compensated |
  /// unknown — что осталось на сайте после плана (§5-бис.15 п.11).
  chainStatus     String?
  /// (д) С какого шага показана последняя карточка «Да/Нет» — второе «Да»
  /// перед точкой невозврата, если между ними был переход (Р-60).
  cardFrom        Int                    @default(0)
  /// (д) Отдельное «Да» прямо перед точкой невозврата получено.
  pnrConfirmedAt  DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  actions AssistSiteUiActionLog[]

  @@unique([id, accountId])
  @@index([siteId, createdAt])
  @@index([voiceTestId])
  @@index([siteId, memoId, createdAt])
  @@index([siteId, visitorId, createdAt])
  @@index([conversationId])
  @@index([accountId])
  @@map("assist_site_ui_plans")
}

/// Журнал шагов голосового управления «Сайта» (§5-бис.9): план, шаг,
/// действие, ОПИСАНИЕ цели (роль, видимый текст, `data-assist-id`, путь),
/// страница, класс риска, кто подтвердил, итог, длительность. Значения
/// полей — маскированные. Только дописывается (у роли — INSERT); срок — по
/// ретенции диалогов (каскад с планом). Точка расширения Т-4 (§5-бис.14,
/// часть (г)): метрики `done`/«не туда»/«нажмите сами» считаются отсюда.
model AssistSiteUiActionLog {
  id          String           @id @default(cuid())
  accountId   String
  siteId      String
  planId      String
  plan        AssistSiteUiPlan @relation(fields: [planId, accountId], references: [id, accountId], onDelete: Cascade)
  stepIndex   Int
  /// scroll | click | fill | select | check | wait | highlight | say | plan | stop
  action      String
  /// { role, text, assistId, path } — без значений полей.
  target      Json?
  /// Страница шага (без query).
  url         String?
  risk        String
  confirmedBy String?
  /// dispatched | done | skipped | failed | stopped | manual | proposed
  result      String
  reason      String?
  valueMasked String?
  durationMs  Int?
  /// (е) Живая цель не совпала с закреплённым отпечатком шага мемо.
  pinMismatch Boolean          @default(false)
  /// (д) Строка возврата (`action: undo`) — номер возвращённого шага плана.
  undoOf      Int?
  /// (Э6-тер) Ключ цели голосовой карты, по которой найден элемент шага.
  mapKey      String?
  /// (Э6-тер) Команда назвала цель карты, а в снимке её не нашлось (Т-4).
  mapMiss     Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([planId])
  @@index([siteId, createdAt])
  @@index([accountId])
  @@map("assist_site_ui_action_log")
}

// ═══ Э6-бис (е): мемо «Сайта» — именованные цепочки действий с целью
// (ТЗ помощника §5-бис.17–18; Р-61, Р-62). «Админка» — свои таблицы
// `assist_admin_memo*` в Э8, не эти (К-9). ═══

/// Мемо сайта: номер `М-N` (из `assist_sites.memoCounter`, не
/// переиспользуется), ключ (неизменен после первой публикации), черновик с
/// ревизией (409 при расхождении), опубликованная версия. Пишет только
/// кабинет (основная роль); публичный код читает ТОЛЬКО представление
/// `assist_site_memo_published` (миграция), черновиков и истории не видит.
model AssistSiteMemo {
  id               String                  @id @default(cuid())
  accountId        String
  siteId           String
  site             Site                    @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  /// М-N — порядковый в сайте; удалённый номер не освобождается.
  number           Int
  /// `[a-z0-9-]{2,40}` — уникален в сайте; занят и после удаления (180 дней).
  key              String
  /// draft | checking | published | held | needs_review | disabled | removed
  status           String                  @default("draft")
  publishedVersion Int?
  draftRevision    Int                     @default(0)
  /// Черновик содержимого (assist-ui-core/memo.ts `MemoContent`).
  draft            Json
  /// «Я умею» посетителю (В-74, Р-72): по умолчанию — да.
  listed           Boolean                 @default(true)
  /// any | desktop | mobile — вид вёрстки, где мемо проверено.
  view             String                  @default("any")
  /// Виды, где элемент шага устарел (Ш4): там мемо не исполняется (§5-бис.17 п.8).
  staleViews       String[]                @default([])
  /// manual | plan | suggestion | recording | tutorial | template | import
  origin           String
  /// Почему `needs_review`/`disabled`: { code, step?, at }.
  reviewReason     Json?
  createdBy        String
  updatedBy        String
  removedAt        DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  versions         AssistSiteMemoVersion[]
  changes          AssistSiteMemoChange[]

  @@unique([siteId, number])
  @@unique([siteId, key])
  @@unique([id, accountId])
  @@index([accountId])
  @@map("assist_site_memos")
}

/// Неизменяемая версия мемо (свои версии у каждого мемо, Р-61): сборка →
/// ворота кода → сухой прогон мастером → подтверждение в TMA. Откат —
/// новая версия с содержимым N и новым прогоном. Последние 20 на мемо.
model AssistSiteMemoVersion {
  id          String         @id @default(cuid())
  accountId   String
  siteId      String
  site        Site           @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  memoId      String
  memo        AssistSiteMemo @relation(fields: [memoId, accountId], references: [id, accountId], onDelete: Cascade)
  number      Int
  /// building | checking | published | held | discarded
  status      String
  /// Содержимое с отпечатками целей и вычисленным кодом (`computed`).
  content     Json
  contentHash String
  gateReport  Json?
  /// { result: pass | partial | fail, pages, problems } — сухой прогон.
  checkReport Json?
  checkId     String?
  /// Версия-источник отката (`rollback` — новая версия с содержимым N).
  rollbackOf  Int?
  requestedBy String
  publishedBy String?
  createdAt   DateTime       @default(now())
  publishedAt DateTime?

  @@unique([memoId, number])
  @@index([siteId])
  @@index([accountId])
  @@map("assist_site_memo_versions")
}

/// История операций черновика: кто, когда, источник, что изменено (без
/// значений слотов — их в мемо нет). 180 дней (ретенция помощника).
model AssistSiteMemoChange {
  id        String         @id @default(cuid())
  accountId String
  siteId    String
  site      Site           @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  memoId    String
  memo      AssistSiteMemo @relation(fields: [memoId, accountId], references: [id, accountId], onDelete: Cascade)
  revision  Int
  actor     String
  /// tma | editor | plan | tutorial | template | import | suggestion | rollback
  source    String
  op        Json
  createdAt DateTime       @default(now())

  @@index([siteId, createdAt])
  @@index([memoId])
  @@index([accountId])
  @@map("assist_site_memo_changes")
}

/// Индекс фраз сайта (§5-бис.17 п.2, п.12): одна нормализованная фраза
/// (язык) — ровно одна сущность (`memo:<id>` | `target:<id>` голосовой карты
/// Э6-тер). Пишет публикация (основная роль): уникальный ключ ловит гонку
/// двух публикаций с одной фразой. Только опубликованное.
model AssistSitePhrase {
  siteId    String
  accountId String
  site      Site     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  lang      String
  norm      String
  owner     String
  /// memo-name | memo-trigger | target-name | target-synonym
  kind      String
  createdAt DateTime @default(now())

  @@id([siteId, lang, norm])
  @@index([accountId])
  @@index([siteId, owner])
  @@map("assist_site_phrases")
}

// ═══ Э6-тер: голосовая карта «Сайта» — визуальный редактор голосового
// управления (ТЗ помощника §5-кватер; Р-51…Р-54, Р-73…Р-82). «Админка» —
// свои таблицы `assist_admin_voice_map*` после Э6-бис (б) (К-9), не эти. ═══

/// Голосовая карта сайта: черновик (assist-ui-core/voice-map.ts
/// `VoiceMapContent`: цели, шаблоны страниц, термины) с ревизией (409 при
/// расхождении — две вкладки), номер опубликованной версии. Пишет только
/// кабинет и сессия редактора (основная роль); публичный код читает ТОЛЬКО
/// представление `assist_site_voice_map_published` (миграция).
model AssistSiteVoiceMap {
  siteId           String   @id
  accountId        String
  site             Site     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  /// Опубликованная версия (0 — карты нет: снимок + модель, В-53).
  publishedVersion Int      @default(0)
  /// Последний выданный номер версии.
  versionSeq       Int      @default(0)
  draftRevision    Int      @default(0)
  draft            Json
  /// Применённый шаблон платформы (`woocommerce@1`), если был.
  platformTemplate String?
  /// «Сказать сейчас»: проверки за сутки (день UTC и счётчик).
  tryDay           String?
  tryCount         Int      @default(0)
  /// Запросы публикации из сессии редактора за сутки (день UTC и счётчик;
  /// аудит Э6-тер (2): каждый — версия и сообщение в бот).
  publishReqDay    String?
  publishReqCount  Int      @default(0)
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([siteId, accountId])
  @@index([accountId])
  @@map("assist_site_voice_maps")
}

/// Неизменяемая версия карты: сборка → ворота кода (`held`) → запрос
/// публикации → подтверждение человеком в TMA (В-50). Откат — новая версия
/// с содержимым N. Последние 20; метаданные — 180 дней.
model AssistSiteVoiceMapVersion {
  id           String    @id @default(cuid())
  accountId    String
  siteId       String
  site         Site      @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  number       Int
  /// building | checking | published | held | discarded
  status       String
  content      Json
  contentHash  String
  gateReport   Json?
  rollbackOf   Int?
  requestedBy  String
  /// editor | tma — откуда пришёл запрос публикации.
  requestedVia String
  publishedBy  String?
  createdAt    DateTime  @default(now())
  publishedAt  DateTime?

  @@unique([siteId, number])
  @@index([accountId])
  @@map("assist_site_voice_map_versions")
}

/// Журнал изменений черновика: кто, когда, источник
/// (`editor|tma|import|template|suggestion|rollback`), что (без подписей
/// страницы и значений полей). 180 дней.
model AssistSiteVoiceMapChange {
  id        String   @id @default(cuid())
  accountId String
  siteId    String
  site      Site     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  revision  Int
  actor     String
  source    String
  op        Json
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
  @@index([accountId])
  @@map("assist_site_voice_map_changes")
}

/// Ссылка и сессия редактора (§5-кватер.2–3, §5-кватер.11 п.3): ссылка —
/// одноразовая, 10 мин, только verified-хост «Сайта» без льготы; сессия —
/// 30 мин скользящих, ≤ 4 ч; привязка к сайту, хосту, origin родителя,
/// участнику и его праву. Токены — только SHA-256.
model AssistSiteVoiceMapEditorSession {
  id                   String    @id @default(cuid())
  accountId            String
  siteId               String
  site                 Site      @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  memberId             String
  hostId               String
  host                 String
  parentOrigin         String
  pagePath             String    @default("/")
  /// Цель, открытая по ссылке из TMA (`focus`, находка Т-3/Т-4).
  focusKey             String?
  linkTokenHash        String    @unique
  sessionTokenHash     String?   @unique
  linkExpiresAt        DateTime
  exchangedAt          DateTime?
  expiresAt            DateTime?
  absoluteExpiresAt    DateTime?
  lastSeenAt           DateTime?
  revokedAt            DateTime?
  revokeReason         String?
  /// Последний запрос публикации из этой сессии (не чаще 1 в минуту).
  lastPublishRequestAt DateTime?
  createdAt            DateTime  @default(now())

  @@index([siteId])
  @@index([accountId])
  @@map("assist_site_voice_map_editor_sessions")
}

/// Э6-бис (г): проверка голосового управления на сайте заказчика — мастер
/// Т-2 (`wizard`; Т-3 `autotest` — с общим QA-воркером, отложен). Строка
/// создаётся кабинетом вместе с одноразовой ссылкой (`tokenHash`, 30 мин),
/// iframe меняет ссылку на тестовую сессию (`sessionHash`, 30 мин,
/// привязка к посетителю) и сдаёт отчёт (`report`, `result`); вердикт
/// считает КОД (assist-ui-core/wizard.ts), безопасные прогоны — по планам
/// этой сессии в базе, запреты — заново по снимку. Сырых значений и ПД нет:
/// подписи элементов — маскированные, токены — только хешами.
model AssistSiteVoiceTest {
  id               String    @id @default(cuid())
  accountId        String
  siteId           String
  site             Site      @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  /// wizard | autotest | memo (Э6-бис (е): сухой прогон версии мемо)
  kind             String    @default("wizard")
  /// Подтверждённый хост сайта, на котором идёт проверка, и его origin.
  host             String
  origin           String
  /// Хост отмечен владельцем «тестовый» (staging): отправка форм — только тут.
  testHost         Boolean   @default(false)
  /// memberId кабинета, выдавшего ссылку.
  startedBy        String?
  tokenHash        String    @unique
  tokenExpiresAt   DateTime
  usedAt           DateTime?
  sessionHash      String?   @unique
  sessionExpiresAt DateTime?
  visitorId        String?
  /// Выпуск чанков виджета на момент отчёта («до смены загрузчика»).
  release          String?
  /// Проверенные страницы (пути) и отпечаток их разметки.
  pages            Json?
  /// Отчёт мастера (форма — assist-ui-core/wizard.ts `WizardReport`).
  report           Json?
  /// pass | partial | fail
  result           String?
  /// Годен для включения `on` до (30 дней от отчёта).
  validUntil       DateTime?
  reportedAt       DateTime?
  /// `partial`: владелец подтвердил «понимаю, часть команд — „нажмите сами“».
  partialAckBy     String?
  partialAckAt     DateTime?
  /// Э6-бис (е): сухой прогон мемо (`kind = memo`) — проверяемая версия
  /// (assist_site_memo_versions.id); отчёт — в `report`/`result`.
  memoVersionId    String?
  createdAt        DateTime  @default(now())

  @@index([siteId, createdAt])
  @@index([accountId])
  @@map("assist_site_voice_tests")
}

/// Э6-бис (г): контрольные команды сайта (§5-бис.13) — из отчёта мастера
/// (`wizard`) и самые частые успешные команды боя (`production_top`, ≤ 20).
/// Формулировка — маскированная, цели — только дескрипторы (роль, видимый
/// текст, `data-assist-id`). Их разрешает Т-3 (общий QA-воркер — отложен).
model AssistSiteVoiceControlCommand {
  id              String    @id @default(cuid())
  accountId       String
  siteId          String
  site            Site      @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  testId          String?
  pagePath        String
  utteranceMasked String
  lang            String?
  /// [{ kind, role, text, assistId }] — дескрипторы целей шагов.
  expected        Json
  /// wizard | production_top
  origin          String
  lastCheckedAt   DateTime?
  lastResult      String?
  createdAt       DateTime  @default(now())

  @@unique([siteId, origin, pagePath, utteranceMasked])
  @@index([accountId])
  @@map("assist_site_voice_control_commands")
}

/// Э6-бис (г): журнал монитора Т-4 (§5-бис.14) — тревоги, авто-деградация,
/// выключение при нарушении запрета, конец переходного периода, откат
/// канарейки, рубильник платформы. `siteId` null — событие платформы.
/// Без внешнего ключа (события платформы — без сайта); срок — 90 дней
/// (чистит сам монитор).
model AssistSiteVoiceIncident {
  id        String   @id @default(cuid())
  accountId String?
  siteId    String?
  /// alert | degraded | off | transition | rollback | platform_off
  kind      String
  /// Причина: done_low, self_high, not_found_high, stoplist_live, violation, …
  code      String
  metrics   Json?
  /// Сколько получателей получили сообщение (владельцы + служебный канал).
  notified  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([siteId, createdAt])
  @@index([createdAt])
  @@map("assist_site_voice_incidents")
}

/// Решение владельца 03.10.2026 п.4: точечный переобход страницы, элементы
/// карты которой устарели (Ш4) — только эта страница, ≤ 1 раза в сутки на
/// страницу, ≤ N страниц в сутки на сайт по тарифу (Start 0, Business 5,
/// Pro 20), за счёт бюджета знаний сайта. Журнал — для лимитов и сводки TMA.
model AssistSiteUiRecrawl {
  id            String   @id @default(cuid())
  accountId     String
  siteId        String
  site          Site     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  host          String
  path          String
  staleElements Int
  /// requested | budget (бюджет знаний исчерпан — повтор завтра)
  status        String
  runId         String?
  createdAt     DateTime @default(now())

  @@index([siteId, createdAt])
  @@index([accountId])
  @@map("assist_site_ui_recrawls")
}

// ═══ Э6: видео-ответы и «показать на экране» (ТЗ §4.9, §4.11, §4.12; план,
// Приложение А «Этап 6») ═══

/// Ролик обучалки генератора, привязанный к сайту помощника (§4.11). Пишет
/// ТОЛЬКО внутренний API генератора (`internal-sites/site-media.*`, HMAC):
/// полный набор одобренных оператором роликов сайта, после проверки, что
/// хозяин черновика — владелец или менеджер помощника в кабинете сайта.
/// Владелец включает показ посетителям (`enabled`, по умолчанию выкл.).
/// `url` — ссылка Blob генератора: посетителю не отдаётся никогда, только
/// подписанная короткоживущая ссылка `GET /widget/v1/video/:token`.
model AssistSiteVideo {
  id              String   @id @default(cuid())
  accountId       String
  siteId          String
  site            Site     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  /// TutorialVideoAsset.id генератора (без связи между базами).
  externalId      String
  /// ClientSiteTutorialDraft.id генератора.
  draftId         String
  /// Хозяин черновика (проверен членством при каждой синхронизации).
  ownerTelegramId BigInt
  title           String
  locale          String
  durationMs      Int?
  url             String
  /// Закрытый отказ (§4.3-бис, У-7): ролик снят за логином, на хосте не
  /// `verified` этого сайта или признак неизвестен — посетителям не
  /// предлагается никогда, даже если владелец включил.
  requiresLogin   Boolean  @default(true)
  /// «Показывать в виджете» — решение владельца (TMA → «Видео»).
  enabled         Boolean  @default(false)
  syncedAt        DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([siteId, externalId])
  @@index([siteId, enabled])
  @@index([accountId])
  @@map("assist_site_videos")
}

/// Карта интерфейса страницы (§4.12 «показать на экране»; аудит слияния
/// §3.2 — `site_ui_maps`, Ш4): селекторы интерактивных элементов по
/// (сайт, хост, путь) и их подписи. Источники: обход (`crawl`, разбор HTML
/// тем же приоритетом селектора, что `PageExploration` обучалки) и раунды
/// обучалки генератора (`tutorial`, внутренний API). Ш4 расширит таблицу
/// (голос Э6-бис, редактор Э6-тер, Flow-QA) — потребители читают `elements`.
/// `staleSignals`/`lastStaleAt` — сигнал «карта устарела»: загрузчик не
/// нашёл элемент на странице (вёрстка сменилась).
model SiteUiMap {
  id           String    @id @default(cuid())
  accountId    String
  siteId       String
  site         Site      @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  hostId       String
  hostRow      SiteHost  @relation(fields: [hostId, accountId], references: [id, accountId], onDelete: Cascade)
  /// Хост без `www.`, нижним регистром (ключ поиска по странице посетителя).
  host         String
  /// Путь без query и фрагмента, без концевого `/` (кроме корня).
  path         String
  /// crawl | tutorial | loader | qa | manual (Ш4 — site-core/ui-map/ui-map-model.ts)
  source       String
  /// Ш4: вид вёрстки снимка — any (обход без браузера) | desktop | mobile.
  viewport     String    @default("any")
  /// Ш4: номер набора — растёт, когда набор элементов меняется; прежние
  /// наборы — в site_ui_map_versions (история, а не перезапись).
  version      Int       @default(1)
  /// [{ id, selector, tag, label, key?, candidates?, stability? }] — форма в
  /// site-core/ui-map (Э6-читатели берут id/selector/tag/label).
  elements     Json
  elementsHash String
  capturedAt   DateTime
  /// Э6: принятых сигналов «элемент не найден» на этой странице (справочно;
  /// Ш4 решает об устаревании по ЭЛЕМЕНТУ — site_ui_elements).
  staleSignals Int       @default(0)
  lastStaleAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([siteId, host, path, source, viewport])
  @@index([hostId])
  @@index([accountId])
  @@map("site_ui_maps")
}

/// Э-С Ш4: история карты страницы — каждый принятый НОВЫЙ набор элементов
/// источника (сайт, хост, путь, источник, вид). Срок и число версий —
/// крон site-ui-map-maintenance (UI_MAP_SHARED в site-core/ui-map).
model SiteUiMapVersion {
  id           String   @id @default(cuid())
  accountId    String
  siteId       String
  site         Site     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  hostId       String
  hostRow      SiteHost @relation(fields: [hostId, accountId], references: [id, accountId], onDelete: Cascade)
  host         String
  path         String
  source       String
  viewport     String
  version      Int
  elements     Json
  elementsHash String
  elementCount Int
  capturedAt   DateTime
  createdAt    DateTime @default(now())

  @@unique([siteId, host, path, source, viewport, version])
  @@index([hostId])
  @@index([accountId])
  @@index([createdAt])
  @@map("site_ui_map_versions")
}

/// Э-С Ш4: элемент страницы, СЛИТЫЙ из снимков всех источников по
/// стабильному ключу (`elementKey`: data-assist-id > id > test-id > роль+имя
/// > текст > css-путь) — один на (сайт, хост, путь, вид). Его читают
/// подсветка (Э6), голос (Э6-бис), редактор (Э6-тер) и Flow-QA; на нём же —
/// промахи и устаревание по виду вёрстки.
model SiteUiElement {
  id               String              @id @default(cuid())
  accountId        String
  siteId           String
  site             Site                @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  hostId           String
  hostRow          SiteHost            @relation(fields: [hostId, accountId], references: [id, accountId], onDelete: Cascade)
  host             String
  path             String
  /// any | desktop | mobile — вид снимков, из которых слит элемент.
  viewport         String
  elementKey       String
  /// `u` + 8 hex — id элемента для виджета (от лучшего CSS-селектора).
  elementId        String
  tag              String
  label            String
  role             String?
  /// Лучший CSS-кандидат (подсветка Э6); null — только роль/текст.
  selector         String?
  /// [{ kind, selector?, role?, name? }] — по убыванию надёжности.
  candidates       Json
  /// strong | medium | fragile
  stability        String
  /// 0–100: надёжность селектора + источники.
  confidence       Int
  sources          String[]
  /// Ранг лучшего источника (manual 0 … crawl 3) и место в его снимке —
  /// порядок выдачи (E1…En в промпте).
  sourceRank       Int
  position         Int
  firstSeenAt      DateTime
  lastSeenAt       DateTime
  /// Промахи посетителей по виду: окно `miss*Since`, порог — UI_MAP_STALE.
  missCountDesktop Int                 @default(0)
  missSinceDesktop DateTime?
  staleDesktopAt   DateTime?
  missCountMobile  Int                 @default(0)
  missSinceMobile  DateTime?
  staleMobileAt    DateTime?
  lastMissAt       DateTime?
  /// Голоса «найден» от снимков загрузчика (данные посетителя) по виду: тот
  /// же порог и окно, что промахи; набрался порог — промахи и «устарел»
  /// вида сняты (мгновенный сброс — только браузерные источники сервера).
  seenCountDesktop Int                 @default(0)
  seenSinceDesktop DateTime?
  seenCountMobile  Int                 @default(0)
  seenSinceMobile  DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  misses           SiteUiElementMiss[]

  @@unique([siteId, host, path, viewport, elementKey])
  /// Цель составного ключа журнала промахов (elementRowId, accountId).
  @@unique([id, accountId])
  @@index([siteId, host, path])
  @@index([hostId])
  @@index([accountId])
  @@map("site_ui_elements")
}

/// Э-С Ш4: журнал принятых промахов и голосов «найден» (защита от
/// накрутки): один голос каждого рода на элемент и вид от одного посетителя
/// и от одного хеша IP. Хеш IP — с солью на окно устаревания (неделя), а не
/// суточной: «разные IP за 7 дней» не обходится сменой суток. Срок — окно
/// устаревания (крон site-ui-map-maintenance).
model SiteUiElementMiss {
  id           String        @id
  accountId    String
  siteId       String
  elementRowId String
  element      SiteUiElement @relation(fields: [elementRowId, accountId], references: [id, accountId], onDelete: Cascade)
  /// desktop | mobile
  viewport     String
  /// miss — «не найден» по квитанции показа; seen — снимок загрузчика нашёл.
  kind         String        @default("miss")
  ipHash       String
  visitorId    String
  createdAt    DateTime      @default(now())

  @@unique([elementRowId, viewport, kind, ipHash])
  @@unique([elementRowId, viewport, kind, visitorId])
  @@index([createdAt])
  @@index([accountId])
  @@map("site_ui_element_misses")
}

// ── Э3-бис: аналитика с ИИ (ТЗ помощника §5-тер.3–5, §5-тер.8–10,
// §5-тер.14–17; план «Э3-бис — сделано»). Миграция
// 20261005220000_assist_ai_analytics. Всё — режим «Сайт» (У-23…У-27):
// таблиц «Админки» здесь нет.

/// Разметка закрытого диалога дешёвой моделью (Р-43) и lead score кодом
/// (Р-44). Вход модели — только замаскированный текст; поля — перечни,
/// проверенные кодом (assist-analytics/ai/label-schema.ts). Живёт и
/// удаляется с диалогом (FK каскад: forget, ретенция — §5-тер.15).
model AssistSiteConversationLabel {
  conversationId String                 @id
  accountId      String
  siteId         String
  conversation   AssistSiteConversation @relation(fields: [conversationId, accountId], references: [id, accountId], onDelete: Cascade)
  site           Site                   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  /// ok | failed | injection_suspect | retry (временный сбой модели) |
  /// skipped (вне выборки при исчерпании бюджета, §5-тер.3)
  status         String
  model          String?
  promptVersion  String
  intent         String?
  intentNote     String?
  stage          String?
  buyingSignals  String[]
  /// Сырая оценка модели 0–100 — один из признаков, не score; при
  /// подозрении на инъекцию — null (не учитывается).
  llmLikelihood  Int?
  outcome        String?
  failureReason  String?
  failureNote    String?
  sentimentStart Int?
  sentimentEnd   Int?
  frustration    Boolean   @default(false)
  answerQuality  Int?
  qualityFlags   String[]
  topics         String[]
  /// Только названия из словаря сайта (заголовки документов) — кодом.
  entities       String[]
  /// Lead score 0–100 и корзина hot | warm | cold — считает КОД по признакам.
  leadScore      Int?
  leadBucket     String?
  /// Объяснение score: [{ f: признак, c: вклад }] — без текста посетителя.
  leadFeatures   Json?
  /// Вероятность после калибровки сайта (Pro, ≥ 50 известных исходов).
  leadProb       Float?
  /// Вес выборки: 1 — разметка без выборки; 5 — «случайные 20%»; 0 — skipped.
  weight         Float     @default(1)
  attempts       Int       @default(0)
  /// Исправление владельцем/менеджером («неверно размечено», §5-тер.16).
  humanOverride  Json?
  overriddenBy   String?
  overriddenAt   DateTime?
  costMicroUsd   Int       @default(0)
  labeledAt      DateTime  @default(now())

  /// Цель 1:1 составного ключа с диалогом (Prisma требует уникальности).
  @@unique([conversationId, accountId])
  @@index([siteId, labeledAt])
  @@index([accountId])
  @@map("assist_site_conversation_labels")
}

/// Расход бюджета аналитики (`assist-label`, `assist-insight`) — месячный
/// потолок ПОДПИСКИ (Р-50, Р-58), доля сайта — поровну между сайтами
/// кабинета с помощником. Резерв — условный UPDATE до вызова модели.
model AssistAnalyticsSpend {
  accountId     String
  siteId        String
  site          Site     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  /// YYYY-MM (UTC).
  period        String
  spentMicroUsd BigInt   @default(0)
  updatedAt     DateTime @updatedAt

  @@id([siteId, period])
  @@index([accountId, period])
  @@map("assist_analytics_spend")
}

/// Калибровка lead score сайта (§5-тер.4): Platt по диалогам с ИЗВЕСТНЫМ
/// исходом; только Pro и только при ≥ 50 положительных и ≥ 200 размеченных.
model AssistSiteLeadCalibration {
  id        String   @id @default(cuid())
  accountId String
  siteId    String
  site      Site     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  version   Int
  /// prior | platt
  method    String
  /// { a, b } — p = 1 / (1 + exp(-(a·logit(score) + b))).
  params    Json
  positives Int
  total     Int
  auc       Float?
  brier     Float?
  ece       Float?
  createdAt DateTime @default(now())

  @@unique([siteId, version])
  @@index([accountId])
  @@map("assist_site_lead_calibrations")
}

/// Находка недели (код, Н-1…Н-11) и вывод модели по ней (Р-45): числа —
/// только из находки (проверка кодом), не прошло — `text` null и сухая строка.
model AssistSiteInsight {
  id           String    @id @default(cuid())
  accountId    String
  siteId       String
  site         Site      @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  /// Понедельник недели (YYYY-MM-DD, пояс сайта).
  weekStart    String
  /// Код находки: N2 | N3 | N4 | N5 | N7 | N8 | N10 (ТЗ Н-…).
  code         String
  /// Ключ дедупа внутри недели: `<code>:<измерение>`.
  findingKey   String
  /// Числа и измерения находки — кодом (n, доля, база, интервал Вильсона…).
  finding      Json
  /// high | medium | low — по доле затронутых просмотров/диалогов (код).
  impact       String
  /// { title, what, action } — текст модели; null — без модели/не прошёл проверку.
  text         Json?
  /// Почему текста нет: plan | budget | model | numbers | links | null.
  textSkipped  String?
  model        String?
  /// new | done | dismissed
  status       String    @default("new")
  doneAt       DateTime?
  /// Сравнение до/после через 14 дней после «Сделано» (совпадение во времени).
  followUp     Json?
  /// 👍 = 1, 👎 = -1.
  feedback     Int?
  costMicroUsd Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([siteId, weekStart, findingKey])
  @@index([siteId, weekStart])
  @@index([accountId])
  @@map("assist_site_insights")
}

/// Эксперимент сайта (§5-тер.2, Р-42; решение Э3-бис: только посетители с
/// согласием на аналитику): holdout (без виджета) | greeting | suggestions.
/// Фиксированный горизонт без подглядывания; SRM; авто-остановка.
model AssistSiteExperiment {
  id             String    @id @default(cuid())
  accountId      String
  siteId         String
  site           Site      @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  /// holdout | greeting | suggestions
  kind           String
  /// Ключ цели — основная метрика (у holdout — не встроенная заявка).
  goalKey        String
  /// Доля группы B (holdout — «без виджета», 0.05–0.2; варианты — 0.5).
  share          Float
  /// Соль назначения группы (не секрет: группа — не идентификатор).
  salt           String
  /// Вариант B: greeting — { uk?, ru?, en? }; suggestions — { uk?: [...], … }.
  variant        Json?
  /// running | done | invalid | stopped
  status         String
  horizonDays    Int
  /// Минимальный эффект (относительный), который эксперимент обязан увидеть.
  mdeRel         Float
  /// Нужно единиц на группу (α = 0.05, мощность 80%) — для «недостаточно данных».
  minUnitsPerArm Int
  /// Расчёт мощности на старте (база, единиц/сутки, ожидаемо к горизонту).
  power          Json
  startedAt      DateTime
  endsAt         DateTime
  stoppedAt      DateTime?
  /// horizon | srm | owner | plan
  stopReason     String?
  /// Итог — ТОЛЬКО после горизонта (без подглядывания).
  result         Json?
  srmP           Float?
  startedBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  units AssistSiteExperimentUnit[]

  @@index([siteId, status])
  @@index([status, endsAt])
  @@index([accountId])
  @@map("assist_site_experiments")
}

/// Единица эксперимента — посетитель с согласием (хеш ключа визита с солью
/// сайта). Пишет виджет (assist_public) при включении в эксперимент и при
/// конверсии основной цели. Удаляется вместе с экспериментом (через 30 дней
/// после итога — агрегаты остаются в `result`).
model AssistSiteExperimentUnit {
  experimentId String
  experiment   AssistSiteExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  unitHash     String
  /// a | b
  arm          String
  enrolledAt   DateTime             @default(now())
  converted    Boolean              @default(false)
  convertedAt  DateTime?

  @@id([experimentId, unitHash])
  @@map("assist_site_experiment_units")
}

/// Итог просмотра страницы (§5-тер.8, Р-46) — ТОЛЬКО с согласием на
/// аналитику (решение Э3-бис) и на Business+; без ввода, значений полей,
/// координат, отпечатка, click-id. Сырые — 7 дней, затем только свёртка.
model AssistSitePageView {
  /// pvId — случайный id просмотра из памяти документа (перезапись итога).
  id               String
  siteId           String
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD (UTC) — свёртка переводит в сутки сайта по startedAt.
  day              String
  startedAt        DateTime @default(now())
  path             String
  prevPath         String?
  /// direct | search | social | ads | messenger | link | email
  source           String
  refHost          String?
  utmCampaign      String?
  /// mobile | tablet | desktop
  device           String
  os               String
  browser          String
  scrollMax        Int      @default(0)
  activeMs         Int      @default(0)
  totalMs          Int      @default(0)
  clicks           Int      @default(0)
  rageClicks       Int      @default(0)
  jsErrors         Int      @default(0)
  /// ≤ 3 групп: { h: хеш, m: сообщение (маска, ≤ 120), s: хост скрипта }.
  errorGroups      Json?
  formStarted      Boolean  @default(false)
  formSubmitted    Boolean  @default(false)
  /// Имя поля, на котором ушли (name/id ≤ 30, без значения).
  formAbandonField String?
  formInvalid      Int      @default(0)
  backNav          Boolean  @default(false)
  lcpMs            Int?
  inpMs            Int?
  cls              Float?
  chatOpened       Boolean  @default(false)
  updatedAt        DateTime @default(now())

  @@id([siteId, id])
  @@index([siteId, day])
  @@index([day])
  @@map("assist_site_page_views")
}

/// Суточная свёртка поведения по страницам (топ-200 + «*») — отчёты и экран
/// читают только её; 13 мес (§5-тер.10).
model AssistSiteDailyPage {
  accountId      String
  siteId         String
  site           Site     @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)
  /// YYYY-MM-DD в поясе сайта.
  day            String
  path           String
  views          Int      @default(0)
  activeMsMedian Int      @default(0)
  scrollMedian   Int      @default(0)
  /// Просмотров с прокруткой ≥ 75%.
  deepScroll     Int      @default(0)
  backNav        Int      @default(0)
  rage           Int      @default(0)
  jsErrors       Int      @default(0)
  formStarts     Int      @default(0)
  formAbandons   Int      @default(0)
  /// Поле → число уходов (топ-5).
  abandonFields  Json     @default("{}")
  lcpP75         Int?
  inpP75         Int?
  clsP75         Float?
  chatOpens      Int      @default(0)
  computedAt     DateTime @default(now())

  @@id([siteId, day, path])
  @@index([accountId])
  @@map("assist_site_daily_pages")
}

// ══ Э-С Ш3: очередь браузерного воркера (pull-модель, lease + heartbeat) ══
//
// Воркер на изолированном VPS (без DSN, без входящих портов) сам забирает
// задания внутренним API `/internal/worker/v1/*` (HMAC, свой секрет
// `SITES_WORKER_HMAC_SECRET`), продлевает аренду heartbeat-ом и сдаёт
// результат. Параметры — без секретов (триггер ниже отвергает ключи вида
// password/secret/cookies): учётку Ш2 воркер получает отдельным запросом
// `credentials`, запечатанной под свой ключ. Роли assist_public — ничего.

/// Задание браузерного воркера: вид (ui-snapshot | admin-crawl |
/// descriptor-resolve | frames-capture), источник (кто поставил) и аренда.
model SiteBrowserJob {
  id        String @id @default(cuid())
  accountId String
  siteId    String
  site      Site   @relation(fields: [siteId, accountId], references: [id, accountId], onDelete: Cascade)

  hostId             String
  /// Хост того же кабинета (аудит Ш3: составной FK, как у site_pages).
  host               SiteHost  @relation(fields: [hostId, accountId], references: [id, accountId], onDelete: Cascade)
  kind               String
  /// voice-map-snapshot | voice-map-check | assist-admin-crawl | tutorial-frames
  origin             String
  /// Связанная сущность продукта (задание обхода «Админки», версия карты…).
  refId              String?
  params             Json
  /// admin-crawl: учётка реестра Ш2 (секреты — только запросом воркера).
  testAccountId      String?
  idempotencyKey     String?   @unique
  /// queued | running | done | failed | cancelled
  status             String    @default("queued")
  priority           Int       @default(0)
  attempts           Int       @default(0)
  maxAttempts        Int       @default(2)
  availableAt        DateTime  @default(now())
  leaseOwner         String?
  /// SHA-256 токена аренды (сам токен знает только воркер).
  leaseTokenHash     String?
  leaseUntil         DateTime?
  heartbeatAt        DateTime?
  /// Номер попытки, на которой секреты учётки уже выданы (один раз на попытку).
  credentialsAttempt Int?
  cancelRequestedAt  DateTime?
  result             Json?
  resultBytes        Int?
  errorCode          String?
  /// Кто поставил: `tg:<id>` | `generator:<id>` | `system` (без ПД).
  requestedBy        String?
  createdAt          DateTime  @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  expiresAt          DateTime
  updatedAt          DateTime  @updatedAt

  artifacts SiteBrowserArtifact[]

  @@unique([id, accountId])
  @@index([status, availableAt])
  @@index([accountId])
  @@index([siteId, origin, createdAt])
  @@index([expiresAt])
  @@map("site_browser_jobs")
}

/// Артефакт задания (скриншот/кадр) — приватный Blob со сроком жизни;
/// наружу — только подписанной ссылкой с коротким TTL.
model SiteBrowserArtifact {
  id          String         @id @default(cuid())
  accountId   String
  jobId       String
  /// Аудит Ш3: артефакт — того же кабинета, что задание (составной FK).
  job         SiteBrowserJob @relation(fields: [jobId, accountId], references: [id, accountId], onDelete: Cascade)
  idx         Int
  pathname    String
  contentType String
  bytes       Int
  sha256      String
  width       Int?
  height      Int?
  createdAt   DateTime       @default(now())
  expiresAt   DateTime

  @@unique([jobId, idx])
  @@index([accountId])
  @@index([expiresAt])
  @@map("site_browser_artifacts")
}
