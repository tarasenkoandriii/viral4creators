{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash ../scripts/vercel-ignore-build.sh .",
  "crons": [
    {
      "path": "/cron/site-ownership-recheck",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/cron/assist-crawl-run",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/cron/assist-embed-run",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/cron/assist-admin-embed-run",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/cron/assist-retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/cron/assist-budget-sweep",
      "schedule": "*/5 * * * *"
    }
  ]
}
