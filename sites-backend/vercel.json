{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash ../scripts/vercel-ignore-build.sh .",
  "crons": [
    {
      "path": "/cron/site-ownership-recheck",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/cron/assist-crawl-run",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/cron/assist-embed-run",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/cron/assist-admin-embed-run",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/cron/assist-retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/cron/assist-budget-sweep",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/cron/assist-handoff-tick",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/cron/assist-learn-rollup",
      "schedule": "20 5 * * *"
    },
    {
      "path": "/cron/assist-analytics-run",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/cron/assist-analytics-rollup",
      "schedule": "40 4 * * *"
    },
    {
      "path": "/cron/assist-digest",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/cron/assist-billing-tick",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/cron/site-credentials-retention",
      "schedule": "50 3 * * *"
    }
  ]
}
