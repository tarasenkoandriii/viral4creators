{
  "name": "sites-backend",
  "version": "0.1.0",
  "description": "Бэкенд клиентских сайтов: ядро site-core (кабинет, сайты, хосты, подтверждение владения), ИИ-помощник и QA",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && prisma migrate deploy && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma.config.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "sync-shared": "node ../scripts/sync-sites-shared.mjs",
    "sync-shared:check": "node ../scripts/sync-sites-shared.mjs --check",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "eval:platform": "ts-node src/modules/assist-site-chat/eval/run-live.ts",
    "eval:voice": "ts-node src/modules/assist-site-voice/eval/run-live.ts",
    "credentials:rotate": "ts-node src/modules/site-credentials/scripts/rotate-credential-keys.ts",
    "secrets:rotate": "ts-node src/common/scripts/rotate-assist-secrets.ts"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/blob": "^2.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "domhandler": "^5.0.3",
    "domutils": "^3.2.2",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "htmlparser2": "^10.1.0",
    "mammoth": "^1.13.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.1.13",
    "robots-parser": "^3.0.1",
    "rxjs": "^7.8.1",
    "tldts": "^6.1.86",
    "undici": "^7.30.0",
    "unpdf": "^1.8.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/../test/jest-env.setup.ts"
    ],
    "workerIdleMemoryLimit": "1024MB"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.5"
  }
}
