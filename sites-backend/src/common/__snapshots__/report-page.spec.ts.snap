exports[`эталон HTML отчётов (снимок) отчёт мастера (vc-report): кнопка, 404, отчёт; CSP 1`] = `
{
  "csp": "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'",
  "gone": "<!doctype html>
