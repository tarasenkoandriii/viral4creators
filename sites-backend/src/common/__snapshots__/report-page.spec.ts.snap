<table><tr><th>#</th><th>level</th><th>code</th><th>data</th></tr><tr><td>1</td><td>warn</td><td><code>c&lt;script&gt;&quot;&#39;&amp;&lt;/script&gt;</code></td><td>a=1, b=x&lt;script&gt;&quot;&#39;&amp;&lt;/script&gt;</td></tr></table>
