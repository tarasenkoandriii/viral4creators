# База API клиентских сайтов (sites-backend — отдельный Vercel-проект,
# контракт Э0 п.1). По умолчанию (переменная не задана) — `/api`:
# same-origin прокси, rewrite в assist/vercel.json. Веб-кабинету это
# обязательно — сессия живёт в HttpOnly-cookie sites-backend, и через тот
# же origin она не становится third-party cookie (Safari/Chrome их режут).
#
# ВЛАДЕЛЬЦУ: в assist/vercel.json замените плейсхолдер
#   https://sites-backend.example.invalid
# на адрес Production sites-backend (например https://<sites-backend>.vercel.app).
# Vercel не подставляет env в destination rewrite — адрес пишется в файл.
#
# Переопределять только для локального стенда без прокси, например:
#   VITE_SITES_API_URL=http://localhost:3010
# (`npm run dev` и так проксирует /api → localhost:3010, см. vite.config.ts)
# (клиент лишь дописывает пути /sites/... к этому адресу).
VITE_SITES_API_URL=

# Бот Помощника без «@» (тот же, чей токен — ASSIST_BOT_TOKEN в
# sites-backend): Telegram Login Widget веб-кабинета (data-telegram-login)
# и ссылки-приглашения t.me/<бот>?startapp=inv_…
# ВЛАДЕЛЬЦУ: в @BotFather → /setdomain для этого бота укажите домен
# веб-кабинета (Production assist), иначе виджет входа не отрисуется.
VITE_ASSIST_BOT_USERNAME=

# Публичный адрес sites-backend (https-origin без пути) — для адресов,
# которые заказчик вписывает на СВОЁМ сервере: вебхук целей s2s на экране
# «Интеграции» (плагин WordPress, npm ./server). Прод:
#   VITE_ASSIST_PUBLIC_API_ORIGIN=https://assist-api.viral4creators.app
# Не задан — абсолютный VITE_SITES_API_URL, иначе <origin кабинета>/api
# (rewrite assist/vercel.json: рабочий, но лишнее плечо через кабинет).
VITE_ASSIST_PUBLIC_API_ORIGIN=

# Дев-вход вне Telegram (только локальный стенд): заголовок X-Dev-User-Id
# вместо initData — зеркально dev-bypass бэкенда. Login Widget на localhost
# не работает (/setdomain не принимает localhost) — на стенде вход только
# так. В Vercel НЕ задавать.
VITE_ALLOW_DEV_AUTH=false
VITE_DEV_USER_ID=123
