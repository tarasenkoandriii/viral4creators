{
  "name": "v4c-assist-tma",
  "version": "0.1.0",
  "private": true,
  "description": "TMA ИИ-помощника для клиентских сайтов (ТЗ docs-tz/TZ-AI-Pomoshchnik-TMA.md §3)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "for f in scripts/*.test.ts; do echo \"── $f\"; npx tsx \"$f\" || exit 1; done",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "kit:sync": "node ../scripts/sync-site-tma-kit.mjs",
    "kit:check": "node ../scripts/sync-site-tma-kit.mjs --check",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\""
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@vercel/blob": "^2.8.0",
    "lucide-react": "^0.451.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^17.13.0",
    "postcss": "^8.4.32",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.0.8"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.6"
    },
    "@vercel/blob": {
      "undici": "^6.29.1"
    }
  }
}
