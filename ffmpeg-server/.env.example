# ffmpeg-server — пример .env для контейнера api (docker-compose.yml).
# Секретов здесь НЕТ: значения генерируются по docs/OPERATIONS.md §5 и
# хранятся только в secret store площадки. Executor .env не получает.

# ── сборка (обязательно; docs/OPERATIONS.md §1) ────────────────────────
# sha256 дайджест node:24-bookworm-slim (multi-arch index), без префикса образа.
FFMPEG_SERVER_NODE_DIGEST=sha256:<заполнить>
# Точная версия Debian bookworm пакета ffmpeg (apt-cache policy ffmpeg).
FFMPEG_SERVER_FFMPEG_DEB=<заполнить>
# Дайджест собранного образа api/executor — для GET /api/jobs (image_digest).
FFMPEG_SERVER_IMAGE_DIGEST=
# Каталог хоста на отдельной ФС фиксированного размера (loop xfs) под workspace.
FFMPEG_SERVER_WORKSPACE_HOST_DIR=/srv/ffmpeg-quota/workspace

# ── адрес ──────────────────────────────────────────────────────────────
FFMPEG_SERVER_PUBLIC_BASE_URL=https://ffmpeg.viral4creators.app

# ── клиенты: только sha256 ключей, до двух на клиента (ротация) ─────────
# [{"clientId":"backend","role":"client","keySha256":["<sha256 hex>"]},
#  {"clientId":"backend-ops","role":"ops","keySha256":["<sha256 hex>"]}]
FFMPEG_SERVER_CLIENTS=

# ── шифрование payload (AES-256-GCM) и HMAC fingerprint ────────────────
# JSON {keyId: base64(32 байта)}; активный id — отдельной переменной.
# Старые ключи держать, пока живут задачи/ключи идемпотентности (90 дней).
FFMPEG_SERVER_PAYLOAD_KEYS=
FFMPEG_SERVER_PAYLOAD_KEY_ACTIVE=
FFMPEG_SERVER_HMAC_KEYS=
FFMPEG_SERVER_HMAC_KEY_ACTIVE=

# ── источники входов: точные хосты или *.suffix через запятую ──────────
# Сверить с реальными хранилищами входов (Vercel Blob, backend-маршруты).
FFMPEG_SERVER_INPUT_ALLOWED_HOSTS=

# ── очередь и диск (умолчания — ТЗ §9) ─────────────────────────────────
FFMPEG_SERVER_MAX_QUEUED=20
FFMPEG_SERVER_MAX_QUEUED_PER_CLIENT=10
# 15 GiB / 15 GiB / 10 GiB
FFMPEG_SERVER_DISK_MIN_FREE_BYTES=16106127360
FFMPEG_SERVER_DISK_MAX_WORKSPACES_BYTES=16106127360
FFMPEG_SERVER_DISK_MAX_OUTPUTS_BYTES=10737418240

# ── сроки ──────────────────────────────────────────────────────────────
FFMPEG_SERVER_OUTPUT_TTL_SEC=86400
FFMPEG_SERVER_DOWNLOAD_TOKEN_TTL_SEC=1800
FFMPEG_SERVER_HISTORY_DAYS=90
FFMPEG_SERVER_TOMBSTONE_DAYS=90

# ── верхние границы лимитов профиля (ТЗ §9; ops меняет ниже них) ───────
# Имя: FFMPEG_SERVER_LIMIT_<SNAKE_CASE поля LimitsProfile>. Пусто = ТЗ §9.
# FFMPEG_SERVER_LIMIT_MAX_INPUTS=20
# FFMPEG_SERVER_LIMIT_MAX_COMMANDS=10
# FFMPEG_SERVER_LIMIT_MAX_OUTPUTS=10
# FFMPEG_SERVER_LIMIT_MAX_COMMANDS_TEXT_BYTES=131072
# FFMPEG_SERVER_LIMIT_MAX_INPUT_BYTES=536870912
# FFMPEG_SERVER_LIMIT_MAX_TOTAL_INPUT_BYTES=1073741824
# FFMPEG_SERVER_LIMIT_MAX_TOTAL_OUTPUT_BYTES=536870912
# FFMPEG_SERVER_LIMIT_MAX_WORKSPACE_BYTES=4294967296
# FFMPEG_SERVER_LIMIT_MAX_WIDTH=1920
# FFMPEG_SERVER_LIMIT_MAX_HEIGHT=1080
# FFMPEG_SERVER_LIMIT_MAX_FPS=60
# FFMPEG_SERVER_LIMIT_MAX_INPUT_DURATION_SEC=600
# FFMPEG_SERVER_LIMIT_MAX_IMAGE_PIXELS=24000000
# FFMPEG_SERVER_LIMIT_PIPELINE_DEADLINE_SEC=900
# FFMPEG_SERVER_LIMIT_QUEUE_DEADLINE_SEC=1200
# FFMPEG_SERVER_LIMIT_DOWNLOAD_FILE_DEADLINE_SEC=120
# FFMPEG_SERVER_LIMIT_DOWNLOAD_CONNECT_TIMEOUT_SEC=10
# FFMPEG_SERVER_LIMIT_DOWNLOAD_STALL_TIMEOUT_SEC=15
# FFMPEG_SERVER_LIMIT_MAX_THREADS=2
# FFMPEG_SERVER_LIMIT_STDERR_TAIL_BYTES=65536

# ── backup SQLite (compose задаёт FFMPEG_SERVER_BACKUP_DIR=/backup) ──
FFMPEG_SERVER_BACKUP_INTERVAL_SEC=900
FFMPEG_SERVER_BACKUP_RETENTION_DAYS=7

# ── сеть и приём ───────────────────────────────────────────────────────
# Адрес прослушивания внутри контейнера (порт — FFMPEG_SERVER_PORT, 8080).
FFMPEG_SERVER_HOST=0.0.0.0
# Дедлайн фиксации POST: позже этого срока от получения запроса задача НЕ
# создаётся (503 SUBMIT_DEADLINE). Клиентский тайм-аут submit должен быть
# больше: тогда by-key 404 после тайм-аута доказывает «не принято».
FFMPEG_SERVER_SUBMIT_COMMIT_DEADLINE_MS=10000
# Только тесты/стенд: доп. CA (PEM) для HTTPS-источников входов.
# FFMPEG_SERVER_DOWNLOAD_CA_FILE=
# Только локальный стенд: разрешить http:// в PUBLIC_BASE_URL (в проде — нет).
# FFMPEG_SERVER_ALLOW_HTTP_PUBLIC_URL=1

# ── служебное ──────────────────────────────────────────────────────────
FFMPEG_SERVER_MAX_BODY_BYTES=524288
FFMPEG_SERVER_EXECUTOR_HEARTBEAT_STALE_SEC=30
FFMPEG_SERVER_EXECUTOR_POLL_MS=1000
FFMPEG_SERVER_DISPATCHER_TICK_MS=1000
FFMPEG_SERVER_CLEANUP_INTERVAL_SEC=300
# Доп. фильтры/энкодеры для /api/ready сверх self-test executor (через запятую).
FFMPEG_SERVER_REQUIRED_FILTERS=
FFMPEG_SERVER_REQUIRED_ENCODERS=
