[Unit]
Description=Isolated FFmpeg canary (mount required)
Requires=docker.service srv-v4c\x2dffmpeg\x2dcanary.mount
After=docker.service srv-v4c\x2dffmpeg\x2dcanary.mount
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /opt/v4c-ffmpeg-canary/start-canary.sh
ExecStop=/usr/bin/docker stop --time 30 v4c-ffmpeg-canary-api-1 v4c-ffmpeg-canary-executor-1
TimeoutStartSec=120
TimeoutStopSec=60
[Install]
WantedBy=multi-user.target
