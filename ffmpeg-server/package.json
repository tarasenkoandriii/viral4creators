{
  "name": "ffmpeg-server",
  "version": "0.1.0",
  "description": "Собственный FFmpeg API, совместимый с протоколом Very Good FFmpeg (docs-tz/FFmpeg-server-spec-v1.1-RU.md) — отдельный деплоймый пакет монорепо (Dokploy, не Vercel).",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "start:executor": "node --disable-warning=ExperimentalWarning dist/executor/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc -p tsconfig.eslint.json --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.2",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.5.0"
  }
}
