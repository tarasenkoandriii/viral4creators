# Backend API URL
# On Vercel (see DEPLOYMENT.md for the full two-project setup), the backend
# is one stable production deployment with no per-branch preview builds of
# its own — so BOTH the frontend's Production and Preview environments
# point at the SAME backend production URL, e.g.:
#   VITE_API_BASE_URL=https://viral4creators-backend.vercel.app/api
# Set it once in the frontend Vercel project's env vars for "All
# Environments" rather than splitting Production/Preview values.
VITE_API_BASE_URL=http://localhost:3000/api

# Environment

# Telegram dev-login (Docker local stand only — see doc/TELEGRAM-ADMIN.md).
# This app also works as a Telegram Mini App (see src/lib/telegram.ts):
# inside Telegram it authenticates via the real initData automatically,
# no env var needed. Outside Telegram (this dev server, opened in a
# plain browser) these two let you simulate being logged in as a
# specific Telegram user, mirroring the backend's ALLOW_DEV_AUTH/
# DEV_USER_ID. Leave both unset for the ordinary anonymous flow — that
# stays the default, exactly as before Telegram login existed.
VITE_ALLOW_DEV_AUTH=false
VITE_DEV_USER_ID=123

# "Log in with Telegram" button (Telegram Login Widget) — shown only
# outside Telegram (inside Telegram, identification is already automatic
# via initData, see src/lib/telegram.ts). Logging in is optional and
# purely additive: it links this browser to a Telegram user (httpOnly
# cookie, 30 days) so future sessions aren't anonymous, but nothing stops
# working if you never click it. Bot username without "@"; that bot's
# @BotFather /setdomain must point at this app's domain — see
# doc/TELEGRAM-ADMIN.md.
VITE_TELEGRAM_BOT_USERNAME=

# Публичная страница ролика (ТЗ §40, этап 60) — landing/ отдаёт её на
# /video/:id. ShareVideoPanel строит по нему ссылку для копирования и
# "Поделиться"; сам маршрут ничего в этот адрес не отправляет — форк
# ("Сделать такой же") идёт напрямую в бэкенд (VITE_API_BASE_URL).
VITE_LANDING_URL=http://localhost:3003
