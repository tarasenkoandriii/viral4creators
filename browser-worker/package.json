{
  "name": "browser-worker",
  "version": "1.0.0",
  "description": "Изолированный браузерный воркер (Э-С Ш3): «Снимок», обход «Админки» за логином, сверка дескрипторов, кадры — pull-задания из sites-backend по HMAC, Chromium с песочницей, egress только через фильтрующий прокси.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "healthcheck": "node dist/healthcheck.js",
    "seal-keygen": "node dist/seal-keygen.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings 0",
    "test": "jest -c jest.config.js",
    "test:e2e": "jest -c jest.e2e.config.js --runInBand"
  },
  "dependencies": {
    "playwright-core": "1.56.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.2",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.5.0"
  }
}
