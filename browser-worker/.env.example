# Браузерный воркер Э-С Ш3 — env на VPS (файл .env рядом с docker-compose.yml).
# Пошагово — doc/DEPLOYMENT.md §6.25. Настоящих значений здесь нет.

# Адрес sites-backend (https) и секрет подписи — ТОТ ЖЕ, что
# SITES_WORKER_HMAC_SECRET у sites-backend, свой (не секрет обучалки,
# Flow-QA или админки), ≥ 32 символов: openssl rand -hex 32
SITES_BACKEND_URL=https://<домен sites-backend>
SITES_WORKER_HMAC_SECRET=

# Закрытый ключ конверта учёток (обход «Админки» за логином). Пара —
# `docker compose run --rm browser-worker node dist/seal-keygen.js`;
# открытый — в SITES_WORKER_SEAL_PUBLIC_KEY у sites-backend. Пусто —
# обход за логином воркер не берёт (остальные задания работают).
BROWSER_WORKER_SEAL_PRIVATE_KEY=

# Публичные IPv4/IPv6 САМОГО сервера через запятую (IPv6 — подсеть /64).
# Обязательно в production: общий список служебных адресов их не ловит.
BROWSER_WORKER_EGRESS_DENY=
# Порты назначения браузера (QA-ТЗ §4.2: наружу только 80/443).
BROWSER_WORKER_EGRESS_ALLOWED_PORTS=80,443

# Имя воркера в аренде заданий (a-z0-9-), по умолчанию — от имени хоста.
# BROWSER_WORKER_ID=bw-vps-1
# Заданий одновременно (1…4); поднимать вместе с mem_limit.
BROWSER_WORKER_CONCURRENCY=2
# Какие виды брать (по умолчанию все): ui-snapshot,admin-crawl,descriptor-resolve,frames-capture
# BROWSER_WORKER_KINDS=
# Опрос очереди: обычный и максимальный при пустой очереди (мс).
# BROWSER_WORKER_POLL_MS=3000
# BROWSER_WORKER_IDLE_POLL_MAX_MS=30000
# Ротация Chromium: после N заданий или M минут.
# BROWSER_WORKER_ROTATE_JOBS=50
# BROWSER_WORKER_ROTATE_MINUTES=30
# Пора ротировать — новые задания не берутся, пока идущие не кончатся
# («дренаж»); не опустел за этот срок (мс) — старый браузер уходит в
# отставку и закрывается после своего последнего задания.
# BROWSER_WORKER_DRAIN_MAX_MS=360000
# Потолки байтов: тело одного ответа сайта (МБ; больше — ответ обрывается)
# и весь входящий трафик задания (МБ; больше — задание `traffic_limit`).
# BROWSER_WORKER_MAX_RESPONSE_MB=20
# BROWSER_WORKER_MAX_JOB_TRAFFIC_MB=150
# Срок на завершение идущих заданий при остановке (мс).
# BROWSER_WORKER_SHUTDOWN_GRACE_MS=25000
# Вышестоящий прокси для браузера (резидентный выход) — обычно не нужен.
# BROWSER_WORKER_UPSTREAM_PROXY_URL=
# Песочница Chromium: off в production запрещён (воркер не стартует).
# BROWSER_WORKER_SANDBOX=on
# LOG_LEVEL=info
